@page "/voice"
@using TrBlazeUI.Components.FileUpload
@using TrBlazeUI.Components.NativeSelect
@using System.Text.Json
@implements IDisposable
@inject IHttpClientFactory HttpClientFactory
@inject ToastService ToastService
@inject IAuthSession AuthSession

@*
    Voice Studio (REQ-UI-030). Narration composer over the voice endpoints (synthesize / preset-voice
    list / clone list / consent-gated clone). Language (EN/HI/Hinglish) + one voice picker hide provider
    routing behind a single control; the picker lists every preset voice (play a short sample of any
    voice) and the creator's own clones, which stay gated until their model is ready. The emotion select
    and speed slider disable themselves when the selected voice doesn't support them. The player reopens
    the creator's newest narration (its voice, language, emotion, speed and text go back on the
    controls) and plays it over the clip's real length; Export WAV hands over the clip's own bytes.
    Cloning is inline: a real-person clone stays blocked until the creator confirms recorded consent
    from the voice owner (SAFE-02/03), while a synthetic/character voice skips the gate. Everything is
    live from the API — no representative seed; an empty catalog renders the honest "no voices
    installed" state and an unreachable API raises a warning Alert.
*@

<PageTitle>TrStudio — Voice Studio</PageTitle>

<h1 class="page-title">Voice Studio</h1>
<p class="page-sub">Generate narration with preset or cloned voices — EN / HI / Hinglish.</p>

@if (objApiDown)
{
    <div data-testid="api-down-alert" style="margin-bottom:14px">
        <Alert Variant="AlertVariant.Warning" AccentBorder="true">
            <LucideIcon Name="circle-alert" Size="16" />
            <AlertTitle>Couldn't reach the API — data unavailable</AlertTitle>
            <AlertDescription>The preset-voice catalog couldn't be loaded. Check that TrStudioApi is running and reload.</AlertDescription>
        </Alert>
    </div>
}

<div class="voice-studio" data-testid="voice-studio">

    @* ---- LEFT: script + voice picker + controls ---- *@
    <div class="studio-col">
        <Card Class="voice-card" data-testid="card-script-text">
            <h3 class="card-h3">Script text</h3>
            <div class="voice-row" style="margin-bottom:10px">
                <div>
                    <label class="param-label">Language</label>
                    <NativeSelect TValue="string" @bind-Value="objLanguage" Class="w-full" aria-label="Language" data-testid="field-1">
                        @foreach (var vLang in objLanguages)
                        {
                            <option value="@vLang.Key">@vLang.Value</option>
                        }
                    </NativeSelect>
                </div>
                <div>
                    <label class="param-label">
                        Emotion / style
                        @if (!EmotionSupported)
                        {
                            <span class="muted-sm" style="font-weight:400"> (unsupported)</span>
                        }
                    </label>
                    <NativeSelect TValue="string" @bind-Value="objEmotion" Disabled="@(!EmotionSupported)" Class="w-full" aria-label="Emotion / style" data-testid="field-2">
                        @foreach (var vEmotion in EmotionOptions)
                        {
                            <option value="@vEmotion">@vEmotion</option>
                        }
                    </NativeSelect>
                </div>
            </div>

            <label class="param-label">Text to speak</label>
            <Textarea @bind-Value="objScript" Placeholder="Type the narration to synthesize…" MaxLength="5000" Rows="5" data-testid="field-3" />

            <div class="flex-between" style="margin-top:8px">
                <span class="muted-sm">@objScript.Length / 5000 characters</span>
                <Button OnClick="GenerateAsync" Disabled="@(objGenerating || objPreviewing)" data-testid="btn-generate-voice">
                    @if (objGenerating)
                    {
                        <Spinner Size="SpinnerSize.Small" Class="mr-2" />
                        <span>Synthesizing…</span>
                    }
                    else
                    {
                        <LucideIcon Name="mic" Size="14" />
                        <span>Generate voice</span>
                    }
                </Button>
            </div>
            @if (objGenerating)
            {
                <Progress Value="@objProgress" Class="mt-2" data-testid="voice-progress" />
            }
        </Card>

        <Card Class="voice-card" data-testid="card-voice-picker">
            <h3 class="card-h3">Voice picker</h3>
            @if (objVoicesLoaded && objVoices.Count == 0)
            {
                <div class="emptystate" style="text-align:center;padding:18px 8px" data-testid="voice-catalog-empty">
                    <LucideIcon Name="mic-off" Size="22" />
                    <div style="font-weight:600;margin-top:8px">No voices installed</div>
                    <div class="muted-sm" style="margin-top:4px">Ask your admin to install a voice model from the Model Library.</div>
                </div>
            }
            else
            {
                <label class="param-label">Selected voice</label>
                <div class="voice-combo" data-testid="voice-combobox">
                    <Combobox TItem="VoiceRow"
                              Items="objVoices"
                              Value="@objSelectedVoiceId"
                              ValueChanged="OnVoiceChangedAsync"
                              ValueSelector="@(aVoice => aVoice.Id)"
                              DisplaySelector="@(aVoice => $"{aVoice.Name} · {aVoice.Engine} · {aVoice.Tone}")"
                              Placeholder="Select a voice…"
                              SearchPlaceholder="Search voices…"
                              EmptyMessage="No voices found."
                              MatchTriggerWidth="true" />
                </div>
                <div class="voicelist" data-testid="voice-list">
                    @{ var vSampleNo = 0; }
                    @for (var vIndex = 0; vIndex < objVoices.Count; vIndex++)
                    {
                        var vVoice = objVoices[vIndex];
                        var vSelected = vVoice.Id == objSelectedVoiceId;
                        <div class="voiceitem @(vSelected ? "sel" : "")" @key="vVoice.Id" role="button" tabindex="0"
                             aria-pressed="@(vSelected ? "true" : "false")" @onclick="() => OnVoiceChangedAsync(vVoice.Id)">
                            <span class="voice-av @AvatarClassAt(vIndex)">@vVoice.Initial</span>
                            <div style="flex:1;min-width:0">
                                <strong>@vVoice.Name</strong>
                                <div class="muted-sm">@vVoice.Engine · @vVoice.Gender@(string.IsNullOrWhiteSpace(vVoice.Tone) ? "" : $" · {vVoice.Tone}")</div>
                            </div>
                            @if (vSelected)
                            {
                                <Badge Class="badge-brand" data-testid="badge-selected">selected</Badge>
                            }
                            else
                            {
                                vSampleNo++;
                                <span @onclick:stopPropagation="true">
                                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall" AriaLabel="Play sample"
                                            Disabled="@(objPreviewing || objGenerating)" OnClick="() => PreviewAsync(vVoice)"
                                            data-testid="@(vSampleNo == 1 ? "icon-btn-play-sample" : $"icon-btn-play-sample-{vSampleNo}")">
                                        <LucideIcon Name="play" Size="13" />
                                    </Button>
                                </span>
                            }
                        </div>
                    }
                    @for (var vIndex = 0; vIndex < objClones.Count; vIndex++)
                    {
                        var vClone = objClones[vIndex];
                        <div class="voiceitem is-gated" @key="vClone.CloneId">
                            <span class="voice-av voice-av-x">+</span>
                            <div style="flex:1;min-width:0">
                                <strong>@vClone.VoiceName</strong>
                                <div class="muted-sm">Custom (@EngineName(vClone.RoutedModel)) · @CloneStatusText(vClone.Status)</div>
                            </div>
                            <Badge Class="badge-warn" title="This clone can't be used until its voice model is ready."
                                   data-testid="@(vIndex == 0 ? "badge-gated" : $"badge-gated-{vIndex + 1}")">gated</Badge>
                        </div>
                    }
                </div>
            }
        </Card>

        <Card Class="voice-card" data-testid="card-controls">
            <h3 class="card-h3">Controls</h3>
            <div class="param-field">
                <div class="param-head">
                    <label class="param-label">
                        Speed
                        @if (!SpeedSupported)
                        {
                            <span class="muted-sm" style="font-weight:400"> (unsupported for this voice)</span>
                        }
                    </label>
                    <span class="param-val">@(SpeedSupported ? $"{objSpeed:0.0}×" : "—")</span>
                </div>
                <Slider @bind-Value="objSpeed" Min="0.5" Max="2.0" Step="0.1" Disabled="@(!SpeedSupported)" />
            </div>
            <div class="param-field">
                <div class="param-head">
                    <label class="param-label">Pitch</label>
                    <span class="param-val">@objPitch.ToString("0")</span>
                </div>
                <Slider @bind-Value="objPitch" Min="-12" Max="12" Step="1" />
            </div>
        </Card>
    </div>

    @* ---- RIGHT: player + preview + clone ---- *@
    <div class="studio-col">
        <Card Class="voice-card" data-testid="card-player-aanya-hindi">
            <h3 class="card-h3">Player@(objClip is null ? "" : $" · {objClip.VoiceName}")</h3>
            <div class="voice-wave @(objClip is null ? "is-idle" : "")" data-testid="voice-waveform">
                @for (var vBar = 0; vBar < objWaveHeights.Length; vBar++)
                {
                    var vPlayed = objClip is not null && vBar < PlayedBars;
                    <span class="@(vPlayed ? "is-played" : "")" style="height:@(objWaveHeights[vBar])%"></span>
                }
            </div>
            <Progress Value="@PlayPercent" Class="voice-prog mb-3" data-testid="progress" />
            <div class="flex-between" style="gap:10px;flex-wrap:wrap">
                <div class="flex-row" style="gap:10px;align-items:center">
                    <Button OnClick="TogglePlay" Disabled="@(objClip is null)" data-testid="btn-pause">
                        <LucideIcon Name="@(objPlaying ? "pause" : "play")" Size="13" />
                        <span>@(objPlaying ? "Pause" : "Play")</span>
                    </Button>
                    <span class="muted-sm">@(objClip is null ? "No clip yet" : $"{Clock(objPosition)} / {Clock(objClip.DurationSeconds)}")</span>
                </div>
                <Button Variant="ButtonVariant.Outline" Href="@objClip?.DataUrl" Disabled="@(objClip?.DataUrl is null)"
                        download="@(objClip is null ? null : $"narration-{objClip.AssetId:N}.wav")" data-testid="btn-export-wav">
                    <LucideIcon Name="download" Size="14" />
                    <span>Export WAV</span>
                </Button>
            </div>
        </Card>

        @if (objPreviewing && objPreviewVoice is not null)
        {
            <Card Class="voice-card" data-testid="card-generating-preview">
                <h3 class="card-h3">Generating preview</h3>
                <div class="muted-sm" style="margin-bottom:6px">Synthesizing “@objPreviewVoice.Name” sample…</div>
                <Progress Value="@objPreviewProgress" Class="voice-prog" data-testid="progress-2" />
            </Card>
        }

        <Card Class="voice-card" data-testid="card-clone-a-voice">
            <h3 class="card-h3">Clone a voice</h3>
            <Alert Variant="AlertVariant.Warning" AccentBorder="true" Class="mb-3" data-testid="alert-warn">
                <AlertDescription>
                    <strong>Consent required.</strong> A real person's voice can be cloned only with recorded consent
                    from the voice owner (SAFE-02 / SAFE-03). Upload a voice sample, then confirm the consent below.
                </AlertDescription>
            </Alert>

            <label class="param-label">Voice sample (30s+)</label>
            <div data-testid="voice-clone-upload">
                <FileUpload Accept="audio/*" FilesChanged="OnSampleSelected" />
            </div>
            @if (!string.IsNullOrEmpty(objSampleName))
            {
                <p class="muted-sm" style="margin-top:6px">Attached: @objSampleName</p>
            }

            <label class="voice-consent-check">
                <Checkbox Checked="objCloneSynthetic" CheckedChanged="OnSyntheticChanged" Id="clone-synthetic" data-testid="field-4" />
                <span>This is a synthetic / character voice (no real person)</span>
            </label>
            <label class="voice-consent-check @(CanConfirmConsent ? "" : "is-disabled")" style="margin-bottom:12px">
                <Checkbox @bind-Checked="objConsentConfirmed" Disabled="@(!CanConfirmConsent)" Id="clone-consent" data-testid="field-this-is-a-synthetic-char" />
                <span>I have attached recorded consent from the voice owner</span>
            </label>

            <Button Class="w-full" OnClick="CreateCloneAsync" Disabled="@(!CanCreateClone || objCloning)" data-testid="btn-create-clone-blocked-until-c">
                @CreateCloneLabel
            </Button>
        </Card>
    </div>
</div>

@code {
    /// <summary>The voice-vertical route prefix (synthesize / presets / clones / consent).</summary>
    private const string VoiceApiRoute = "/api/v1/voice";

    private readonly Dictionary<string, string> objLanguages = new()
    {
        ["en"] = "English (EN)",
        ["hi"] = "Hindi (HI)",
        ["hinglish"] = "Hinglish",
    };

    /// <summary>The emotion choices offered when the selected voice names none of its own.</summary>
    private static readonly string[] DefaultEmotions = { "Neutral", "Warm narration", "Excited", "Calm" };

    /// <summary>Deterministic bar heights (percent) for the waveform strip.</summary>
    private readonly int[] objWaveHeights =
    {
        30, 60, 90, 45, 75, 100, 55, 35, 80, 50, 65, 95, 40, 70, 30, 85, 50, 60, 42, 78,
    };

    /// <summary>The lines a voice sample speaks (Hindi/Hinglish voices, then English ones).</summary>
    private static readonly string[] SampleLines =
    {
        "नमस्ते! यह मेरी आवाज़ का एक छोटा सा नमूना है।",
        "Hello! This is a short sample of my voice.",
    };

    private static readonly string[] AvatarClasses = { "voice-av-a", "voice-av-b", "voice-av-c" };

    private List<VoiceRow> objVoices = new();
    private List<VoiceCloneListItemResponse> objClones = new();
    private bool objVoicesLoaded;
    private bool objApiDown;
    private string? objSelectedVoiceId;

    private string objLanguage = "hi";
    private string objEmotion = "Warm narration";
    private string objScript = string.Empty;
    private double objSpeed = 1.0;
    private double objPitch;

    private bool objGenerating;
    private int objProgress;

    private bool objPreviewing;
    private VoiceRow? objPreviewVoice;
    private int objPreviewProgress;

    private Clip? objClip;
    private bool objPlaying;
    private double objPosition;
    private CancellationTokenSource? objPlayback;

    private bool objCloneSynthetic;
    private bool objConsentConfirmed;
    private bool objCloning;
    private string? objSampleName;

    /// <summary>The currently selected voice, or null before selection.</summary>
    private VoiceRow? SelectedVoice =>
        objVoices.FirstOrDefault(aVoice => aVoice.Id == objSelectedVoiceId);

    /// <summary>Whether the emotion select is enabled for the selected voice.</summary>
    private bool EmotionSupported => SelectedVoice?.SupportsEmotion ?? true;

    /// <summary>Whether the speed slider is enabled for the selected voice.</summary>
    private bool SpeedSupported => SelectedVoice?.SupportsSpeed ?? true;

    /// <summary>The emotions the selected voice offers, or the default set when it names none.</summary>
    private IReadOnlyList<string> EmotionOptions =>
        SelectedVoice is { Emotions.Length: > 0 } vVoice ? vVoice.Emotions : DefaultEmotions;

    /// <summary>How far through the clip the player is, in percent.</summary>
    private double PlayPercent =>
        objClip is null || objClip.DurationSeconds <= 0 ? 0 : Math.Clamp(objPosition / objClip.DurationSeconds * 100d, 0d, 100d);

    /// <summary>How many waveform bars are already played.</summary>
    private int PlayedBars => (int)Math.Round(PlayPercent / 100d * objWaveHeights.Length);

    /// <summary>The consent box can be ticked once a sample is attached for a real person's voice.</summary>
    private bool CanConfirmConsent => !string.IsNullOrEmpty(objSampleName) && !objCloneSynthetic;

    /// <summary>A clone can be created with a sample and either a synthetic voice or confirmed consent.</summary>
    private bool CanCreateClone => !string.IsNullOrEmpty(objSampleName) && (objCloneSynthetic || objConsentConfirmed);

    /// <summary>The create button says what still blocks the clone.</summary>
    private string CreateCloneLabel =>
        !objCloneSynthetic && !objConsentConfirmed ? "Create clone (blocked until consent)"
        : string.IsNullOrEmpty(objSampleName) ? "Create clone (add a sample first)"
        : objCloning ? "Creating clone…"
        : "Create clone";

    /// <summary>
    /// Loads the voices, the creator's clones and their newest narration AFTER the first interactive
    /// render — once <see cref="IAuthSession"/> can hydrate the bearer token. Nothing is seeded: an
    /// empty catalog renders the honest "no voices installed" state, and a failed fetch raises the Alert.
    /// </summary>
    /// <param name="aFirstRender">Whether this is the component's first render.</param>
    protected override async Task OnAfterRenderAsync(bool aFirstRender)
    {
        if (!aFirstRender)
        {
            return;
        }

        var vHasSession = await AuthSession.EnsureLoadedAsync();
        if (vHasSession)
        {
            await TryLoadVoicesAsync();
            await TryLoadClonesAsync();
            if (!objApiDown)
            {
                await TryReopenLastClipAsync();
            }
        }

        objVoicesLoaded = true;
        StateHasChanged();
    }

    /// <summary>Loads the live preset-voice catalog; failures raise the Alert, never a seed list.</summary>
    private async Task TryLoadVoicesAsync()
    {
        try
        {
            var vClient = HttpClientFactory.CreateClient("TrStudioApi");
            var vVoices = await vClient.GetFromJsonAsync<List<PresetVoiceResponse>>($"{VoiceApiRoute}/preset-voices");
            objVoices = (vVoices ?? new List<PresetVoiceResponse>()).Select(MapPresetVoice).ToList();
            objSelectedVoiceId = objVoices.FirstOrDefault()?.Id;
            AlignEmotion();
        }
        catch
        {
            // API unreachable — never fake data; the warning Alert renders instead.
            objApiDown = true;
        }
    }

    /// <summary>Loads the creator's registered voice clones; an unreadable list simply shows none.</summary>
    private async Task TryLoadClonesAsync()
    {
        try
        {
            var vClient = HttpClientFactory.CreateClient("TrStudioApi");
            objClones = await vClient.GetFromJsonAsync<List<VoiceCloneListItemResponse>>($"{VoiceApiRoute}/clones")
                        ?? new List<VoiceCloneListItemResponse>();
        }
        catch
        {
            objClones = new List<VoiceCloneListItemResponse>();
        }
    }

    /// <summary>
    /// Reopens the creator's newest narration (voice samples played from the picker are skipped): its voice, language, emotion, speed and text go back on
    /// the controls and the clip loads into the player. Nothing changes when there is none or it can't be read.
    /// </summary>
    private async Task TryReopenLastClipAsync()
    {
        try
        {
            var vClient = HttpClientFactory.CreateClient("TrStudioApi");
            var vPage = await vClient.GetFromJsonAsync<PagedResult<AssetResponse>>($"{ApiRoutes.Assets}?aKind=audio&aPageSize=24");
            JsonDocument? vDocument = null;
            AssetResponse? vNewest = null;
            foreach (var vAsset in vPage?.Items ?? Array.Empty<AssetResponse>())
            {
                var vParsed = JsonDocument.Parse(string.IsNullOrWhiteSpace(vAsset.ParamsJson) ? "{}" : vAsset.ParamsJson);
                var vIsSample = vParsed.RootElement.ValueKind == JsonValueKind.Object
                                && vParsed.RootElement.TryGetProperty("Text", out var vText)
                                && vText.ValueKind == JsonValueKind.String
                                && SampleLines.Contains(vText.GetString());
                if (!vIsSample)
                {
                    vDocument = vParsed;
                    vNewest = vAsset;
                    break;
                }

                vParsed.Dispose();
            }

            if (vNewest is null || vDocument is null)
            {
                return;
            }

            using var vOwned = vDocument;
            var vRoot = vDocument.RootElement;
            string? Text(string aName) =>
                vRoot.ValueKind == JsonValueKind.Object && vRoot.TryGetProperty(aName, out var vValue) && vValue.ValueKind == JsonValueKind.String
                    ? vValue.GetString() : null;
            double? Number(string aName) =>
                vRoot.ValueKind == JsonValueKind.Object && vRoot.TryGetProperty(aName, out var vValue) && vValue.ValueKind == JsonValueKind.Number
                    ? vValue.GetDouble() : null;

            var vVoice = objVoices.FirstOrDefault(aVoice => aVoice.Id == Text("VoiceId"));
            if (vVoice is not null)
            {
                objSelectedVoiceId = vVoice.Id;
            }

            if (Text("Language") is { } vLanguage && objLanguages.ContainsKey(vLanguage))
            {
                objLanguage = vLanguage;
            }

            AlignEmotion();
            if (Text("Emotion") is { } vEmotion && EmotionOptions.Contains(vEmotion))
            {
                objEmotion = vEmotion;
            }

            if (Number("Speed") is { } vSpeed)
            {
                objSpeed = vSpeed;
            }

            objScript = Text("Text") ?? objScript;
            await LoadClipAsync(vClient, vNewest.AssetId, vVoice?.Name ?? Text("VoiceId") ?? "narration", Number("DurationSeconds") ?? 0);
        }
        catch
        {
            // The last narration could not be read — the studio opens fresh.
        }
    }

    /// <summary>
    /// Loads a clip's bytes (<c>GET /api/v1/assets/{id}/content</c>, owner-filtered) into the player as a
    /// data URL, so Export WAV hands over the clip itself. The player starts at the beginning, paused.
    /// </summary>
    private async Task LoadClipAsync(HttpClient aClient, Guid aAssetId, string aVoiceName, double aDurationSeconds)
    {
        StopPlayback();
        string? vDataUrl = null;
        try
        {
            using var vResponse = await aClient.GetAsync($"{ApiRoutes.Assets}/{aAssetId}/content");
            if (vResponse.IsSuccessStatusCode)
            {
                var vType = vResponse.Content.Headers.ContentType?.MediaType ?? "audio/wav";
                var vBytes = await vResponse.Content.ReadAsByteArrayAsync();
                vDataUrl = $"data:{vType};base64,{Convert.ToBase64String(vBytes)}";
            }
        }
        catch (HttpRequestException)
        {
            // The clip's bytes can't be read — the player still shows it, Export stays off.
        }

        objClip = new Clip(aAssetId, aVoiceName, aDurationSeconds, vDataUrl);
        objPosition = 0;
    }

    /// <summary>
    /// Maps an API preset-voice response onto the picker row. The routed model is shown as the engine;
    /// gender and tone become the short descriptor.
    /// </summary>
    /// <param name="aVoice">The API preset-voice response to map.</param>
    private static VoiceRow MapPresetVoice(PresetVoiceResponse aVoice) => new(
        aVoice.VoiceId,
        aVoice.DisplayName,
        EngineName(aVoice.RoutedModel),
        string.IsNullOrWhiteSpace(aVoice.Gender) ? aVoice.Language : aVoice.Gender,
        aVoice.Tone,
        string.IsNullOrWhiteSpace(aVoice.DisplayName) ? "?" : aVoice.DisplayName[..1].ToUpperInvariant(),
        aVoice.SupportsEmotion,
        aVoice.SupportsSpeed,
        aVoice.Emotions ?? Array.Empty<string>(),
        aVoice.Language);

    /// <summary>The display name of a routed voice model id.</summary>
    /// <param name="aModel">The routed model id.</param>
    private static string EngineName(string? aModel) => (aModel ?? string.Empty).ToLowerInvariant() switch
    {
        "indic-f5" => "IndicF5",
        "xtts-v2" => "XTTS v2",
        "xtts-hindi" => "XTTS Hindi",
        "omni-voice" => "OmniVoice",
        "" => "voice model",
        _ => aModel!,
    };

    /// <summary>Plain words for a clone's registration status.</summary>
    /// <param name="aStatus">The status the API reports.</param>
    private static string CloneStatusText(string? aStatus) => aStatus switch
    {
        "ConsentVerifiedModelPending" => "model pending",
        "BlockedNoConsent" => "pending consent",
        null or "" => "pending",
        _ => aStatus,
    };

    /// <summary>The avatar gradient for the picker row at a position.</summary>
    private static string AvatarClassAt(int aIndex) => AvatarClasses[aIndex % AvatarClasses.Length];

    /// <summary>A clip length as m:ss.</summary>
    private static string Clock(double aSeconds)
    {
        var vSeconds = (int)Math.Floor(Math.Max(0, aSeconds));
        return $"{vSeconds / 60}:{vSeconds % 60:00}";
    }

    /// <summary>Keeps the chosen emotion one the selected voice offers.</summary>
    private void AlignEmotion()
    {
        if (!EmotionOptions.Contains(objEmotion))
        {
            objEmotion = EmotionOptions[0];
        }
    }

    /// <summary>Switches the active voice, re-evaluating the emotion/speed capability gates.</summary>
    /// <param name="aVoiceId">The newly selected voice id.</param>
    private Task OnVoiceChangedAsync(string? aVoiceId)
    {
        objSelectedVoiceId = aVoiceId;
        AlignEmotion();
        return Task.CompletedTask;
    }

    /// <summary>
    /// Runs a synthesis pass with the selected voice and the script, then loads the clip into the player.
    /// </summary>
    private async Task GenerateAsync()
    {
        var vVoice = SelectedVoice;
        if (vVoice is null)
        {
            ToastService.Error("Select a voice before generating.", "No voice");
            return;
        }

        if (string.IsNullOrWhiteSpace(objScript))
        {
            ToastService.Error("Enter some text to speak.", "Empty script");
            return;
        }

        objGenerating = true;
        objProgress = 0;
        StateHasChanged();

        var vResult = await SynthesizeWithProgressAsync(vVoice, objScript, aPercent => objProgress = aPercent);
        objGenerating = false;
        await ReportAndLoadAsync(vResult, vVoice, "Narration ready");
    }

    /// <summary>
    /// Plays a short sample of a voice: synthesizes a sample line in the voice's language, showing the
    /// "Generating preview" card while it runs, then loads the sample into the player.
    /// </summary>
    /// <param name="aVoice">The voice to sample.</param>
    private async Task PreviewAsync(VoiceRow aVoice)
    {
        objPreviewing = true;
        objPreviewVoice = aVoice;
        objPreviewProgress = 0;
        StateHasChanged();

        var vLine = aVoice.Language is "hi" or "hinglish" ? SampleLines[0] : SampleLines[1];
        var vResult = await SynthesizeWithProgressAsync(aVoice, vLine, aPercent => objPreviewProgress = aPercent);

        objPreviewing = false;
        objPreviewVoice = null;
        await ReportAndLoadAsync(vResult, aVoice, "Sample ready");
        if (objClip is not null && vResult?.AssetId is not null)
        {
            StartPlayback();
        }
    }

    /// <summary>Shows progress while the synthesize call runs; returns the API result, or null on failure.</summary>
    private async Task<VoiceSynthesizeResponse?> SynthesizeWithProgressAsync(VoiceRow aVoice, string aText, Action<int> aSetProgress)
    {
        var vCall = TrySynthesizeAsync(aVoice, aText);
        for (var vStep = 1; vStep <= 4 && !vCall.IsCompleted; vStep++)
        {
            aSetProgress(vStep * 20);
            StateHasChanged();
            await Task.WhenAny(vCall, Task.Delay(140));
        }

        var vResult = await vCall;
        aSetProgress(100);
        return vResult;
    }

    /// <summary>Reports a synthesis result honestly and, when it produced audio, loads it into the player.</summary>
    private async Task ReportAndLoadAsync(VoiceSynthesizeResponse? aResult, VoiceRow aVoice, string aTitle)
    {
        if (aResult is null)
        {
            ToastService.Error("Couldn't reach the API — nothing was synthesized.", "Voice");
            return;
        }

        if (aResult.AssetId is not { } vAssetId)
        {
            // The API answered but produced no audio (e.g. model-not-installed) — report its reason.
            ToastService.Error(aResult.Message ?? "No voice model produced audio for this request.", "Voice");
            return;
        }

        await LoadClipAsync(HttpClientFactory.CreateClient("TrStudioApi"), vAssetId, aVoice.Name, aResult.DurationSeconds);
        if (aResult.Degraded)
        {
            ToastService.Show(aResult.Message ?? "Synthesis ran in degraded mode.", "Voice");
        }
        else
        {
            ToastService.Success($"{aTitle} — {aVoice.Name}.", "Generated");
        }
    }

    /// <summary>Synthesize round-trip; returns the API result, or null when the call failed.</summary>
    private async Task<VoiceSynthesizeResponse?> TrySynthesizeAsync(VoiceRow aVoice, string aText)
    {
        try
        {
            var vClient = HttpClientFactory.CreateClient("TrStudioApi");
            var vRequest = new VoiceSynthesizeRequest
            {
                Text = aText,
                VoiceId = aVoice.Id,
                Language = objLanguage,
                Emotion = aVoice.SupportsEmotion ? objEmotion : null,
                Speed = aVoice.SupportsSpeed ? objSpeed : 1.0d,
            };

            var vResponse = await vClient.PostAsJsonAsync($"{VoiceApiRoute}/synthesize", vRequest);
            if (!vResponse.IsSuccessStatusCode)
            {
                return null;
            }

            return await vResponse.Content.ReadFromJsonAsync<VoiceSynthesizeResponse>();
        }
        catch
        {
            // API unreachable — the caller reports the failure; nothing is faked.
            return null;
        }
    }

    /// <summary>Plays or pauses the clip; playing from the end starts it over.</summary>
    private void TogglePlay()
    {
        if (objPlaying)
        {
            StopPlayback();
            return;
        }

        StartPlayback();
    }

    /// <summary>Moves the playhead over the clip's real length until it ends or is paused.</summary>
    private void StartPlayback()
    {
        if (objClip is null)
        {
            return;
        }

        StopPlayback();
        if (objPosition >= objClip.DurationSeconds)
        {
            objPosition = 0;
        }

        objPlaying = true;
        objPlayback = new CancellationTokenSource();
        _ = RunPlaybackAsync(objPlayback.Token);
    }

    private async Task RunPlaybackAsync(CancellationToken aToken)
    {
        const double cTick = 0.25d;
        using var vTimer = new PeriodicTimer(TimeSpan.FromSeconds(cTick));
        try
        {
            while (await vTimer.WaitForNextTickAsync(aToken))
            {
                if (objClip is null)
                {
                    break;
                }

                objPosition = Math.Min(objClip.DurationSeconds, objPosition + cTick);
                if (objPosition >= objClip.DurationSeconds)
                {
                    objPlaying = false;
                    await InvokeAsync(StateHasChanged);
                    break;
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Paused or left the page.
        }
    }

    private void StopPlayback()
    {
        objPlaying = false;
        objPlayback?.Cancel();
        objPlayback?.Dispose();
        objPlayback = null;
    }

    /// <summary>Records the chosen clone sample file name.</summary>
    /// <param name="aFiles">The files chosen in the FileUpload control.</param>
    private void OnSampleSelected(IReadOnlyList<FileUploadItem> aFiles)
    {
        objSampleName = aFiles.Count > 0 ? aFiles[0].Name : null;
        if (!CanConfirmConsent)
        {
            objConsentConfirmed = false;
        }
    }

    /// <summary>A synthetic voice needs no consent; un-ticking it asks for consent again.</summary>
    private void OnSyntheticChanged(bool aSynthetic)
    {
        objCloneSynthetic = aSynthetic;
        objConsentConfirmed = false;
    }

    /// <summary>
    /// Creates the clone. A real person's voice first records the owner's consent evidence
    /// (<c>POST /voice/consent</c>), then requests the clone; the API keeps the SAFE-03 gate either way,
    /// and its answer — success or block — is reported as it is.
    /// </summary>
    private async Task CreateCloneAsync()
    {
        if (!CanCreateClone || objSampleName is null)
        {
            return;
        }

        objCloning = true;
        var vName = Path.GetFileNameWithoutExtension(objSampleName);
        var vSubject = System.Text.RegularExpressions.Regex.Replace(vName.ToLowerInvariant(), "[^a-z0-9]+", "-").Trim('-');
        try
        {
            var vClient = HttpClientFactory.CreateClient("TrStudioApi");
            if (!objCloneSynthetic)
            {
                var vConsent = await vClient.PostAsJsonAsync($"{VoiceApiRoute}/consent", new VoiceConsentRequest
                {
                    SubjectReference = vSubject,
                    EvidenceType = "recorded-consent",
                    EvidenceDetail = $"Creator confirmed recorded consent from the voice owner, attached with sample {objSampleName}.",
                    ConsentGranted = true,
                });
                if (!vConsent.IsSuccessStatusCode)
                {
                    ToastService.Error("The consent record wasn't accepted — the clone wasn't queued.", "Clone");
                    return;
                }
            }

            var vResponse = await vClient.PostAsJsonAsync($"{VoiceApiRoute}/clone", new VoiceCloneRequest
            {
                VoiceName = vName,
                Language = objLanguage,
                IsRealPerson = !objCloneSynthetic,
                SubjectReference = objCloneSynthetic ? null : vSubject,
                SampleReference = objSampleName,
            });
            var vBody = await vResponse.Content.ReadFromJsonAsync<VoiceCloneResponse>();
            if (vResponse.IsSuccessStatusCode && vBody is { Blocked: false })
            {
                ToastService.Success(vBody.Message, "Clone");
                objSampleName = null;
                objConsentConfirmed = false;
                await TryLoadClonesAsync();
                return;
            }

            ToastService.Error(vBody?.Message ?? "The clone wasn't queued.", "Clone");
        }
        catch
        {
            ToastService.Error("Couldn't reach the API — the clone wasn't queued.", "Clone");
        }
        finally
        {
            objCloning = false;
        }
    }

    /// <summary>Stops the playhead when the page goes away.</summary>
    public void Dispose() => StopPlayback();

    /// <summary>A selectable voice in the picker; routing (engine) is shown, not chosen.</summary>
    /// <param name="Id">Stable voice id.</param>
    /// <param name="Name">Display name.</param>
    /// <param name="Engine">Display name of the model the voice routes to.</param>
    /// <param name="Gender">Gender label (or language when none).</param>
    /// <param name="Tone">Short delivery descriptor; may be empty.</param>
    /// <param name="Initial">Avatar initial.</param>
    /// <param name="SupportsEmotion">Whether the voice supports emotion/style control.</param>
    /// <param name="SupportsSpeed">Whether the voice supports speed control.</param>
    /// <param name="Emotions">The emotions the voice offers.</param>
    /// <param name="Language">The voice's language: en, hi or hinglish.</param>
    private sealed record VoiceRow(
        string Id,
        string Name,
        string Engine,
        string Gender,
        string Tone,
        string Initial,
        bool SupportsEmotion,
        bool SupportsSpeed,
        string[] Emotions,
        string Language);

    /// <summary>The clip in the player.</summary>
    /// <param name="AssetId">The audio asset id.</param>
    /// <param name="VoiceName">The voice it was made with.</param>
    /// <param name="DurationSeconds">The clip's length.</param>
    /// <param name="DataUrl">The clip's bytes as a data URL, or null when they couldn't be read.</param>
    private sealed record Clip(Guid AssetId, string VoiceName, double DurationSeconds, string? DataUrl);
}
