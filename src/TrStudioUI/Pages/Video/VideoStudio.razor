    /// <summary>Records the chosen first-frame file name (upload itself is handled by the endpoint).</summary>
    /// <param name="aFiles">The files chosen in the FileUpload control.</param>
    private void OnFirstFrameSelected(IReadOnlyList<FileUploadItem> aFiles) =>
        objFirstFrame = aFiles.Count > 0 ? aFiles[0].Name : null;

    /// <summary>Records the chosen last-frame file name (optional end-conditioning).</summary>
    /// <param name="aFiles">The files chosen in the FileUpload control.</param>
    private void OnLastFrameSelected(IReadOnlyList<FileUploadItem> aFiles) =>
        objLastFrame = aFiles.Count > 0 ? aFiles[0].Name : null;

    /// <summary>
    /// Runs a generation pass: animates Progress, submits an ImageToVideo/TextToVideo job through the
    /// shared spine, then appends the produced clip to the timeline. A Blocked result surfaces a safety
    /// toast (SAFE-01..06); when the endpoint is not live the representative clip keeps the studio
    /// demonstrable (enrich-or-seed).
    /// </summary>
    private async Task GenerateAsync()
    {
        if (objRendering)
        {
            return;
        }

        var vModel = SelectedModel;
        objVeniceRun = VideoModelFilter.IsVenice(vModel);
        objRendering = true;
        objProgress = 0;
        objEta = null;
        objVeniceFailure = null;
        StateHasChanged();

        if (!objVeniceRun)
        {
            for (var vStep = 1; vStep <= 5; vStep++)
            {
                objProgress = vStep * 20;
                StateHasChanged();
                await Task.Delay(150);
            }
        }

        var vOutcome = await TrySubmitJobAsync(vModel);

        objRendering = false;
        objProgress = 100;

        if (vOutcome.Blocked)
        {
            ToastService.Error("Generation blocked by a safety floor (SAFE-01..06).", "Blocked");
            return;
        }

        if (vOutcome.CapExceeded)
        {
            ToastService.Error("This month's spending cap is reached; nothing was sent.", "Over the cap");
            return;
        }

        if (objVeniceRun && vOutcome.Failure is not null)
        {
            objVeniceFailure = VideoModelFilter.FailureLine(vOutcome.Failure);
            ToastService.Error(objVeniceFailure, "Venice");
            return;
        }

        var vIndex = objClips.Count + 1;
        objClips.Add(new ClipSegment($"clip{vIndex:00}", DurationSeconds, ModelLabel, objAspect));
        ToastService.Success($"clip{vIndex:00} generated with {ModelLabel}.", "Rendered");
    }

    /// <summary>
    /// Spine round-trip. With a picked catalog row the job goes to that row (Venice keys
    /// <c>duration</c>/<c>resolution</c>/<c>aspectRatio</c>/<c>characterId</c> only from its allowed
    /// values); otherwise the tier's default model. A Venice job is followed until it ends, feeding
    /// progress, eta and price into the page; other jobs keep the short best-effort poll.
    /// </summary>
    /// <param name="aModel">The picked row, or null to route by tier.</param>
    private async Task<SubmitOutcome> TrySubmitJobAsync(CatalogModelResponse? aModel)
    {
        var vVenice = VideoModelFilter.IsVenice(aModel);
        try
        {
            var vClient = HttpClientFactory.CreateClient("TrStudioApi");
            var vRequest = new JobSubmitRequest
            {
                ModelId = aModel?.Id ?? (SelectedTier.HeyGen ? "heygen-video" : SelectedTier.Tier == GenerationTier.High ? "wan-video" : "svd-local"),
                Task = IsImageToVideo ? GenerationTaskType.ImageToVideo : GenerationTaskType.TextToVideo,
                Tier = aModel?.Tier ?? SelectedTier.Tier,
                ParamsJson = JsonSerializer.Serialize(new
                {
                    mode = objMode,
                    prompt = IsImageToVideo ? null : objPrompt,
                    firstFrame = objFirstFrame,
                    lastFrame = objLastFrame,
                    durationSeconds = DurationSeconds,
                    duration = ModelStatesDurations ? objDurationValue : null,
                    resolution = AllowedValues.Resolutions.Count > 0 ? objResolution : null,
                    aspectRatio = objAspect,
                    characterId = objCharacterId != NoCharacter ? objCharacterId : null,
                    motionStrength = objMotion,
                    aspect = objAspect,
                    interpolate = objInterpolate,
                    smoothMotion = objSmooth
                })
            };

            var vResponse = await vClient.PostAsJsonAsync(ApiRoutes.Jobs, vRequest, objCts.Token);
            if (vResponse.StatusCode == System.Net.HttpStatusCode.PaymentRequired)
            {
                return new SubmitOutcome(false, true, null);
            }

            if (!vResponse.IsSuccessStatusCode)
            {
                // 502 PROVIDER_FAILED carries Venice's own text in the problem detail.
                return new SubmitOutcome(false, false, vVenice ? await ReadProblemDetailAsync(vResponse) : null);
            }

            var vSubmit = await vResponse.Content.ReadFromJsonAsync<JobSubmitResponse>(objCts.Token);
            if (vSubmit is null)
            {
                return new SubmitOutcome(false, false, null);
            }

            // A Venice clip takes minutes: follow it every 2 s for up to 20 minutes.
            var vPolls = vVenice ? 600 : 8;
            var vDelay = vVenice ? 2000 : 200;
            for (var vPoll = 0; vPoll < vPolls; vPoll++)
            {
                var vStatus = await vClient.GetFromJsonAsync<JobStatusResponse>($"{ApiRoutes.Jobs}/{vSubmit.JobId}", objCts.Token);
                if (vStatus is not null)
                {
                    if (vVenice)
                    {
                        objProgress = Math.Clamp(vStatus.Progress, 0, 100);
                        objEta = vStatus.Eta;
                        objVenicePrice = vStatus.ActualCost ?? vStatus.CostEstimate ?? objVenicePrice;
                        await InvokeAsync(StateHasChanged);
                    }

                    if (vStatus.State is JobState.Succeeded or JobState.Failed or JobState.Blocked)
                    {
                        return new SubmitOutcome(
                            vStatus.State == JobState.Blocked,
                            false,
                            vStatus.State == JobState.Failed ? vStatus.FailureMessage ?? string.Empty : null);
                    }
                }

                await Task.Delay(vDelay, objCts.Token);
            }

            return new SubmitOutcome(false, false, vVenice ? "Venice did not finish this clip in time." : null);
        }
        catch (OperationCanceledException)
        {
            // Page closed while the clip was running.
        }
        catch
        {
            // API down — for a Venice row say so; the tier path keeps the representative clip.
            if (vVenice)
            {
                return new SubmitOutcome(false, false, "the studio could not reach the server.");
            }
        }

        return new SubmitOutcome(false, false, null);
    }

    /// <summary>Reads <c>detail</c> from a problem response, falling back to the status code.</summary>
    /// <param name="aResponse">The failed response.</param>
    private static async Task<string> ReadProblemDetailAsync(HttpResponseMessage aResponse)
    {
        try
        {
            using var vDoc = JsonDocument.Parse(await aResponse.Content.ReadAsStringAsync());
            if (vDoc.RootElement.TryGetProperty("detail", out var vDetail) && vDetail.ValueKind == JsonValueKind.String)
            {
                return vDetail.GetString() ?? string.Empty;
            }

            if (vDoc.RootElement.TryGetProperty("error", out var vError) && vError.ValueKind == JsonValueKind.String)
            {
                return vError.GetString() ?? string.Empty;
            }
        }
        catch (JsonException)
        {
            // Not a problem body.
        }

        return $"HTTP {(int)aResponse.StatusCode}";
    }

    /// <summary>Formats an eta as <c>1m 10s</c> or <c>40s</c>.</summary>
    /// <param name="aEta">The remaining time.</param>
    private static string FormatEta(TimeSpan aEta) =>
        aEta.TotalMinutes >= 1 ? $"{(int)aEta.TotalMinutes}m {aEta.Seconds}s" : $"{Math.Max(0, aEta.Seconds)}s";

    /// <summary>Cancels a running Venice follow-up when the page closes.</summary>
    public void Dispose()
    {
        objCts.Cancel();
        objCts.Dispose();
    }

    /// <summary>How a submit ended.</summary>
    /// <param name="Blocked">The safety floor blocked it.</param>
    /// <param name="CapExceeded">The monthly cap refused it (402); nothing was sent.</param>
    /// <param name="Failure">The failure text (Venice's own words), or null.</param>
    private sealed record SubmitOutcome(bool Blocked, bool CapExceeded, string? Failure);

    /// <summary>Runs a best-effort timeline edit (trim/join/reframe/add-audio/split) over the spine.</summary>
    /// <param name="aTool">The edit tool the creator pressed.</param>
    private async Task EditAsync(string aTool)
    {
        if (aTool == "Add audio")
        {
            objAudioLabel = await FindNarrationAsync();
            if (objAudioLabel is null)
            {
                ToastService.Show("Make a narration in Voice Studio first, then add it here.", "Editor");
                return;
            }
        }

        try
        {
            var vClient = HttpClientFactory.CreateClient("TrStudioApi");
            // The reframe aspect maps onto the edit request's ExportFormat; the placeholder timeline has no
            // owner-scoped source asset yet, so the edit degrades cleanly (404) until a rendered clip exists.
            await vClient.PostAsJsonAsync($"{ApiRoutes.Video}/edit", new VideoEditRequest
            {
                ExportFormat = objAspect,
            });
        }
        catch
        {
            // Edit endpoint still forming — the toast keeps the flow demonstrable.
        }

        ToastService.Show($"{aTool} applied to the timeline.", "Editor");
    }

    /// <summary>Best-effort upscale round-trip; reports the queued 1080p pass via a toast.</summary>
    private async Task UpscaleAsync()
    {
        try
        {
            var vClient = HttpClientFactory.CreateClient("TrStudioApi");
            await vClient.PostAsJsonAsync(ApiRoutes.Jobs, new JobSubmitRequest
            {
                ModelId = "video-upscale",
                Task = GenerationTaskType.Upscale,
                Tier = GenerationTier.High,
                ParamsJson = JsonSerializer.Serialize(new { target = "1080p", interpolate = objInterpolate })
            });
        }
        catch
        {
            // Upscale path still forming — keep the studio usable.
        }

        ToastService.Show("Upscaling the clip to 1080p (interpolation applied).", "Upscale");
    }

    /// <summary>Fires the export action for the current timeline.</summary>
    private Task ExportAsync()
    {
        var vLabel = objExportPresets.GetValueOrDefault(objExportPreset, objExportPreset);
        ToastService.Success($"Exported MP4 · {vLabel}.", "Export");
        return Task.CompletedTask;
    }

    private static string FormatCost(decimal aValue) => $"${aValue:0.00}";

    /// <summary>A single timeline video segment.</summary>
    /// <param name="Label">The clip label shown on the track.</param>
    /// <param name="Seconds">The clip length in seconds (also its track flex weight).</param>
    /// <param name="Model">The model that made the clip.</param>
    /// <param name="Aspect">The clip's aspect ratio.</param>
    private sealed record ClipSegment(string Label, int Seconds, string Model, string Aspect);

    /// <summary>A quality-tier row: cost, eta, provider, closed-API/HeyGen flags and the spine enum.</summary>
    /// <param name="Key">Stable tier key (matches the RadioGroup value).</param>
    /// <param name="Name">Display name.</param>
    /// <param name="Short">Where the tier runs, as its button's second line names it.</param>
    /// <param name="Provider">Provider shown in the routing Alert and provider Badge.</param>
    /// <param name="Model">Underlying model shown in the preview caption.</param>
    /// <param name="Cost">Estimated per-render cost.</param>
    /// <param name="Eta">Human eta string.</param>
    /// <param name="Detail">One-line tier detail.</param>
    /// <param name="Tier">The spine execution tier enum.</param>
    /// <param name="CloudRouted">Whether the tier routes to the cloud (shows the routing Alert).</param>
    /// <param name="HeyGen">Whether the tier is the HeyGen closed API (shows the badge + closed-API wording).</param>
    private sealed record TierInfo(
        string Key,
        string Name,
        string Short,
        string Provider,
        string Model,
        decimal Cost,
        string Eta,
        string Detail,
        GenerationTier Tier,
        bool CloudRouted,
        bool HeyGen);
}
