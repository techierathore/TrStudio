@page "/video"
@using TrBlazeUI.Components.NativeSelect
@using TrBlazeUI.Components.FileUpload
@using System.Text.Json
@inject IHttpClientFactory HttpClientFactory
@inject ToastService ToastService
@inject IAuthSession AuthSession
@inject NavigationManager Navigation
@implements IDisposable

@*
    Video Studio (REQ-UI-040). A three-column studio: (left) an Image→Video / Text→Video mode Tabs
    that swaps the conditioning controls — first/last-frame FileUpload for I2V, a prompt Textarea for
    T2V — over shared duration/motion Sliders + an aspect Select, plus a Fast/High/Premium quality
    tier RadioGroup (cost/eta, HeyGen Badge on Premium) with a closed-API routing Alert whenever a
    cloud tier is picked; (centre) a timeline/editor Card with a 16:9 preview player, a trim/join/
    reframe/add-audio/split Toolbar, video + audio tracks (placeholder when empty), and a render pass
    that animates Progress with an eta; (right) an interpolate/smooth-motion post-processing panel with
    an upscale action, and a platform-preset Export MP4 panel.

    Generation rides the shared job spine (POST /api/v1/jobs, task = ImageToVideo / TextToVideo);
    edit/interpolate/upscale are best-effort spine round-trips. Data follows the enrich-or-seed
    pattern: the studio renders and stays demonstrable whether or not the Phase-7 endpoints are live.
*@

<PageTitle>TrStudio — Video Studio</PageTitle>

<h1 class="page-title">Video Studio</h1>
<p class="page-sub">Image→Video / Text→Video generation, timeline editing and export.</p>

<div class="studio video-studio" data-testid="video-studio">

    @* ---- LEFT: mode + conditioning + controls + tier ---- *@
    <div class="studio-col">
        <Card Class="vid-card" data-testid="card-mode">
            <h3 class="card-h3">Mode</h3>
            <div class="avatar-seg avatar-seg-full" role="radiogroup" aria-label="Mode" data-testid="mode-tabs">
                <button type="button" role="radio" aria-checked="@(IsImageToVideo ? "true" : "false")"
                        class="@(IsImageToVideo ? "is-on" : null)"
                        @onclick="@(() => OnModeChanged("i2v"))" data-testid="btn-image-video">Image → Video</button>
                <button type="button" role="radio" aria-checked="@(IsImageToVideo ? "false" : "true")"
                        class="@(IsImageToVideo ? null : "is-on")"
                        @onclick="@(() => OnModeChanged("t2v"))" data-testid="btn-text-video">Text → Video</button>
            </div>
        </Card>

        @if (IsImageToVideo)
        {
            <Card Class="vid-card" data-testid="card-conditioning-frames">
                <h3 class="card-h3">Conditioning frames</h3>
                <div class="vid-frames">
                    <div>
                        <label class="param-label">First frame</label>
                        <div data-testid="first-frame-upload">
                            <FileUpload Accept="image/*" FilesChanged="OnFirstFrameSelected" />
                        </div>
                        <div class="muted-sm" style="margin-top:4px">@(objFirstFrame ?? "Required for I→V")</div>
                    </div>
                    <div>
                        <label class="param-label">Last frame (optional)</label>
                        <div data-testid="last-frame-upload">
                            <FileUpload Accept="image/*" FilesChanged="OnLastFrameSelected" />
                        </div>
                        <div class="muted-sm" style="margin-top:4px">@(objLastFrame ?? "Interpolate toward end")</div>
                    </div>
                </div>
            </Card>
        }
        else
        {
            <Card Class="vid-card" data-testid="t2v-prompt">
                <h3 class="card-h3">Prompt</h3>
                <Textarea @bind-Value="objPrompt" Placeholder="Describe the motion and scene to generate…" MaxLength="600" />
                <div class="seg-hint">Text→Video needs no source frame.</div>
            </Card>
        }

        <Card Class="vid-card" data-testid="card-controls">
            <h3 class="card-h3">Controls</h3>
            <div class="param-field">
                <div class="param-head">
                    <label class="param-label">Duration</label>
                    <span class="param-val">@(DurationSeconds)s</span>
                </div>
                @if (ModelStatesDurations)
                {
                    @* REQ-FN-081: a row that states its durations offers only those. *@
                    <NativeSelect TValue="string" @bind-Value="objDurationValue" Class="w-full" aria-label="Duration" data-testid="duration-select">
                        @foreach (var vDur in AllowedValues.Durations)
                        {
                            <option value="@vDur">@vDur</option>
                        }
                    </NativeSelect>
                }
                else
                {
                    <div data-testid="duration-slider">
                        <Slider @bind-Value="objDuration" Min="2" Max="10" Step="1" />
                    </div>
                }
            </div>
            @if (AllowedValues.Resolutions.Count > 0)
            {
                <div class="param-field">
                    <label class="param-label">Resolution</label>
                    <NativeSelect TValue="string" @bind-Value="objResolution" Class="w-full" aria-label="Resolution" data-testid="resolution-select">
                        @foreach (var vRes in AllowedValues.Resolutions)
                        {
                            <option value="@vRes">@vRes</option>
                        }
                    </NativeSelect>
                </div>
            }
            <div class="param-field">
                <div class="param-head">
                    <label class="param-label">Motion strength</label>
                    <span class="param-val">@objMotion.ToString("0.0")</span>
                </div>
                <div data-testid="motion-slider">
                    <Slider @bind-Value="objMotion" Min="0" Max="1" Step="0.1" />
                </div>
            </div>
            <label class="param-label">Aspect ratio</label>
            <NativeSelect TValue="string" @bind-Value="objAspect" Class="w-full" aria-label="Aspect ratio" data-testid="field-1">
                @foreach (var vAspect in AllowedValues.AspectRatios)
                {
                    <option value="@vAspect">@objAspects.GetValueOrDefault(vAspect, vAspect)</option>
                }
            </NativeSelect>
        </Card>

        <Card Class="vid-card" data-testid="card-quality-tier">
            <h3 class="card-h3">Quality tier</h3>
            <div class="avatar-seg avatar-seg-full vid-tierseg" role="radiogroup" aria-label="Quality tier" data-testid="tier-group">
                @foreach (var vTier in objTiers)
                {
                    <button type="button" role="radio" aria-checked="@(vTier.Key == objTier ? "true" : "false")"
                            class="@(vTier.Key == objTier ? "is-on" : null)" title="@vTier.Detail"
                            @onclick="@(() => OnTierChanged(vTier.Key))"
                            data-testid="@($"btn-{Slug($"{vTier.Name} {TierLine(vTier)}")}")">
                        <b>@vTier.Name</b><small>@TierLine(vTier)</small>
                    </button>
                }
            </div>
            <div style="margin-top:10px">
                <Badge Class="badge-brand" data-testid="@($"badge-{Slug($"provider {SelectedTier.Provider}")}")">Provider: @SelectedTier.Provider</Badge>
            </div>
            @if (SelectedTier.CloudRouted)
            {
                <Alert Variant="AlertVariant.Info" AccentBorder="true" Class="mt-2" data-testid="alert-info">
                    <AlertDescription>
                        @SelectedTier.Name tier routes to <strong>@SelectedTier.Provider@(SelectedTier.HeyGen ? " (closed API)" : " (serverless GPU)")</strong>.
                        Output is billed against your monthly cap and stamped with provenance.
                    </AlertDescription>
                </Alert>
            }

            @* Phase 2 (decision 3A): registry-driven model picker under the tier buttons (REQ-UI-089..092). *@
            <div data-testid="video-model-picker" style="margin-top:12px">
                <label class="param-label">Model</label>
                <NativeSelect TValue="string" Value="@objModelId" ValueChanged="@((string? aId) => OnModelChanged(aId))" Class="w-full" aria-label="Model"
                              Placeholder="@(ListedModels.Count == 0 ? "No model for this choice" : null)" data-testid="field-video-model">
                    @foreach (var vModel in ListedModels)
                    {
                        <option value="@vModel.Id">@(VideoModelFilter.IsVenice(vModel) ? $"{vModel.DisplayName} — Cloud · Venice" : vModel.DisplayName)</option>
                    }
                </NativeSelect>
                <div class="muted-sm" style="margin-top:6px">
                    @(objCharacterId != NoCharacter
                        ? "Only models that keep a fixed character are listed."
                        : $"Lists only {(IsImageToVideo ? "image to video" : "text to video")} models.")
                </div>

                <label class="param-label" style="margin-top:10px">Character</label>
                <NativeSelect TValue="string" Value="@objCharacterId" ValueChanged="@((string? aId) => OnCharacterChanged(aId))" Class="w-full" aria-label="Character" data-testid="field-character">
                    <option value="@NoCharacter">No character</option>
                    @foreach (var vChar in objCharacters)
                    {
                        <option value="@vChar.CharacterId.ToString()">@($"{vChar.Name} (reference set)")</option>
                    }
                </NativeSelect>

                @if (SelectedModel is not null && VideoModelFilter.IsVenice(SelectedModel))
                {
                    <div class="flex-between" style="margin-top:8px;gap:8px">
                        <Badge Class="badge-brand" data-testid="badge-cloud-venice">Cloud · Venice</Badge>
                        <span class="muted-sm">@AllowedSummary</span>
                    </div>
                    <Alert Variant="AlertVariant.Info" Class="mt-2" data-testid="alert-sent-to-venice">
                        <AlertDescription>
                            Your prompt and pictures are sent to Venice.
                            @(objVenicePrice is decimal vPrice
                                ? $"Venice price for this clip: {FormatCost(vPrice)}."
                                : "Venice prices this clip when you generate.")
                        </AlertDescription>
                    </Alert>
                }
            </div>
        </Card>
    </div>

    @* ---- CENTER: timeline / editor + rendering ---- *@
    <div class="studio-col">
        <Card Class="vid-card" data-testid="card-timeline-editor">
            <div class="flex-between" style="margin-bottom:10px">
                <h3 class="card-h3" style="margin:0">Timeline / editor</h3>
                @if (objClips.Count > 0)
                {
                    <Badge Variant="BadgeVariant.Outline" Class="badge-ok" data-testid="badge-status-2"><span class="dot ok"></span>Rendered</Badge>
                }
                else
                {
                    <Badge Variant="BadgeVariant.Secondary" data-testid="badge-status-2">Empty</Badge>
                }
            </div>

            @if (objClips.Count == 0)
            {
                <div class="vid-empty" data-testid="timeline-empty">
                    <LucideIcon Name="clapperboard" Size="26" />
                    <div>No clips yet — generate a clip to start your timeline.</div>
                </div>
            }
            else
            {
                var vShown = SelectedClip ?? objClips[0];
                <div class="vid-stage" data-testid="timeline-preview">
                    <div class="vid-playbtn">
                        <LucideIcon Name="play" Size="18" />
                    </div>
                    <div>Preview — @vShown.Label (@vShown.Model, @vShown.Aspect)</div>
                </div>
            }

            <div class="vid-edittools" role="toolbar" aria-label="Timeline editing tools" data-testid="timeline-toolbar">
                @foreach (var vTool in objEditTools)
                {
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="@(() => EditAsync(vTool.Name))" data-testid="@($"btn-{Slug(vTool.Name)}")">
                        <LucideIcon Name="@vTool.Icon" Size="13" />
                        @vTool.Name
                    </Button>
                }
                <span style="flex:1"></span>
                <span class="muted-sm">@TimelineDuration</span>
            </div>

            <label class="param-label">Video track</label>
            <div class="vid-track">
                @foreach (var vClip in objClips)
                {
                    <div class="vid-clip @(vClip == SelectedClip ? "is-sel" : null)" style="@($"flex:{vClip.Seconds}")" @key="vClip.Label"
                         @onclick="@(() => objSelectedClip = vClip.Label)">@vClip.Label · @(vClip.Seconds)s</div>
                }
                <div class="vid-clip vid-clip-add" style="flex:1" @onclick="GenerateAsync">@(objClips.Count == 0 ? "+ add clip" : "+ add")</div>
            </div>

            <label class="param-label" style="margin-top:12px">Audio track</label>
            <div class="vid-track">
                @if (objAudioLabel is not null)
                {
                    <div class="vid-clip vid-clip-audio" style="flex:9">@objAudioLabel</div>
                }
                else
                {
                    <div class="vid-clip vid-clip-add" style="flex:9" @onclick="@(() => EditAsync("Add audio"))">+ add audio from Voice Studio</div>
                }
            </div>
        </Card>

        <Card Class="vid-card" data-testid="card-rendering">
            <h3 class="card-h3">Rendering</h3>
            @if (objRendering)
            {
                <div data-testid="render-progress">
                    <div class="flex-between">
                        <span class="muted-sm">Generating clip · @ModelLabel</span>
                        <span class="muted-sm">@objProgress% · eta @RenderEta</span>
                    </div>
                    <Progress Value="@objProgress" Class="mt-2 vid-prog" data-testid="progress" />
                    @if (objVeniceRun)
                    {
                        <div class="muted-sm" style="margin-top:6px" data-testid="venice-progress">
                            Venice: processing · @objProgress%@(objEta is TimeSpan vEta ? $" · about {FormatEta(vEta)} left" : "")
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="muted-sm" style="margin-bottom:8px">
                    @(objClips.Count > 0 ? $"{objClips.Count} clip(s) on the timeline · ready to edit or export." : "Set your controls, then generate the first clip.")
                </div>
            }
            @if (objVeniceFailure is not null)
            {
                <Alert Variant="AlertVariant.Danger" AccentBorder="true" Class="mt-2" data-testid="alert-venice-failed">
                    <LucideIcon Name="circle-alert" Size="16" />
                    <AlertDescription>@objVeniceFailure</AlertDescription>
                </Alert>
            }
            <Button Class="w-full mt-3" OnClick="GenerateAsync" Disabled="@objRendering" data-testid="generate-btn">
                @if (objRendering)
                {
                    <Spinner Size="SpinnerSize.Small" Class="mr-2" />
                    <span>Rendering…</span>
                }
                else
                {
                    <span>@(IsImageToVideo ? "Generate from frame" : "Generate from prompt")</span>
                }
            </Button>
        </Card>
    </div>

    @* ---- RIGHT: post-processing + export ---- *@
    <div class="studio-col">
        <Card Class="vid-card" data-testid="card-post-processing">
            <h3 class="card-h3">Post-processing</h3>
            <div class="flex-between" style="margin-bottom:14px">
                <span style="font-size:13px">Interpolate (RIFE/FILM)</span>
                <Switch @bind-Checked="objInterpolate" AriaLabel="Interpolate (RIFE/FILM)" data-testid="switch" />
            </div>
            <div class="flex-between" style="margin-bottom:14px">
                <span style="font-size:13px">Smooth motion</span>
                <Switch @bind-Checked="objSmooth" AriaLabel="Smooth motion" data-testid="switch-2" />
            </div>
            <Button Variant="ButtonVariant.Outline" Class="w-full" OnClick="UpscaleAsync" data-testid="btn-upscale-to-1080p">
                <LucideIcon Name="upload" Size="14" />
                <span>Upscale to 1080p</span>
            </Button>
            <div class="muted-sm" style="margin-top:8px">Upscaling adds ~40s of RunPod time.</div>
        </Card>

        <Card Class="vid-card" data-testid="card-export">
            <h3 class="card-h3">Export</h3>
            <label class="param-label">Platform preset</label>
            <NativeSelect TValue="string" @bind-Value="objExportPreset" Class="w-full" aria-label="Platform preset" data-testid="field-2">
                @foreach (var vPreset in objExportPresets)
                {
                    <option value="@vPreset.Key">@vPreset.Value</option>
                }
            </NativeSelect>
            <div class="cost-row" style="margin-top:12px">
                <span class="muted-sm">Est. export cost</span>
                <strong>@FormatCost(SelectedTier.Cost)</strong>
            </div>
            <Button Class="w-full mt-3" OnClick="ExportAsync" Disabled="@(objClips.Count == 0)" data-testid="btn-export-mp4">
                <LucideIcon Name="download" Size="14" />
                <span>Export MP4</span>
            </Button>
        </Card>

        <Card Class="vid-card" data-testid="card-empty-segment">
            <h3 class="card-h3">@(SelectedClip is null ? "Empty segment" : "Selected segment")</h3>
            <div class="vid-empty" data-testid="segment-empty">
                @if (SelectedClip is { } vSel)
                {
                    @($"{vSel.Label} · {vSel.Seconds}s · {vSel.Model}")
                }
                else
                {
                    @(objClips.Count == 0 ? "No clip selected — generate a segment to edit" : "No clip selected — pick a segment to edit")
                }
            </div>
        </Card>
    </div>
</div>

@code {
    private string objMode = "i2v";

    private double objDuration = 5;
    private double objMotion = 0.7;

    private readonly Dictionary<string, string> objAspects = new()
    {
        ["16:9"] = "16:9 — Landscape",
        ["9:16"] = "9:16 — Reels",
        ["1:1"] = "1:1 — Square",
    };
    private string objAspect = "16:9";

    private readonly List<TierInfo> objTiers = new()
    {
        new TierInfo("Fast", "Fast", "Mac", "Local Mac (MPS)", "SVD local", 0.00m, "~30s", "Local Mac (MPS) · Stable Video Diffusion", GenerationTier.Fast, false, false),
        new TierInfo("High", "High", "Wan 2.x", "Wan 2.x (RunPod)", "Wan 2.x", 0.18m, "~2m", "Serverless GPU · high-motion HD", GenerationTier.High, true, false),
        new TierInfo("Premium", "Premium", "HeyGen", "HeyGen", "HeyGen Video", 0.90m, "~4m", "Closed API · studio quality", GenerationTier.Premium, true, true),
    };
    private string objTier = "High";

    private string objPrompt = "A slow cinematic push-in on a neon-lit city street at dusk, gentle rain, reflective pavement.";
    private string? objFirstFrame;
    private string? objLastFrame;

    private bool objInterpolate = true;
    private bool objSmooth;

    private readonly Dictionary<string, string> objExportPresets = new()
    {
        ["youtube"] = "YouTube (16:9, H.264)",
        ["reels"] = "Instagram Reels (9:16)",
        ["raw"] = "Raw MP4",
    };
    private string objExportPreset = "youtube";

    private readonly (string Name, string Icon)[] objEditTools =
    {
        ("Trim", "scissors"), ("Join", "link"), ("Reframe", "crop"), ("Add audio", "volume-2"), ("Split", "split")
    };

    private readonly List<ClipSegment> objClips = new();
    private string? objSelectedClip;
    private string? objAudioLabel;

    private bool objRendering;
    private int objProgress;

    // ---- Phase 2 (Venice): registry-driven model picker, character filter, model-bound values ----
    private const string NoCharacter = "none";
    private List<CatalogModelResponse> objCatalog = new();
    private List<CharacterResponse> objCharacters = new();
    private string? objModelId;
    private string? objCharacterId = NoCharacter;
    private string? objDurationValue;
    private string? objResolution;
    private bool objVeniceRun;
    private TimeSpan? objEta;
    private decimal? objVenicePrice;
    private string? objVeniceFailure;
    private readonly CancellationTokenSource objCts = new();

    /// <summary>The rows the picker lists for the current mode and character (REQ-UI-089/091/092).</summary>
    private IReadOnlyList<CatalogModelResponse> ListedModels =>
        VideoModelFilter.ForStudio(objCatalog, IsImageToVideo, objCharacterId != NoCharacter);

    /// <summary>The picked catalog row, or null when the catalog has none for this choice.</summary>
    private CatalogModelResponse? SelectedModel => ListedModels.FirstOrDefault(aModel => aModel.Id == objModelId);

    /// <summary>The duration/resolution/aspect values the picked row allows (REQ-FN-081).</summary>
    private AllowedVideoValues AllowedValues => VideoModelFilter.Allowed(SelectedModel);

    /// <summary>Whether the picked row states its own durations (then a Select replaces the slider).</summary>
    private bool ModelStatesDurations => SelectedModel is { Durations.Length: > 0 };

    /// <summary>The clip length in seconds from whichever duration control is shown.</summary>
    private int DurationSeconds => ModelStatesDurations ? VideoModelFilter.Seconds(objDurationValue) : (int)objDuration;

    /// <summary>The model name shown in captions: the picked row, else the tier's default.</summary>
    private string ModelLabel => SelectedModel?.DisplayName ?? SelectedTier.Model;

    /// <summary>One line naming the values the picked row allows.</summary>
    private string AllowedSummary
    {
        get
        {
            var vParts = new List<string> { $"Duration {string.Join("/", AllowedValues.Durations)}" };
            if (AllowedValues.Resolutions.Count > 0)
            {
                vParts.Add(string.Join("/", AllowedValues.Resolutions));
            }

            vParts.Add(string.Join(", ", AllowedValues.AspectRatios));
            return string.Join(" · ", vParts) + " from this model";
        }
    }

    /// <summary>Whether the studio is in Image→Video mode (vs Text→Video).</summary>
    private bool IsImageToVideo => objMode == "i2v";

    /// <summary>The currently selected quality tier's metadata.</summary>
    private TierInfo SelectedTier =>
        objTiers.FirstOrDefault(aTier => aTier.Key == objTier) ?? objTiers[0];

    /// <summary>Total timeline length shown in the toolbar, as <c>elapsed / total</c>.</summary>
    private string TimelineDuration
    {
        get
        {
            var vTotal = TimeSpan.FromSeconds(objClips.Sum(aClip => aClip.Seconds));
            return $"00:00 / {(int)vTotal.TotalMinutes:00}:{vTotal.Seconds:00}";
        }
    }

    /// <summary>The clip the creator picked on the video track, or null when none is picked.</summary>
    private ClipSegment? SelectedClip => objClips.FirstOrDefault(aClip => aClip.Label == objSelectedClip);

    /// <summary>A tier button's second line: where it runs, its eta and its cost (<c>Mac · ~30s · $0</c>).</summary>
    /// <param name="aTier">The tier.</param>
    private static string TierLine(TierInfo aTier) =>
        $"{aTier.Short} · {aTier.Eta} · {(aTier.Cost == 0m ? "$0" : FormatCost(aTier.Cost))}";

    /// <summary>Lower-case dash slug for control names (<c>Wan 2.x (RunPod)</c> → <c>wan-2-x-runpod</c>).</summary>
    /// <param name="aText">The text to slug.</param>
    private static string Slug(string aText) =>
        System.Text.RegularExpressions.Regex.Replace(aText.ToLowerInvariant(), "[^a-z0-9]+", "-").Trim('-');

    /// <summary>A simple eta string derived from the render progress.</summary>
    private string RenderEta => objProgress >= 100 ? "0:00" : $"0:{Math.Max(1, (100 - objProgress) / 2):00}";

    /// <summary>
    /// Confirms a signed-in session AFTER the first interactive render (JS interop available) so any
    /// later owner-scoped spine call carries the bearer token rather than racing prerender. The studio
    /// itself renders regardless (enrich-or-seed) — no catalog is required for the video surface.
    /// </summary>
    /// <param name="aFirstRender">Whether this is the component's first render.</param>
    protected override async Task OnAfterRenderAsync(bool aFirstRender)
    {
        if (!aFirstRender)
        {
            return;
        }

        var vHasSession = await AuthSession.EnsureLoadedAsync();

        // Send-to-studio (REQ-UI-082): pre-fill the prompt and switch to Text→Video when Prompt Studio
        // routes here with ?prompt=… (the T2V mode is where the prompt Textarea is shown).
        var vPrompt = PromptStudioQuery.ReadPrompt(Navigation.Uri);
        if (vPrompt is not null)
        {
            objPrompt = vPrompt;
            objMode = "t2v";
        }

        if (vHasSession)
        {
            await LoadPickerAsync();
            await LoadTimelineAsync();
        }

        SyncPicker();
        StateHasChanged();
    }

    /// <summary>
    /// Loads the creator catalog and the character library for the model picker. Failures leave the
    /// lists empty (the picker says no model fits and the tier buttons still route), never fake rows.
    /// </summary>
    private async Task LoadPickerAsync()
    {
        var vClient = HttpClientFactory.CreateClient("TrStudioApi");
        try
        {
            objCatalog = await vClient.GetFromJsonAsync<List<CatalogModelResponse>>(ApiRoutes.Models, objCts.Token) ?? new();
        }
        catch (Exception aEx) when (aEx is not OperationCanceledException)
        {
            objCatalog = new();
        }

        try
        {
            objCharacters = await vClient.GetFromJsonAsync<List<CharacterResponse>>(ApiRoutes.Characters, objCts.Token) ?? new();
        }
        catch (Exception aEx) when (aEx is not OperationCanceledException)
        {
            objCharacters = new();
        }
    }

    /// <summary>
    /// Puts the creator's generated video clips (not talking-head renders) on the video track, oldest first (clip01, clip02, …),
    /// each with its length, model and aspect from the run's own params, and their newest Voice Studio
    /// narration on the audio track. Nothing is shown when there are none or they can't be read.
    /// </summary>
    private async Task LoadTimelineAsync()
    {
        try
        {
            var vClient = HttpClientFactory.CreateClient("TrStudioApi");
            var vPage = await vClient.GetFromJsonAsync<PagedResult<AssetResponse>>($"{ApiRoutes.Assets}?aKind=video&aPageSize=50", objCts.Token);
            // Talking-head renders (lip-sync models, the Avatar studio's output) are not clips of this timeline.
            var vAssets = (vPage?.Items ?? Array.Empty<AssetResponse>())
                .Where(aAsset => objCatalog.FirstOrDefault(aModel => aModel.Id == aAsset.ModelId)?.Task != GenerationTaskType.LipSync)
                .OrderBy(aAsset => aAsset.CreatedUtc).ToList();
            objClips.Clear();
            foreach (var vAsset in vAssets)
            {
                using var vDoc = JsonDocument.Parse(string.IsNullOrWhiteSpace(vAsset.ParamsJson) ? "{}" : vAsset.ParamsJson);
                var vRoot = vDoc.RootElement;
                var vSeconds = vRoot.ValueKind == JsonValueKind.Object && vRoot.TryGetProperty("durationSeconds", out var vDur) && vDur.TryGetInt32(out var vSec) ? vSec : 0;
                var vAspect = vRoot.ValueKind == JsonValueKind.Object && vRoot.TryGetProperty("aspectRatio", out var vAsp) && vAsp.ValueKind == JsonValueKind.String ? vAsp.GetString() ?? "16:9" : "16:9";
                var vModel = objCatalog.FirstOrDefault(aModel => aModel.Id == vAsset.ModelId)?.DisplayName ?? vAsset.ModelId;
                objClips.Add(new ClipSegment($"clip{objClips.Count + 1:00}", Math.Max(1, vSeconds), vModel, vAspect));
            }
        }
        catch (Exception aEx) when (aEx is not OperationCanceledException)
        {
            // Unreadable list: the timeline stays empty.
        }

        objAudioLabel = await FindNarrationAsync();
    }

    /// <summary>
    /// Names the creator's newest Voice Studio narration as <c>&lt;voice&gt; narration · from Voice Studio</c>,
    /// or null when they have none.
    /// </summary>
    private async Task<string?> FindNarrationAsync()
    {
        try
        {
            var vClient = HttpClientFactory.CreateClient("TrStudioApi");
            var vPage = await vClient.GetFromJsonAsync<PagedResult<AssetResponse>>($"{ApiRoutes.Assets}?aKind=audio&aPageSize=1", objCts.Token);
            var vNewest = vPage?.Items.FirstOrDefault();
            if (vNewest is null)
            {
                return null;
            }

            using var vDoc = JsonDocument.Parse(string.IsNullOrWhiteSpace(vNewest.ParamsJson) ? "{}" : vNewest.ParamsJson);
            var vVoiceId = vDoc.RootElement.ValueKind == JsonValueKind.Object && vDoc.RootElement.TryGetProperty("VoiceId", out var vId) && vId.ValueKind == JsonValueKind.String
                ? vId.GetString()
                : null;
            var vVoices = await vClient.GetFromJsonAsync<List<PresetVoiceResponse>>("/api/v1/voice/preset-voices", objCts.Token) ?? new();
            var vName = vVoices.FirstOrDefault(aVoice => aVoice.VoiceId == vVoiceId)?.DisplayName;
            return vName is null ? "Narration · from Voice Studio" : $"{vName} narration · from Voice Studio";
        }
        catch (Exception aEx) when (aEx is not OperationCanceledException)
        {
            return null;
        }
    }

    /// <summary>
    /// Re-picks the model for the current mode/character/tier and keeps duration, resolution and
    /// aspect inside the values the picked row allows (REQ-FN-081).
    /// </summary>
    private void SyncPicker()
    {
        objModelId = VideoModelFilter.PickModel(objModelId, ListedModels, SelectedTier.Tier);
        var vAllowed = AllowedValues;
        objDurationValue = VideoModelFilter.KeepOrFirst(objDurationValue ?? $"{(int)objDuration}s", vAllowed.Durations);
        objResolution = VideoModelFilter.KeepOrFirst(objResolution, vAllowed.Resolutions);
        objAspect = VideoModelFilter.KeepOrFirst(objAspect, vAllowed.AspectRatios) ?? "16:9";
        objVenicePrice = null;
    }

    /// <summary>Switches the generation mode and swaps the conditioning controls.</summary>
    /// <param name="aMode">The chosen mode tab value (<c>i2v</c> or <c>t2v</c>).</param>
    private void OnModeChanged(string? aMode)
    {
        objMode = aMode ?? "i2v";
        SyncPicker();
    }

    /// <summary>Chooses a tier button; the picker moves to that tier's first listed row when the current one is gone.</summary>
    /// <param name="aTier">The tier key.</param>
    private void OnTierChanged(string? aTier)
    {
        objTier = aTier ?? "High";
        var vOnTier = ListedModels.FirstOrDefault(aModel => aModel.Tier == SelectedTier.Tier);
        if (vOnTier is not null && SelectedModel?.Tier != SelectedTier.Tier)
        {
            objModelId = vOnTier.Id;
        }

        SyncPicker();
    }

    /// <summary>Picks a model row and refits the duration/resolution/aspect controls to it.</summary>
    /// <param name="aId">The row id.</param>
    private void OnModelChanged(string? aId)
    {
        objModelId = aId;
        SyncPicker();
    }

    /// <summary>Picks (or clears) a character; only fixed-character rows stay listed (REQ-UI-092).</summary>
    /// <param name="aId">The character id, or <see cref="NoCharacter"/>.</param>
    private void OnCharacterChanged(string? aId)
