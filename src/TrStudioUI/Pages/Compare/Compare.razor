@page "/compare"
@using TrBlazeUI.Components.NativeSelect
@using System.Text.Json
@using System.Text.RegularExpressions
@inject IHttpClientFactory HttpClientFactory
@inject ToastService ToastService
@inject NavigationManager Navigation
@inject IAuthSession AuthSession

@*
    Comparison (REQ-UI-052). Side-by-side across models, seeds and providers — reached from the
    Gallery Compare action (breadcrumb Gallery / Compare) carrying an owner-scoped ?assetIds= set.
    A slot toolbar (A/B asset selects, "Add third", a side-by-side/overlay toggle, sync-playback Switch)
    drives result panes: each shows a preview with a duration chip, model / tier·provider / seed /
    provenance Badges and cost/created/resolution rows, plus per-pane Reproduce/Export/Open-in-Gallery.
    A parameter-diff DataTable marks the rows that differ, with a "N differ" badge and a show-identical
    toggle. Per-user: the slot options come from the owner-scoped /api/v1/assets listing (with each
    run's provider and price from the generation log), model names and tiers from the model catalog,
    and the param sets from GET /api/v1/compare?assetIds= — live-only, no representative seed; an
    unreachable API raises a warning Alert. With no ?assetIds= the slots open on the newest pair of
    runs that share a title (two variants of one piece), else the two newest runs. Fewer than two
    picks shows an empty state to Gallery. Control names follow docs/mockups/compare.html.
*@

<PageTitle>TrStudio — Compare</PageTitle>

<Breadcrumb>
    <BreadcrumbList>
        <BreadcrumbItem><BreadcrumbLink Href="/gallery" data-testid="link-gallery">Gallery</BreadcrumbLink></BreadcrumbItem>
        <BreadcrumbSeparator />
        <BreadcrumbItem><BreadcrumbPage>Compare</BreadcrumbPage></BreadcrumbItem>
    </BreadcrumbList>
</Breadcrumb>

<h1 class="page-title">Compare</h1>
<p class="page-sub">Side-by-side across models, seeds and providers — differing parameters are highlighted so you can see exactly what changed between runs.</p>

@if (objApiDown)
{
    <div data-testid="api-down-alert" style="margin-bottom:14px">
        <Alert Variant="AlertVariant.Warning" AccentBorder="true">
            <LucideIcon Name="circle-alert" Size="16" />
            <AlertTitle>Couldn't reach the API — data unavailable</AlertTitle>
            <AlertDescription>Your assets couldn't be loaded for comparison. Check that TrStudioApi is running and reload.</AlertDescription>
        </Alert>
    </div>
}

@if (objLoading)
{
    <div class="cmp-panes cmp-panes-2">
        @for (var vIndex = 0; vIndex < 2; vIndex++)
        {
            <Card>
                <Skeleton Class="cmp-thumb" />
                <Skeleton Class="h-4 w-3/5 mb-2" />
                <Skeleton Class="h-4 w-4/5" />
            </Card>
        }
    </div>
}
else
{
    @* ---- Slot toolbar ---- *@
    <div class="cmp-slotbar" data-testid="compare-slotbar">
        @for (var vSlotIndex = 0; vSlotIndex < objSlots.Count; vSlotIndex++)
        {
            var vSlot = objSlots[vSlotIndex];
            <span class="cmp-slot">
            <span class="cmp-slottag">@vSlot.Tag</span>
            @* A long asset name wraps in the box instead of being cut (screen check, 18 Nov 2026): the label
               draws the chosen name; the real select lies on top of it, invisible, and takes every click and key. *@
            <div class="select-wrap cmp-slot-wrap" data-testid="@($"slot-{vSlotIndex + 1}-box")">
                <div class="select-wrap-label rounded-md border border-input bg-background text-sm" aria-hidden="true" data-testid="@($"slot-{vSlotIndex + 1}-chosen")">
                    @(objAssets.FirstOrDefault(aAsset => aAsset.AssetId == vSlot.AssetId)?.OptionLabel ?? "Pick an asset")
                </div>
                <NativeSelect TValue="string" Value="@vSlot.AssetId" ValueChanged="@(aValue => OnSlotChangedAsync(vSlot, aValue))"
                              Placeholder="Pick an asset" Class="cmp-slot-select select-wrap-native" aria-label="@($"Slot {vSlot.Tag}")" data-testid="@($"field-{vSlotIndex + 1}")">
                    @foreach (var vAsset in objAssets)
                    {
                        <option value="@vAsset.AssetId">@vAsset.OptionLabel</option>
                    }
                </NativeSelect>
            </div>
            </span>
        }
        @if (objSlots.Count < 3)
        {
            <Button Variant="ButtonVariant.Outline" OnClick="AddThirdAsync" data-testid="btn-add-third">
                <LucideIcon Name="plus" Size="14" />
                Add third
            </Button>
        }
        <div class="grow"></div>
        <div class="cmp-seg" role="group" aria-label="View">
            <button type="button" class="@(objViewMode == "side" ? "active" : null)" aria-pressed="@(objViewMode == "side" ? "true" : "false")"
                    @onclick="@(() => objViewMode = "side")" data-testid="btn-side-by-side">Side-by-side</button>
            <button type="button" class="@(objViewMode == "overlay" ? "active" : null)" aria-pressed="@(objViewMode == "overlay" ? "true" : "false")"
                    @onclick="@(() => objViewMode = "overlay")" data-testid="btn-overlay">Overlay</button>
        </div>
        <div class="flex-row">
            <Switch @key="@("sync")" @bind-Checked="objSyncPlayback" Id="cmp-sync" data-testid="switch" />
            <Label For="cmp-sync" Class="muted-sm">Sync playback</Label>
        </div>
    </div>

    @if (Panes.Count < 2)
    {
        <Card Class="emptystate" data-testid="card-nothing-to-compare-yet">
            <div class="emptyicon"><LucideIcon Name="git-compare" Size="22" /></div>
            <h3 style="margin:0 0 4px">Nothing to compare yet</h3>
            <div class="muted-sm" style="margin-bottom:14px">Select two or more assets in the Gallery and hit Compare, or pick them in the slots above.</div>
            <Button Href="/gallery" data-testid="link-go-to-gallery">Go to Gallery</Button>
        </Card>
    }
    else
    {
        var vPanes = Panes;
        var vBadgeIds = BadgeTestIds(vPanes);
        @* ---- Result panes ---- *@
        <div class="cmp-panes @(objViewMode == "overlay" ? "cmp-panes-overlay" : "cmp-panes-2")" data-testid="compare-panes">
            @for (var vPaneIndex = 0; vPaneIndex < vPanes.Count; vPaneIndex++)
            {
                var vPane = vPanes[vPaneIndex];
                var vPaneNo = vPaneIndex;
                var vSuffix = vPaneIndex == 0 ? string.Empty : $"-{vPaneIndex + 1}";
                <Card Class="cmp-pane" @key="vPane.Tag" data-testid="@($"card-{vPaneNo + 1}")">
                    <div class="cmp-thumb @vPane.Art">
                        <span class="cmp-play"><LucideIcon Name="@(vPane.IsVideo ? "play" : vPane.Kind == "audio" ? "audio-lines" : "image")" Size="16" /></span>
                        @if (vPane.Duration is not null)
                        {
                            <span class="cmp-durchip">@vPane.Duration</span>
                        }
                    </div>
                    <div class="cmp-pane-title">@vPane.Tag — @vPane.Title</div>
                    <div class="cmp-badges">
                        @foreach (var vBadge in vPane.Badges)
                        {
                            <Badge Variant="@(vBadge.Tone == "badge-brand" ? BadgeVariant.Default : BadgeVariant.Outline)" Class="@vBadge.Tone" data-testid="@vBadgeIds[(vPaneNo, vBadge.Text)]">@vBadge.Text</Badge>
                        }
                    </div>
                    <div class="kv"><span class="muted">Cost</span><b>@vPane.Cost</b></div>
                    <div class="kv"><span class="muted">Created</span><b>@vPane.Created</b></div>
                    <div class="kv"><span class="muted">Resolution</span><b>@vPane.ResolutionLabel</b></div>
                    <div class="cmp-acts">
                        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Class="cmp-act" OnClick="@(() => ReproduceAsync(vPane))" data-testid="@($"btn-reproduce{vSuffix}")">Reproduce</Button>
                        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Class="cmp-act" OnClick="@(() => Export(vPane))" data-testid="@($"btn-export{vSuffix}")">Export</Button>
                        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Class="cmp-act" Href="/gallery" data-testid="@($"link-open-in-gallery{vSuffix}")">Open in Gallery</Button>
                    </div>
                </Card>
            }
        </div>

        @* ---- Parameter diff ---- *@
        <Card Class="cmp-diff-card" data-testid="@($"card-parameters-{DiffCount}-differ")">
            <div class="flex-between" style="margin-bottom:6px">
                <h3 class="card-h3" style="margin:0">
                    Parameters
                    <span class="cmp-diffmark">@DiffCount differ</span>
                </h3>
                <div class="flex-row">
                    <Switch @key="@("show-identical")" @bind-Checked="objShowIdentical" @bind-Checked:after="StateHasChanged" Id="cmp-identical" data-testid="switch-2" />
                    <Label For="cmp-identical" Class="muted-sm">Show identical rows</Label>
                </div>
            </div>
            <div class="table-scroll" data-testid="compare-diff">
                <DataTable TData="DiffRow" Data="@VisibleDiffRows" ShowToolbar="false" ShowPagination="false" data-testid="table-1">
                    <Columns>
                        <DataTableColumn TData="DiffRow" TValue="string" Property="@(r => r.Parameter)" Header="Parameter">
                            <CellTemplate Context="objRow">
                                <span class="@(objRow.Differs ? "cmp-diff-param" : null)">
                                    @if (objRow.Differs)
                                    {
                                        <span class="dot brand"></span>
                                    }
                                    @objRow.Parameter
                                </span>
                            </CellTemplate>
                        </DataTableColumn>
                        <DataTableColumn TData="DiffRow" TValue="string" Property="@(r => r.ValueA)" Header="@ColumnAHeader">
                            <CellTemplate Context="objRow">
                                <span class="@(objRow.Differs ? "cmp-diff-cell" : null)">@objRow.ValueA</span>
                            </CellTemplate>
                        </DataTableColumn>
                        <DataTableColumn TData="DiffRow" TValue="string" Property="@(r => r.ValueB)" Header="@ColumnBHeader">
                            <CellTemplate Context="objRow">
                                <span class="@(objRow.Differs ? "cmp-diff-cell" : null)">@objRow.ValueB</span>
                            </CellTemplate>
                        </DataTableColumn>
                    </Columns>
                </DataTable>
            </div>
        </Card>

        <Alert Variant="AlertVariant.Default" Class="cmp-alert" data-testid="alert-info">
            <AlertDescription>
                @SummaryLead — use <b>Reproduce</b> on the winner to re-run it, or export both for review.
            </AlertDescription>
        </Alert>
    }
}

@code {
    private const string CompareRoute = "/api/v1/compare";

    private readonly List<CompareAsset> objAssets = new();

    /// <summary>Per-asset generation params from the live compare endpoint, keyed by asset id.</summary>
    private readonly Dictionary<string, Dictionary<string, string>> objParamsByAsset = new();

    private readonly List<Slot> objSlots = new() { new Slot("A"), new Slot("B") };
    private bool objLoading = true;
    private bool objApiDown;
    private string objViewMode = "side";
    private bool objSyncPlayback = true;
    private bool objShowIdentical;

    /// <summary>The panes currently filled by the A/B/C slots (a slot with no pick is skipped).</summary>
    private List<CompareAsset> Panes =>
        objSlots.Select(aSlot => (Slot: aSlot, Asset: objAssets.FirstOrDefault(aAsset => aAsset.AssetId == aSlot.AssetId)))
            .Where(aPair => aPair.Asset is not null)
            .Select(aPair => aPair.Asset! with { Tag = aPair.Slot.Tag })
            .ToList();

    /// <summary>Header for the A column, naming the model in slot A.</summary>
    private string ColumnAHeader => Panes.Count > 0 ? $"{Panes[0].Tag} — {Panes[0].Model}" : "A";

    /// <summary>Header for the B column, naming the model in slot B.</summary>
    private string ColumnBHeader => Panes.Count > 1 ? $"{Panes[1].Tag} — {Panes[1].Model}" : "B";

    /// <summary>The parameter rows comparing the first two panes.</summary>
    private List<DiffRow> DiffRows => Panes.Count < 2 ? new List<DiffRow>() : BuildDiff(Panes[0], Panes[1]);

    /// <summary>Diff rows honouring the show-identical toggle (differing-only when off).</summary>
    private List<DiffRow> VisibleDiffRows =>
        objShowIdentical ? DiffRows : DiffRows.Where(aRow => aRow.Differs).ToList();

    /// <summary>The count of parameters that differ between the first two panes.</summary>
    private int DiffCount => DiffRows.Count(aRow => aRow.Differs);

    /// <summary>
    /// The lead of the summary note under the table, read from the diff: what the two runs share
    /// (seed, script or prompt) and which parameters differ — e.g. "Same seed, same script — only the
    /// model, provider · tier, resolution and cost differ".
    /// </summary>
    private string SummaryLead
    {
        get
        {
            var vRows = DiffRows;
            var vSame = vRows.Where(aRow => !aRow.Differs && !string.IsNullOrEmpty(aRow.ValueA) && aRow.ValueA != "—")
                .Select(aRow => aRow.Parameter.ToLowerInvariant())
                .Where(aName => aName is "seed" or "script" or "prompt" or "text")
                .Select(aName => $"same {aName}")
                .ToList();
            var vDiffer = vRows.Where(aRow => aRow.Differs).Select(aRow => aRow.Parameter.ToLowerInvariant()).ToList();
            if (vDiffer.Count == 0)
            {
                return "These runs share every parameter";
            }

            var vList = vDiffer.Count == 1 ? vDiffer[0] : $"{string.Join(", ", vDiffer.Take(vDiffer.Count - 1))} and {vDiffer[^1]}";
            var vLead = vSame.Count == 0 ? string.Empty : $"{char.ToUpperInvariant(vSame[0][0])}{string.Join(", ", vSame)[1..]} — ";
            return vLead.Length == 0 ? $"Only the {vList} differ" : $"{vLead}only the {vList} differ";
        }
    }

    /// <summary>
    /// Loads the owner-scoped compare set AFTER the first interactive render — the point at which JS
    /// interop is available and <see cref="IAuthSession"/> can hydrate the bearer token. Loading here
    /// (not in <c>OnInitializedAsync</c>, which runs during prerender before the token exists) avoids a
    /// wasted anonymous 401 and the sample-data flash it would cause.
    /// </summary>
    /// <param name="aFirstRender">Whether this is the component's first render.</param>
    protected override async Task OnAfterRenderAsync(bool aFirstRender)
    {
        if (!aFirstRender)
        {
            return;
        }

        var vHasSession = await AuthSession.EnsureLoadedAsync();
        await TryLoadCompareAsync(vHasSession);
        objLoading = false;
        StateHasChanged();
    }

    /// <summary>
    /// Loads the owner-scoped asset options (the slot selects) and the model catalog (display names
    /// and tiers), pre-assigns the slots from <c>?assetIds=</c> when the Gallery handed a set across,
    /// then fetches the picked assets' live param sets. No seed data: an empty library renders the
    /// honest empty state, and a failed fetch raises the API-down Alert.
    /// </summary>
    /// <param name="aHasSession">Whether a signed-in session is present.</param>
    private async Task TryLoadCompareAsync(bool aHasSession)
    {
        if (!aHasSession)
        {
            return;
        }

        var vClient = HttpClientFactory.CreateClient("TrStudioApi");
        var vModels = new Dictionary<string, CatalogModelResponse>(StringComparer.OrdinalIgnoreCase);
        try
        {
            foreach (var vModel in await vClient.GetFromJsonAsync<List<CatalogModelResponse>>(ApiRoutes.Models) ?? new())
            {
                vModels[vModel.Id] = vModel;
            }
        }
        catch
        {
            // Names are a nicety: without them a pane shows the model id and no tier.
        }

        try
        {
            var vPage = await vClient.GetFromJsonAsync<PagedResult<AssetResponse>>($"{ApiRoutes.Assets}?aPageSize=100");
            objAssets.Clear();
            var vArts = new[] { "art-v", "art-a", "art-b", "art-c" };
            var vIndex = 0;
            foreach (var vAsset in vPage?.Items ?? new List<AssetResponse>())
            {
                objAssets.Add(CompareAsset.FromResponse(vAsset, vArts[vIndex % vArts.Length], vModels));
                vIndex++;
            }
        }
        catch
        {
            // API unreachable — never fake data; the warning Alert renders instead.
            objApiDown = true;
            return;
        }

        AssignSlots(ReadAssetIdsFromQuery());
        await RefreshComparedParamsAsync();
    }

    /// <summary>
    /// Fetches the picked assets' generation params from the live compare endpoint
    /// (<c>GET /api/v1/compare?assetIds=</c>) so the diff table reflects the stored run parameters.
    /// Runs whenever the slot picks change; fewer than two picks fetches nothing.
    /// </summary>
    private async Task RefreshComparedParamsAsync()
    {
        var vIds = objSlots.Select(aSlot => aSlot.AssetId)
            .Where(aId => !string.IsNullOrEmpty(aId))
            .Distinct()
            .ToList();

        if (vIds.Count < 2)
        {
            return;
        }

        try
        {
            var vClient = HttpClientFactory.CreateClient("TrStudioApi");
            var vResponse = await vClient.GetFromJsonAsync<CompareResponse>(
                $"{CompareRoute}?assetIds={Uri.EscapeDataString(string.Join(',', vIds))}");
            foreach (var vEntry in vResponse?.Assets ?? new List<CompareAssetEntry>())
            {
                objParamsByAsset[vEntry.Asset.AssetId.ToString()] = vEntry.Params;
            }
        }
        catch
        {
            // Compare endpoint unreachable — the diff table shows only the asset-level rows.
            objApiDown = true;
        }
    }

    /// <summary>Stores a slot's new pick and re-fetches the compared param sets.</summary>
    private async Task OnSlotChangedAsync(Slot aSlot, string? aAssetId)
    {
        aSlot.AssetId = string.IsNullOrEmpty(aAssetId) ? null : aAssetId;
        await RefreshComparedParamsAsync();
        StateHasChanged();
    }

    /// <summary>Reads the comma-separated <c>assetIds</c> query parameter, if present.</summary>
    private List<string> ReadAssetIdsFromQuery()
    {
        var vQuery = new Uri(Navigation.Uri).Query.TrimStart('?');
        foreach (var vPair in vQuery.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var vEq = vPair.IndexOf('=');
            if (vEq <= 0)
            {
                continue;
            }

            if (Uri.UnescapeDataString(vPair[..vEq]) == "assetIds")
            {
                var vValue = Uri.UnescapeDataString(vPair[(vEq + 1)..]);
                return vValue.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
            }
        }

        return new List<string>();
    }

    /// <summary>
    /// Fills the A/B (and any added) slots: from the Gallery's ?assetIds= set when present; otherwise
    /// the newest pair of runs sharing a title (two variants of one piece, newest first); otherwise
    /// the newest runs.
    /// </summary>
    /// <param name="aRequestedIds">Asset ids handed across from the Gallery, in slot order.</param>
    private void AssignSlots(List<string> aRequestedIds)
    {
        var vRequested = aRequestedIds.Where(aId => objAssets.Any(aAsset => aAsset.AssetId == aId)).ToList();
        var vVariants = vRequested.Count > 0
            ? new List<string>()
            : objAssets.Where(aAsset => aAsset.HasOwnTitle)
                .GroupBy(aAsset => aAsset.Title)
                .Where(aGroup => aGroup.Count() >= 2)
                .OrderByDescending(aGroup => aGroup.Max(aAsset => aAsset.CreatedUtc))
                .Select(aGroup => aGroup.OrderByDescending(aAsset => aAsset.CreatedUtc).Select(aAsset => aAsset.AssetId).ToList())
                .FirstOrDefault() ?? new List<string>();

        var vOrdered = vRequested
            .Concat(vVariants)
            .Concat(objAssets.Select(aAsset => aAsset.AssetId))
            .Distinct()
            .ToList();

        for (var vIndex = 0; vIndex < objSlots.Count && vIndex < vOrdered.Count; vIndex++)
        {
            objSlots[vIndex].AssetId = vOrdered[vIndex];
        }
    }

    private async Task AddThirdAsync()
    {
        if (objSlots.Count >= 3)
        {
            return;
        }

        var vSlot = new Slot("C");
        var vNext = objAssets.FirstOrDefault(aAsset => objSlots.All(aExisting => aExisting.AssetId != aAsset.AssetId));
        vSlot.AssetId = vNext?.AssetId;
        objSlots.Add(vSlot);
        await RefreshComparedParamsAsync();
    }

    /// <summary>One-click reproduce for a pane via the generation-log reproduce endpoint.</summary>
    /// <param name="aPane">The pane whose run to reproduce.</param>
    private async Task ReproduceAsync(CompareAsset aPane)
    {
        try
        {
            var vClient = HttpClientFactory.CreateClient("TrStudioApi");
            var vResponse = await vClient.PostAsync($"{ApiRoutes.GenerationLog}/{aPane.JobId}/reproduce", content: null);
            if (vResponse.IsSuccessStatusCode)
            {
                ToastService.Success($"Reproducing \"{aPane.Title}\" ({aPane.Model}) with its stored params.", "Reproduce");
                return;
            }
        }
        catch
        {
            // Fall through to the honest failure toast.
        }

        ToastService.Error("Couldn't reach the API — the reproduce wasn't submitted.", "Reproduce");
    }

    private void Export(CompareAsset aPane)
        => ToastService.Success($"Exporting \"{aPane.Title}\".", "Export");

    /// <summary>
    /// The control name of each pane badge: <c>badge-</c> and the badge's words (as the mockup names
    /// them), with <c>-2</c>, <c>-3</c>, … on repeats across the panes.
    /// </summary>
    private static Dictionary<(int Pane, string Text), string> BadgeTestIds(List<CompareAsset> aPanes)
    {
        var vSeen = new Dictionary<string, int>();
        var vIds = new Dictionary<(int, string), string>();
        for (var vIndex = 0; vIndex < aPanes.Count; vIndex++)
        {
            foreach (var vBadge in aPanes[vIndex].Badges)
            {
                var vBase = $"badge-{Slug(vBadge.Text)}";
                vBase = vBase.Length > 30 ? vBase[..30].TrimEnd('-') : vBase;
                vSeen[vBase] = vSeen.TryGetValue(vBase, out var vCount) ? vCount + 1 : 1;
                vIds[(vIndex, vBadge.Text)] = vSeen[vBase] == 1 ? vBase : $"{vBase}-{vSeen[vBase]}";
            }
        }

        return vIds;
    }

    private static string Slug(string aText) =>
        Regex.Replace(aText.ToLowerInvariant(), "[^a-z0-9]+", "-").Trim('-');

    /// <summary>
    /// Builds the parameter comparison between two panes: the asset-level rows (model, provider ·
    /// tier, resolution, cost, seed) plus the union of both runs' stored parameter keys from the live
    /// compare endpoint (the run title is left out — it is the pane heading), flagging the rows that differ.
    /// </summary>
    private List<DiffRow> BuildDiff(CompareAsset aA, CompareAsset aB)
    {
        var vParamsA = objParamsByAsset.GetValueOrDefault(aA.AssetId) ?? new Dictionary<string, string>();
        var vParamsB = objParamsByAsset.GetValueOrDefault(aB.AssetId) ?? new Dictionary<string, string>();

        var vRows = new List<DiffRow>
        {
            DiffRow.Of("Model", aA.Model, aB.Model),
            DiffRow.Of("Provider · tier", aA.ProviderTier, aB.ProviderTier),
            DiffRow.Of("Resolution", aA.Resolution, aB.Resolution),
            DiffRow.Of("Cost", aA.Cost, aB.Cost),
            DiffRow.Of("Seed", aA.SeedLabel, aB.SeedLabel),
        };

        foreach (var vKey in vParamsA.Keys.Union(vParamsB.Keys)
                     .Where(aKey => !string.Equals(aKey, "title", StringComparison.OrdinalIgnoreCase))
                     .OrderBy(aKey => aKey, StringComparer.OrdinalIgnoreCase))
        {
            vRows.Add(DiffRow.Of(Humanize(vKey), vParamsA.GetValueOrDefault(vKey, string.Empty), vParamsB.GetValueOrDefault(vKey, string.Empty)));
        }

        return vRows;
    }

    /// <summary>A stored parameter key as a row label: "durationSeconds" → "Duration seconds".</summary>
    private static string Humanize(string aKey)
    {
        var vWords = Regex.Replace(aKey, "(?<=[a-z0-9])(?=[A-Z])", " ").Replace('_', ' ').ToLowerInvariant();
        return vWords.Length == 0 ? aKey : $"{char.ToUpperInvariant(vWords[0])}{vWords[1..]}";
    }

    /// <summary>A compare slot (A/B/C) holding the picked asset id.</summary>
    private sealed class Slot
    {
        public Slot(string aTag) => Tag = aTag;

        /// <summary>The slot label (A, B or C).</summary>
        public string Tag { get; }

        /// <summary>The picked asset id, or null when the slot is empty.</summary>
        public string? AssetId { get; set; }
    }

    /// <summary>A pane badge: its words and its tone class (null for the plain outline badge).</summary>
    private sealed record PaneBadge(string Text, string? Tone);

    /// <summary>A compare pane's display projection over a live owner-scoped asset.</summary>
    private sealed record CompareAsset(
        string Tag, string AssetId, Guid JobId, string Kind, string Title, bool HasOwnTitle, string Model,
        string? Provider, string? Tier, long? Seed, bool ProvenanceSigned, string Cost, DateTime CreatedUtc,
        string Created, string Resolution, string? Aspect, string? Duration, string Art)
    {
        /// <summary>Whether the asset is a video (play icon on the preview).</summary>
        public bool IsVideo => Kind == "video";

        /// <summary>The seed as a display label, or an em dash when the run used no seed.</summary>
        public string SeedLabel => Seed?.ToString() ?? "—";

        /// <summary>The resolution with its shape, e.g. "1280×720 (16:9)".</summary>
        public string ResolutionLabel => Aspect is null ? Resolution : $"{Resolution} ({Aspect})";

        /// <summary>Where it ran and at which tier, e.g. "RunPod · High".</summary>
        public string ProviderTier => string.Join(" · ", new[] { Provider, Tier }.Where(aPart => !string.IsNullOrEmpty(aPart))) is { Length: > 0 } vText ? vText : "—";

        /// <summary>The option label shown in the slot selects.</summary>
        public string OptionLabel => $"{Title} ({Model}{(Seed is null ? string.Empty : $" · seed {Seed}")})";

        /// <summary>The pane badges: model, tier · where it ran, seed, and a signed provenance mark.</summary>
        public List<PaneBadge> Badges
        {
            get
            {
                var vBadges = new List<PaneBadge> { new(Model, "badge-brand") };
                var vTierWhere = string.Join(" · ", new[] { Tier, Provider }.Where(aPart => !string.IsNullOrEmpty(aPart)));
                if (vTierWhere.Length > 0)
                {
                    vBadges.Add(new PaneBadge(vTierWhere, null));
                }

                if (Seed is not null)
                {
                    vBadges.Add(new PaneBadge($"seed {Seed}", null));
                }

                if (ProvenanceSigned)
                {
                    vBadges.Add(new PaneBadge("provenance ✓", "badge-ok"));
                }

                return vBadges;
            }
        }

        /// <summary>
        /// Projects a live owner-scoped asset into a compare pane: the run's own title, the model's
        /// display name and tier from the catalog, where it ran (from the generation log, else the
        /// model's provider) and its price.
        /// </summary>
        public static CompareAsset FromResponse(AssetResponse aAsset, string aArt, IReadOnlyDictionary<string, CatalogModelResponse> aModels)
        {
            var vKind = aAsset.Kind.ToLowerInvariant();
            var vParams = ReadParams(aAsset.ParamsJson);
            aModels.TryGetValue(aAsset.ModelId, out var vModel);
            var vOwnTitle = Text(vParams, "title");
            var vTitle = vOwnTitle ?? $"{char.ToUpperInvariant(vKind[0])}{vKind[1..]} · {aAsset.CreatedUtc:d MMM}";
            var vProvider = WhereLabel(aAsset.ProviderKind ?? vModel?.ProviderKind.ToString());
            var vLocal = vProvider is not null && vProvider.Contains("local", StringComparison.OrdinalIgnoreCase);
            var vCost = aAsset.ActualCost switch
            {
                null => "—",
                0m when vLocal => "$0.00 (local)",
                { } vPrice => $"${vPrice:0.00}"
            };
            var vSeconds = Number(vParams, "durationSeconds") ?? Number(vParams, "DurationSeconds");
            var vDims = aAsset is { Width: not null, Height: not null } ? $"{aAsset.Width}×{aAsset.Height}" : "—";
            return new CompareAsset(
                string.Empty, aAsset.AssetId.ToString(), aAsset.JobId, vKind, vTitle, vOwnTitle is not null,
                vModel?.DisplayName ?? aAsset.ModelId, vProvider, vModel?.Tier.ToString(), aAsset.SeedUsed,
                aAsset.ProvenanceSigned, vCost, aAsset.CreatedUtc, aAsset.CreatedUtc.ToString("d MMM yyyy"), vDims,
                AspectOf(aAsset.Width, aAsset.Height),
                vKind is "video" or "audio" && vSeconds is > 0 ? TimeSpan.FromSeconds(Math.Round(vSeconds.Value)).ToString(@"m\:ss") : null,
                aArt);
        }

        /// <summary>Where a run ran, in words: RunPod, Mac local (this host's own GPU), HeyGen, Venice, ….</summary>
        private static string? WhereLabel(string? aProviderKind) => aProviderKind switch
        {
            null or "" => null,
            nameof(TrStudio.Models.Enums.ProviderKind.ComfyUi) or nameof(TrStudio.Models.Enums.ProviderKind.OnnxLocal)
                => OperatingSystem.IsMacOS() ? "Mac local" : "local GPU",
            nameof(TrStudio.Models.Enums.ProviderKind.ClosedApi) => "closed API",
            _ => aProviderKind
        };

        private static Dictionary<string, JsonElement> ReadParams(string? aJson)
        {
            try
            {
                return string.IsNullOrWhiteSpace(aJson)
                    ? new()
                    : JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(aJson) ?? new();
            }
            catch (JsonException)
            {
                return new();
            }
        }

        private static string? Text(Dictionary<string, JsonElement> aParams, string aKey) =>
            aParams.TryGetValue(aKey, out var vValue) && vValue.ValueKind == JsonValueKind.String && !string.IsNullOrWhiteSpace(vValue.GetString())
                ? vValue.GetString()
                : null;

        private static double? Number(Dictionary<string, JsonElement> aParams, string aKey) =>
            aParams.TryGetValue(aKey, out var vValue) && vValue.ValueKind == JsonValueKind.Number ? vValue.GetDouble() : null;

        /// <summary>The picture's shape as a ratio ("16:9"), or null when its size is unknown.</summary>
        private static string? AspectOf(int? aWidth, int? aHeight)
        {
            if (aWidth is not > 0 || aHeight is not > 0)
            {
                return null;
            }

            static int Gcd(int aA, int aB) => aB == 0 ? aA : Gcd(aB, aA % aB);
            var vDivisor = Gcd(aWidth.Value, aHeight.Value);
            return $"{aWidth / vDivisor}:{aHeight / vDivisor}";
        }
    }

    /// <summary>A parameter-diff row: the parameter, both values, and whether they differ.</summary>
    private sealed record DiffRow(string Parameter, string ValueA, string ValueB, bool Differs)
    {
        /// <summary>Builds a diff row, flagging it as differing when the two values are unequal.</summary>
        public static DiffRow Of(string aParameter, string aValueA, string aValueB)
            => new(aParameter, aValueA, aValueB, !string.Equals(aValueA, aValueB, StringComparison.Ordinal));
    }
}
