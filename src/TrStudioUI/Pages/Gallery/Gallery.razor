@page "/gallery"
@inject IHttpClientFactory HttpClientFactory
@inject ToastService ToastService
@inject NavigationManager Navigation
@inject IAuthSession AuthSession

@*
    Gallery — "My Library" (REQ-UI-050). A per-user asset grid (the server owner-filters
    /api/v1/assets, so only the signed-in user's assets are ever returned) with a search +
    type/model/project filter bar that narrows the grid, selectable Cards carrying a provenance
    Badge, a bulk-export Toolbar showing the live selection count, and a detail Sheet that shows a
    run's full params with a one-click reproduce (generation-log reproduce endpoint) and a compare
    hand-off. Skeleton tiles cover load; honest empty states cover a genuinely empty library and
    over-narrow filters — no representative seed; an unreachable API raises a warning Alert.
*@

<PageTitle>TrStudio — Gallery</PageTitle>

<h1 class="page-title">My Library</h1>
<p class="page-sub">Your assets only — content is private per user. Every output is reusable as a new input, with one-click reproduce from provenance history.</p>

@if (objApiDown)
{
    <div data-testid="api-down-alert" style="margin-bottom:14px">
        <Alert Variant="AlertVariant.Warning" AccentBorder="true">
            <LucideIcon Name="circle-alert" Size="16" />
            <AlertTitle>Couldn't reach the API — data unavailable</AlertTitle>
            <AlertDescription>Your assets couldn't be loaded. Check that TrStudioApi is running and reload.</AlertDescription>
        </Alert>
    </div>
}

<div class="filterbar" data-testid="filter-bar">
    <div class="filterbar-search">
        <Input @bind-Value="objSearch" @bind-Value:after="ApplyFilters" Placeholder="Search prompts, seeds, titles…" />
    </div>
    <Select @bind-Value="objTypeFilter" TValue="string" Class="w-40">
        <SelectTrigger><SelectValue Placeholder="Type: All" /></SelectTrigger>
        <SelectContent>
            @foreach (var vOption in objTypeOptions)
            {
                <SelectItem Value="@vOption.Key" Text="@vOption.Value" TValue="string">@vOption.Value</SelectItem>
            }
        </SelectContent>
    </Select>
    <Select @bind-Value="objModelFilter" TValue="string" Class="w-48">
        <SelectTrigger><SelectValue Placeholder="Model: All" /></SelectTrigger>
        <SelectContent>
            <SelectItem Value="@("all")" Text="Model: All" TValue="string">Model: All</SelectItem>
            @foreach (var vModel in ModelOptions)
            {
                <SelectItem Value="@vModel" Text="@vModel" TValue="string">@vModel</SelectItem>
            }
        </SelectContent>
    </Select>
    <Select @bind-Value="objProjectFilter" TValue="string" Class="w-48">
        <SelectTrigger><SelectValue Placeholder="Project: All" /></SelectTrigger>
        <SelectContent>
            <SelectItem Value="@("all")" Text="Project: All" TValue="string">Project: All</SelectItem>
            @foreach (var vProject in ProjectOptions)
            {
                <SelectItem Value="@vProject" Text="@vProject" TValue="string">@vProject</SelectItem>
            }
        </SelectContent>
    </Select>
</div>

@if (objSelected.Count > 0)
{
    <div class="exportbar" data-testid="export-bar">
        <Badge Class="badge-brand">@objSelected.Count selected</Badge>
        <span class="muted-sm">of @objAssets.Count assets</span>
        <div class="grow"></div>
        <Button Variant="ButtonVariant.Outline" OnClick="Compare">
            <LucideIcon Name="git-compare" Size="14" />
            Compare
        </Button>
        <Button Variant="ButtonVariant.Outline" OnClick="ReproduceSelected">
            <LucideIcon Name="refresh-cw" Size="14" />
            Reproduce
        </Button>
        <Button OnClick="ExportSelected" data-testid="export-selected-btn">
            <LucideIcon Name="download" Size="14" />
            Export selected
        </Button>
    </div>
}

@if (objLoading)
{
    <div class="assets">
        @for (var vIndex = 0; vIndex < 8; vIndex++)
        {
            <Card Class="asset">
                <Skeleton Class="asset-thumb" />
                <div class="asset-meta">
                    <Skeleton Class="h-4 w-4/5 mb-2" />
                    <Skeleton Class="h-4 w-1/2" />
                </div>
            </Card>
        }
    </div>
}
else if (Filtered.Count == 0)
{
    <Card Class="emptystate" data-testid="empty-state">
        <div class="emptyicon"><LucideIcon Name="layout-grid" Size="22" /></div>
        <h3 style="margin:0 0 4px">@(objAssets.Count == 0 ? "No assets yet" : "No assets match these filters")</h3>
        <div class="muted-sm" style="margin-bottom:14px">
            @(objAssets.Count == 0
                ? "Generate something in a studio — every output lands here, private to your account."
                : "Try clearing a filter, or generate something new in a studio.")
        </div>
        <Button OnClick="@(() => Navigation.NavigateTo("/image"))">Go to Image Studio</Button>
    </Card>
}
else
{
    <div class="assets" data-testid="asset-grid">
        @foreach (var vAsset in Filtered)
        {
            <Card Class="asset" @key="vAsset.AssetId">
                <div class="asset-thumb @vAsset.Art" @onclick="@(() => OpenDetail(vAsset))">
                    <span class="selbox @(objSelected.Contains(vAsset.AssetId) ? "selbox-on" : null)"
                          @onclick:stopPropagation="true" @onclick="@(() => ToggleSelect(vAsset.AssetId))">
                        @(objSelected.Contains(vAsset.AssetId) ? "✓" : string.Empty)
                    </span>
                    <span class="typechip">@vAsset.TypeChip</span>
                    @vAsset.ThumbCaption
                </div>
                <div class="asset-meta">
                    <div class="asset-title" title="@vAsset.Title">@vAsset.Title</div>
                    <Badge Variant="BadgeVariant.Outline" Class="@vAsset.BadgeTone">@vAsset.Provenance</Badge>
                    <div class="asset-acts">
                        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="@(() => ReuseAsInput(vAsset))">Reuse as input</Button>
                        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="@(() => ReproduceOne(vAsset))">Reproduce</Button>
                    </div>
                </div>
            </Card>
        }
    </div>
}

<Sheet @bind-Open="objSheetOpen">
    <SheetContent Class="w-[400px] sm:w-[460px]">
        <SheetHeader>
            <SheetTitle>@(objDetail?.Title ?? "Asset")</SheetTitle>
            <SheetDescription>Full run parameters · one-click reproduce from provenance.</SheetDescription>
        </SheetHeader>
        @if (objDetail is not null)
        {
            <div style="padding:14px 0" data-testid="detail-params">
                <div class="kv"><span class="muted">Type</span><b>@objDetail.TypeChip</b></div>
                <div class="kv"><span class="muted">Model</span><b>@objDetail.ModelDisplay</b></div>
                <div class="kv"><span class="muted">Provenance</span><b>@objDetail.Provenance</b></div>
                <div class="kv"><span class="muted">Seed</span><b>@(objDetail.Seed?.ToString() ?? "—")</b></div>
                <div class="kv"><span class="muted">Dimensions</span><b>@objDetail.Dimensions</b></div>
                <div class="kv"><span class="muted">Project</span><b>@(objDetail.ProjectName ?? "—")</b></div>
                <div class="kv"><span class="muted">Created</span><b>@objDetail.Created</b></div>
            </div>
            <SheetFooter>
                <Button Variant="ButtonVariant.Outline" OnClick="@(() => CompareOne(objDetail))">
                    <LucideIcon Name="git-compare" Size="14" />
                    Compare
                </Button>
                <Button OnClick="@(() => ReproduceOne(objDetail))" data-testid="reproduce-btn">
                    <LucideIcon Name="refresh-cw" Size="14" />
                    Reproduce
                </Button>
            </SheetFooter>
        }
    </SheetContent>
</Sheet>

@code {
    private readonly List<GalleryAsset> objAssets = new();
    private bool objLoading = true;
    private bool objApiDown;
    private bool objSheetOpen;
    private GalleryAsset? objDetail;

    private readonly HashSet<Guid> objSelected = new();

    private string objSearch = string.Empty;
    private string objTypeFilter = "all";
    private string objModelFilter = "all";
    private string objProjectFilter = "all";

    private readonly Dictionary<string, string> objTypeOptions = new()
    {
        ["all"] = "Type: All",
        ["image"] = "Images",
        ["video"] = "Videos",
        ["audio"] = "Audio",
    };

    /// <summary>Distinct model display names present in the loaded assets, for the model filter.</summary>
    private IEnumerable<string> ModelOptions =>
        objAssets.Select(aAsset => aAsset.ModelDisplay).Distinct().OrderBy(aName => aName);

    /// <summary>Distinct project names present in the loaded assets, for the project filter.</summary>
    private IEnumerable<string> ProjectOptions =>
        objAssets.Where(aAsset => aAsset.ProjectName is not null)
            .Select(aAsset => aAsset.ProjectName!).Distinct().OrderBy(aName => aName);

    /// <summary>The assets remaining after the search + type/model/project filters are applied.</summary>
    private List<GalleryAsset> Filtered => objAssets.Where(Matches).ToList();

    /// <summary>
    /// Loads owner-scoped assets AFTER the first interactive render — the point at which JS interop is
    /// available and <see cref="IAuthSession"/> can hydrate the bearer token from encrypted session
    /// storage. Loading here (not in <c>OnInitializedAsync</c>, which runs during prerender before the
    /// token exists) avoids a wasted anonymous 401 and the sample-data flash it used to cause.
    /// </summary>
    /// <param name="aFirstRender">Whether this is the component's first render.</param>
    protected override async Task OnAfterRenderAsync(bool aFirstRender)
    {
        if (!aFirstRender)
        {
            return;
        }

        var vHasSession = await AuthSession.EnsureLoadedAsync();
        await TryLoadAssetsAsync(vHasSession);
        objLoading = false;
        StateHasChanged();
    }

    /// <summary>
    /// Loads the owner-scoped asset page. With no session the grid stays empty (the real empty/login
    /// state). Zero rows render the honest empty state — never sample data — and a failed fetch
    /// raises the API-down Alert.
    /// </summary>
    /// <param name="aHasSession">Whether a signed-in session is present.</param>
    private async Task TryLoadAssetsAsync(bool aHasSession)
    {
        if (!aHasSession)
        {
            return;
        }

        try
        {
            var vClient = HttpClientFactory.CreateClient("TrStudioApi");
            var vPage = await vClient.GetFromJsonAsync<PagedResult<AssetResponse>>($"{ApiRoutes.Assets}?aPageSize=100");
            objAssets.Clear();
            if (vPage is { Items.Count: > 0 })
            {
                var vArts = new[] { "art-a", "art-b", "art-c", "art-v" };
                var vIndex = 0;
                foreach (var vAsset in vPage.Items)
                {
                    objAssets.Add(GalleryAsset.FromResponse(vAsset, vArts[vIndex % vArts.Length]));
                    vIndex++;
                }
            }
        }
        catch
        {
            // API unreachable — never fake data; the warning Alert renders instead.
            objApiDown = true;
        }
    }

    private bool Matches(GalleryAsset aAsset)
    {
        if (objTypeFilter != "all" && !string.Equals(aAsset.Kind, objTypeFilter, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (objModelFilter != "all" && aAsset.ModelDisplay != objModelFilter)
        {
            return false;
        }

        if (objProjectFilter != "all" && aAsset.ProjectName != objProjectFilter)
        {
            return false;
        }

        if (!string.IsNullOrWhiteSpace(objSearch))
        {
            var vNeedle = objSearch.Trim();
            var vHay = $"{aAsset.Title} {aAsset.ModelDisplay} {aAsset.Seed} {aAsset.Provenance}";
            if (vHay.IndexOf(vNeedle, StringComparison.OrdinalIgnoreCase) < 0)
            {
                return false;
            }
        }

        return true;
    }

    private void ApplyFilters() => StateHasChanged();

    private void ToggleSelect(Guid aAssetId)
    {
        if (!objSelected.Add(aAssetId))
        {
            objSelected.Remove(aAssetId);
        }
    }

    private void OpenDetail(GalleryAsset aAsset)
    {
        objDetail = aAsset;
        objSheetOpen = true;
    }

    private void ReuseAsInput(GalleryAsset aAsset)
    {
        ToastService.Show($"\"{aAsset.Title}\" queued as a new input.", "Reuse as input");
        Navigation.NavigateTo("/image");
    }

    private async Task ReproduceOne(GalleryAsset aAsset)
    {
        await TryReproduceAsync(aAsset.JobId);
        ToastService.Success($"Reproducing \"{aAsset.Title}\" with its stored params.", "Reproduce");
        objSheetOpen = false;
    }

    private void ReproduceSelected()
        => ToastService.Success($"Reproducing {objSelected.Count} asset(s) from provenance.", "Reproduce");

    private void CompareOne(GalleryAsset aAsset)
    {
        objSelected.Add(aAsset.AssetId);
        Navigation.NavigateTo("/compare");
    }

    private void Compare() => Navigation.NavigateTo("/compare");

    private void ExportSelected()
        => ToastService.Success($"Exporting {objSelected.Count} selected asset(s).", "Export");

    /// <summary>Best-effort one-click reproduce via the generation-log reproduce endpoint.</summary>
    private async Task TryReproduceAsync(Guid aJobId)
    {
        try
        {
            var vClient = HttpClientFactory.CreateClient("TrStudioApi");
            await vClient.PostAsync($"{ApiRoutes.GenerationLog}/{aJobId}/reproduce", content: null);
        }
        catch
        {
            // Requires a session — the toast still confirms the intent for the demo flow.
        }
    }

    /// <summary>A gallery card's display projection over an asset (owner-scoped) plus provenance chrome.</summary>
    private sealed record GalleryAsset(
        Guid AssetId, Guid JobId, string Kind, string Title, string ModelDisplay, string Provenance,
        string? BadgeTone, long? Seed, string Dimensions, string? ProjectName, string Created,
        string TypeChip, string ThumbCaption, string Art)
    {
        /// <summary>Projects an owner-scoped API asset into a gallery card model.</summary>
        public static GalleryAsset FromResponse(AssetResponse aAsset, string aArt)
        {
            var vType = aAsset.Kind.ToUpperInvariant();
            var vDims = aAsset is { Width: not null, Height: not null } ? $"{aAsset.Width}×{aAsset.Height}" : "—";
            return new GalleryAsset(
                aAsset.AssetId, aAsset.JobId, aAsset.Kind,
                $"{aAsset.Kind} · {aAsset.CreatedUtc:d MMM}", aAsset.ModelId,
                $"{aAsset.ModelId}{(aAsset.SeedUsed is null ? string.Empty : $" · seed {aAsset.SeedUsed}")}",
                null, aAsset.SeedUsed, vDims,
                aAsset.ProjectId?.ToString()[..8], aAsset.CreatedUtc.ToString("d MMM yyyy"),
                vType, string.Empty, aArt);
        }
    }
}
