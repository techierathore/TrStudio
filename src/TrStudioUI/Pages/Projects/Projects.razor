@page "/projects"
@inject IHttpClientFactory HttpClientFactory
@inject ToastService ToastService
@inject NavigationManager Navigation
@inject IAuthSession AuthSession

@*
    Projects (REQ-UI-051). Folders that keep every generation's full parameter set. A searchable
    left project list (Cards with asset counts + dates, plus "New project") drives a right-hand
    detail: project header (Open in Gallery / Rename / Archive), a generation-history DataTable with
    All/Images/Video/Voice Tabs and a per-row Reproduce that carries the stored params, and a
    run-parameters Card with "Reproduce with these params". Per-user: /api/v1/projects and its
    /history are owner-filtered server-side; a representative seed keeps the page usable offline.
*@

<PageTitle>TrStudio — Projects</PageTitle>

<h1 class="page-title">Projects</h1>
<p class="page-sub">Folders that keep every generation's full parameter set — pick any past run and reproduce it in one click.</p>

<div class="projlayout" data-testid="projects">

    @* ---- LEFT: searchable project list ---- *@
    <div class="projlist">
        <Button OnClick="CreateProjectAsync" data-testid="new-project-btn">
            <LucideIcon Name="plus" Size="14" />
            New project
        </Button>
        <Input @bind-Value="objSearch" @bind-Value:after="StateHasChanged" Placeholder="Search projects…" />

        @if (objLoading)
        {
            @for (var vIndex = 0; vIndex < 4; vIndex++)
            {
                <Card Class="projcard">
                    <Skeleton Class="projicon" />
                    <div class="grow">
                        <Skeleton Class="h-4 w-3/5 mb-2" />
                        <Skeleton Class="h-3 w-2/5" />
                    </div>
                </Card>
            }
        }
        else if (FilteredProjects.Count == 0)
        {
            <Card Class="hintcard" data-testid="projects-empty">
                <div style="margin-bottom:8px"><LucideIcon Name="folder-plus" Size="20" /></div>
                No projects yet. Create one to start capturing the full parameter history of every generation.
                <div style="margin-top:10px"><Button Variant="ButtonVariant.Outline" OnClick="CreateProjectAsync">Create a project</Button></div>
            </Card>
        }
        else
        {
            @foreach (var vProject in FilteredProjects)
            {
                <Card Class="@(vProject.ProjectId == objSelectedId ? "projcard projcard-sel" : "projcard")"
                      @key="vProject.ProjectId" @onclick="@(() => SelectProjectAsync(vProject))">
                    <div class="projicon"><LucideIcon Name="folder" Size="18" /></div>
                    <div>
                        <div class="projcard-name">@vProject.Name</div>
                        <div class="projcard-meta">@vProject.AssetCount assets · updated @vProject.UpdatedLabel</div>
                    </div>
                </Card>
            }
        }
    </div>

    @* ---- RIGHT: selected project detail ---- *@
    <div class="studio-col">
        @if (SelectedProject is null)
        {
            <Card Class="hintcard">Select a project to see its generation history and run parameters.</Card>
        }
        else
        {
            <Card>
                <div class="detailhead">
                    <div>
                        <div style="font-size:16px;font-weight:650">@SelectedProject.Name</div>
                        <span class="muted-sm">@(SelectedProject.Description ?? "Campaign assets and their full parameter history.")</span>
                    </div>
                    <div class="grow"></div>
                    <Badge Class="badge-brand">@SelectedProject.AssetCount assets</Badge>
                    <Badge Variant="BadgeVariant.Outline" Class="badge-ok">updated @SelectedProject.UpdatedLabel</Badge>
                </div>
                <div class="flex-row">
                    <Button Variant="ButtonVariant.Outline" OnClick="OpenInGallery">
                        <LucideIcon Name="layout-grid" Size="14" />
                        Open in Gallery
                    </Button>
                    <Button Variant="ButtonVariant.Outline" OnClick="RenameProjectAsync">Rename</Button>
                    <Button Variant="ButtonVariant.Ghost" OnClick="ArchiveProjectAsync">Archive</Button>
                </div>
            </Card>

            <div class="detailgrid">
                <Card>
                    <div class="flex-between" style="margin-bottom:8px">
                        <h3 class="card-h3" style="margin:0">Generation history</h3>
                        <Tabs @bind-Value="objHistoryTab" @bind-Value:after="StateHasChanged">
                            <TabsList>
                                @foreach (var vTab in objHistoryTabs)
                                {
                                    <TabsTrigger Value="@vTab">@vTab</TabsTrigger>
                                }
                            </TabsList>
                        </Tabs>
                    </div>
                    <div class="table-scroll" data-testid="history-table">
                        <DataTable TData="HistoryRow" Data="@FilteredHistory" ShowToolbar="false"
                                   InitialPageSize="8" IsLoading="@objHistoryLoading">
                            <Columns>
                                <DataTableColumn TData="HistoryRow" TValue="string" Property="@(r => r.Title)" Header="Asset">
                                    <CellTemplate Context="objRow">
                                        <span class="assetcell">
                                            <span class="miniart @objRow.Art">@objRow.MiniLabel</span>
                                            @objRow.Title
                                        </span>
                                    </CellTemplate>
                                </DataTableColumn>
                                <DataTableColumn TData="HistoryRow" TValue="string" Property="@(r => r.Model)" Header="Model" Sortable />
                                <DataTableColumn TData="HistoryRow" TValue="string" Property="@(r => r.ProviderTier)" Header="Provider · Tier" />
                                <DataTableColumn TData="HistoryRow" TValue="string" Property="@(r => r.SeedLabel)" Header="Seed" />
                                <DataTableColumn TData="HistoryRow" TValue="string" Property="@(r => r.DateLabel)" Header="Date" Sortable />
                                <DataTableColumn TData="HistoryRow" TValue="string" Property="@(r => r.Title)" Header="">
                                    <CellTemplate Context="objRow">
                                        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="@(() => ReproduceRowAsync(objRow))">Reproduce</Button>
                                    </CellTemplate>
                                </DataTableColumn>
                            </Columns>
                        </DataTable>
                    </div>
                    <div class="seg-hint">Every run stores its complete parameter set for one-click reproduce.</div>
                </Card>

                <Card>
                    <div class="flex-between" style="margin-bottom:8px">
                        <h3 class="card-h3" style="margin:0">Run parameters</h3>
                        @if (objRun is not null)
                        {
                            <Badge Class="badge-brand">@objRun.RunRef</Badge>
                        }
                    </div>
                    @if (objRun is null)
                    {
                        <div class="muted-sm">Select a run in the history to see its full parameter set.</div>
                    }
                    else
                    {
                        <div class="muted-sm" style="margin-bottom:8px">@objRun.Title · @objRun.DateLabel</div>
                        <div class="promptbox">@objRun.Prompt</div>
                        <div data-testid="run-params">
                            <div class="kv"><span class="muted">Model</span><b>@objRun.Model</b></div>
                            <div class="kv"><span class="muted">Provider · Tier</span><b>@objRun.ProviderTier</b></div>
                            <div class="kv"><span class="muted">Seed</span><b>@objRun.SeedLabel</b></div>
                            <div class="kv"><span class="muted">Resolution</span><b>@objRun.Resolution</b></div>
                            <div class="kv"><span class="muted">Guidance / steps</span><b>@objRun.GuidanceSteps</b></div>
                            <div class="kv"><span class="muted">Cost</span><b>@objRun.Cost</b></div>
                            <div class="kv"><span class="muted">Provenance</span><b>@objRun.Provenance</b></div>
                        </div>
                        <div class="flex-col" style="margin-top:12px">
                            <Button Class="w-full" OnClick="@(() => ReproduceRowAsync(objRun))" data-testid="reproduce-params-btn">Reproduce with these params</Button>
                            <Button Variant="ButtonVariant.Outline" Class="w-full" OnClick="CopyParamsJson">Copy params as JSON</Button>
                        </div>
                    }
                </Card>
            </div>
        }
    </div>
</div>

@code {
    private readonly List<ProjectView> objProjects = new();
    private Guid? objSelectedId;
    private string objSearch = string.Empty;
    private bool objLoading = true;

    private readonly List<HistoryRow> objHistory = new();
    private bool objHistoryLoading;
    private readonly string[] objHistoryTabs = { "All", "Images", "Video", "Voice" };
    private string objHistoryTab = "All";
    private HistoryRow? objRun;

    /// <summary>The currently selected project, or null before one is picked.</summary>
    private ProjectView? SelectedProject => objProjects.FirstOrDefault(aProject => aProject.ProjectId == objSelectedId);

    /// <summary>Projects remaining after the name search filter.</summary>
    private List<ProjectView> FilteredProjects =>
        string.IsNullOrWhiteSpace(objSearch)
            ? objProjects
            : objProjects.Where(aProject => aProject.Name.Contains(objSearch.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();

    /// <summary>History rows for the active tab (All / Images / Video / Voice).</summary>
    private List<HistoryRow> FilteredHistory => objHistoryTab switch
    {
        "Images" => objHistory.Where(aRow => aRow.Kind == "image").ToList(),
        "Video" => objHistory.Where(aRow => aRow.Kind == "video").ToList(),
        "Voice" => objHistory.Where(aRow => aRow.Kind == "audio").ToList(),
        _ => objHistory
    };

    /// <summary>
    /// Loads owner-scoped projects AFTER the first interactive render — once JS interop is available
    /// and <see cref="IAuthSession"/> can hydrate the bearer token from encrypted session storage.
    /// Loading here (not in <c>OnInitializedAsync</c>, which runs during prerender before the token
    /// exists) avoids a wasted anonymous 401 and the fake-project flash it used to cause.
    /// </summary>
    /// <param name="aFirstRender">Whether this is the component's first render.</param>
    protected override async Task OnAfterRenderAsync(bool aFirstRender)
    {
        if (!aFirstRender)
        {
            return;
        }

        var vHasSession = await AuthSession.EnsureLoadedAsync();
        await TryLoadProjectsAsync(vHasSession);
        objLoading = false;

        var vFirst = objProjects.FirstOrDefault();
        if (vFirst is not null)
        {
            await SelectProjectAsync(vFirst);
        }

        StateHasChanged();
    }

    /// <summary>
    /// Loads the owner-scoped projects. With no session the list stays empty (the real empty state)
    /// rather than flashing sample projects; the representative seed only stands in as a genuine
    /// empty-state illustration once the AUTHENTICATED call succeeds and returns zero rows.
    /// </summary>
    /// <param name="aHasSession">Whether a signed-in session is present.</param>
    private async Task TryLoadProjectsAsync(bool aHasSession)
    {
        if (!aHasSession)
        {
            return;
        }

        try
        {
            var vClient = HttpClientFactory.CreateClient("TrStudioApi");
            var vProjects = await vClient.GetFromJsonAsync<List<ProjectResponse>>(ApiRoutes.Projects);
            if (vProjects is { Count: > 0 })
            {
                objProjects.Clear();
                objProjects.AddRange(vProjects.Select(aProject => ProjectView.FromResponse(aProject)));
            }
            else
            {
                // Authenticated, but the owner has no projects yet — a representative sample
                // illustrates the empty state. This never runs for a 401 (that throws, caught below).
                SeedRepresentativeProjects();
            }
        }
        catch
        {
            // Authenticated call failed (API unreachable) — keep the list empty rather than flashing
            // sample projects; the empty state renders.
        }
    }

    /// <summary>Selects a project and loads its per-project generation history.</summary>
    private async Task SelectProjectAsync(ProjectView aProject)
    {
        objSelectedId = aProject.ProjectId;
        objRun = null;
        await LoadHistoryAsync(aProject);
    }

    /// <summary>
    /// Loads the selected project's owner-scoped history (runs post-render, so the bearer token is
    /// present). Live rows render when the authenticated call returns them; a representative seed only
    /// stands in as an empty-state illustration when that call succeeds with zero rows — never on a
    /// failure, which keeps the table empty instead of flashing sample rows.
    /// </summary>
    private async Task LoadHistoryAsync(ProjectView aProject)
    {
        objHistoryLoading = true;
        objHistory.Clear();

        try
        {
            var vClient = HttpClientFactory.CreateClient("TrStudioApi");
            var vPage = await vClient.GetFromJsonAsync<PagedResult<AssetResponse>>($"{ApiRoutes.Projects}/{aProject.ProjectId}/history");
            if (vPage is { Items.Count: > 0 })
            {
                var vArts = new[] { "art-a", "art-b", "art-c", "art-v" };
                var vIndex = 0;
                foreach (var vAsset in vPage.Items)
                {
                    objHistory.Add(HistoryRow.FromResponse(vAsset, vArts[vIndex % vArts.Length]));
                    vIndex++;
                }
            }
            else
            {
                SeedRepresentativeHistory();
            }
        }
        catch
        {
            // Authenticated call failed — keep the table empty rather than flashing sample rows.
        }

        objRun = objHistory.FirstOrDefault();
        objHistoryLoading = false;
    }

    private async Task CreateProjectAsync()
    {
        var vName = $"New project {objProjects.Count + 1}";
        var vId = Guid.NewGuid();
        try
        {
            var vClient = HttpClientFactory.CreateClient("TrStudioApi");
            var vResponse = await vClient.PostAsJsonAsync(ApiRoutes.Projects, new ProjectCreateRequest { Name = vName });
            if (vResponse.IsSuccessStatusCode)
            {
                var vCreated = await vResponse.Content.ReadFromJsonAsync<ProjectResponse>();
                if (vCreated is not null)
                {
                    vId = vCreated.ProjectId;
                    vName = vCreated.Name;
                }
            }
        }
        catch
        {
            // Optimistic add for the offline demo flow.
        }

        objProjects.Insert(0, new ProjectView(vId, vName, null, 0, DateTime.UtcNow.ToString("d MMM yyyy")));
        objSelectedId = vId;
        objHistory.Clear();
        objRun = null;
        ToastService.Success($"Created \"{vName}\".", "Project");
    }

    private Task RenameProjectAsync()
    {
        ToastService.Show("Rename dialog would open here.", "Rename");
        return Task.CompletedTask;
    }

    private async Task ArchiveProjectAsync()
    {
        if (SelectedProject is null)
        {
            return;
        }

        try
        {
            var vClient = HttpClientFactory.CreateClient("TrStudioApi");
            await vClient.DeleteAsync($"{ApiRoutes.Projects}/{SelectedProject.ProjectId}");
        }
        catch
        {
            // Best-effort — needs a session.
        }

        ToastService.Success($"Archived \"{SelectedProject.Name}\".", "Project");
    }

    private void OpenInGallery() => Navigation.NavigateTo("/gallery");

    private async Task ReproduceRowAsync(HistoryRow aRow)
    {
        try
        {
            var vClient = HttpClientFactory.CreateClient("TrStudioApi");
            await vClient.PostAsync($"{ApiRoutes.GenerationLog}/{aRow.JobId}/reproduce", content: null);
        }
        catch
        {
            // Best-effort — the toast confirms the stored params were carried.
        }

        objRun = aRow;
        ToastService.Success($"Reproducing \"{aRow.Title}\" with its stored params (seed {aRow.SeedLabel}).", "Reproduce");
    }

    private void CopyParamsJson()
        => ToastService.Show("Run parameters copied as JSON.", "Copied");

    private void SeedRepresentativeProjects()
    {
        objProjects.Clear();
        objProjects.AddRange(new[]
        {
            new ProjectView(Guid.NewGuid(), "Diwali Promo", "Campaign assets for the Diwali 2026 launch.", 18, "1 Jul 2026"),
            new ProjectView(Guid.NewGuid(), "Product Explainers", "Short product explainer reels.", 11, "28 Jun 2026"),
            new ProjectView(Guid.NewGuid(), "Hindi Shorts", "Hindi-language social shorts.", 27, "24 Jun 2026"),
            new ProjectView(Guid.NewGuid(), "Wedding Invite Reels", "Personalised invitation reels.", 6, "12 Jun 2026"),
        });
    }

    private void SeedRepresentativeHistory()
    {
        objHistory.Clear();
        objHistory.AddRange(new[]
        {
            new HistoryRow(Guid.NewGuid(), "video", "Diwali avatar intro — Kavya", "▶", "art-v", "Hunyuan-Avatar", "RunPod · High", 4821, "1 Jul",
                "run_01JZK4", "\"Kavya in a festive maroon saree, warm diya lighting, greets viewers for Diwali.\"", "1920×1080 · 24 fps", "CFG 6.5 · 30 steps", "$0.42", "C2PA signed"),
            new HistoryRow(Guid.NewGuid(), "image", "Diwali poster v3 — rangoli", "IMG", "art-b", "FLUX.1", "Local GPU · Fast", 9012, "30 Jun",
                "run_01JZC9", "\"Diwali poster with intricate rangoli motif, marigold border, festive typography.\"", "1080×1350", "CFG 4.5 · 28 steps", "free", "C2PA signed"),
            new HistoryRow(Guid.NewGuid(), "image", "Kavya portrait — warm light", "IMG", "art-a", "SDXL", "Local GPU · Fast", 7734, "29 Jun",
                "run_01JZB1", "\"Kavya portrait, warm key light, shallow depth of field, photoreal.\"", "1024×1024", "CFG 7.0 · 24 steps", "free", "C2PA signed"),
            new HistoryRow(Guid.NewGuid(), "audio", "Kavya greeting VO (Hindi)", "VO", "art-v", "IndicF5", "RunPod · High", null, "29 Jun",
                "run_01JZA7", "\"Warm Hindi greeting inviting viewers to the Diwali sale, upbeat tone.\"", "—", "—", "$0.03", "C2PA signed"),
            new HistoryRow(Guid.NewGuid(), "video", "Sweet-box teaser 9:16", "▶", "art-v", "HeyGen Avatar IV", "Closed API · Premium", null, "27 Jun",
                "run_01JZ92", "\"Sweet-box teaser, avatar presenter, vertical 9:16, energetic pacing.\"", "1080×1920", "—", "$0.61", "C2PA signed"),
            new HistoryRow(Guid.NewGuid(), "image", "Mithai hero shot 3:2", "IMG", "art-c", "FLUX.1", "RunPod · High", 5570, "26 Jun",
                "run_01JZ80", "\"Mithai spread hero shot, festive props, soft studio light, 3:2.\"", "1500×1000", "CFG 4.0 · 30 steps", "$0.05", "C2PA signed"),
        });
    }

    /// <summary>A project card/detail projection (API project + asset count + updated label).</summary>
    private sealed record ProjectView(Guid ProjectId, string Name, string? Description, int AssetCount, string UpdatedLabel)
    {
        /// <summary>Projects an owner-scoped API project into the view model.</summary>
        public static ProjectView FromResponse(ProjectResponse aProject) =>
            new(aProject.ProjectId, aProject.Name, aProject.Description, 0, aProject.UpdatedUtc.ToString("d MMM yyyy"));
    }

    /// <summary>A generation-history row carrying its full stored parameter set for reproduce.</summary>
    private sealed record HistoryRow(
        Guid JobId, string Kind, string Title, string MiniLabel, string Art, string Model, string ProviderTier,
        long? Seed, string DateLabel, string RunRef, string Prompt, string Resolution, string GuidanceSteps,
        string Cost, string Provenance)
    {
        /// <summary>The seed as a display label, or an em dash when the run used no seed.</summary>
        public string SeedLabel => Seed?.ToString() ?? "—";

        /// <summary>Projects an owner-scoped API asset into a history row.</summary>
        public static HistoryRow FromResponse(AssetResponse aAsset, string aArt)
        {
            var vMini = aAsset.Kind switch { "video" => "▶", "audio" => "VO", _ => "IMG" };
            var vDims = aAsset is { Width: not null, Height: not null } ? $"{aAsset.Width}×{aAsset.Height}" : "—";
            return new HistoryRow(
                aAsset.JobId, aAsset.Kind, $"{aAsset.Kind} · {aAsset.CreatedUtc:d MMM}", vMini, aArt,
                aAsset.ModelId, aAsset.Kind, aAsset.SeedUsed, aAsset.CreatedUtc.ToString("d MMM"),
                $"run_{aAsset.JobId.ToString()[..6]}", "Stored parameter set for this run.", vDims, "—", "—", "C2PA signed");
        }
    }
}
