    /// <summary>A single result-strip tile carrying its reproduction seed and preview gradient.</summary>
    private sealed record ResultTile(long Seed, string Art, Guid? AssetId = null, bool FromVenice = false, string? PictureDataUrl = null);

    /// <summary>
    /// Reads the picture a job produced (<c>GET /api/v1/assets/{id}/content</c>, owner-filtered) and returns it as
    /// a data URL for the result tile (REQ-UI-086); <c>null</c> when it cannot be read, so the tile keeps its seed card.
    /// </summary>
    private static async Task<string?> LoadPictureDataUrlAsync(HttpClient aClient, Guid aAssetId)
    {
        try
        {
            using var vResponse = await aClient.GetAsync($"{ApiRoutes.Assets}/{aAssetId}/content");
            if (!vResponse.IsSuccessStatusCode)
            {
                return null;
            }

            var vType = vResponse.Content.Headers.ContentType?.MediaType ?? "image/png";
            if (!vType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
            {
                return null;
            }

            var vBytes = await vResponse.Content.ReadAsByteArrayAsync();
            return $"data:{vType};base64,{Convert.ToBase64String(vBytes)}";
        }
        catch (HttpRequestException)
        {
            return null;
        }
    }

