@page "/setup-required"
@layout TrStudioUI.Layout.EmptyLayout
@inject NavigationManager Navigation
@inject IHttpClientFactory HttpClientFactory
@inject ToastService ToastService

@*
    First-run gate (REQ-UI-004, BRD-85). Shown to creators when no model source/model is
    configured yet. "Sign in as admin" routes to /login; "Check again" re-evaluates the
    setup gate and forwards to the studio once setup completes, otherwise keeps waiting.
    No sidebar — rendered on the bare EmptyLayout.
*@

<PageTitle>TrStudio — Setup required</PageTitle>

<Card Class="gate-card" data-testid="gate-card">
  <div data-testid="card-trstudio-isn-t-set-up-yet">
    <div class="gate-logo shell-logo brand-gradient">TR</div>

    <div class="gate-illus brand-gradient">
        <span class="gate-ghost"><LucideIcon Name="user" Size="26" /></span>
        <LucideIcon Name="pencil" Size="30" />
        <LucideIcon Name="video" Size="30" />
    </div>

    <Badge Variant="BadgeVariant.Outline" Class="mb-3 badge-warn" data-testid="badge-status">
        <span class="dot warn"></span> Waiting for admin setup
    </Badge>
    <h1 class="gate-headline">TrStudio isn't set up yet</h1>
    <p class="gate-copy">
        No model sources or models are configured on this install, so the studios can't generate
        anything yet. Ask your admin to complete setup in the management surface — or sign in with an
        admin account to do it yourself.
    </p>

    @* Phase 3 (REQ-UI-101, REQ-UI-102): where this user's data lives, and why it is not ready when it is not. *@
    <div class="gate-steps" data-testid="card-local-data">
        <div class="gate-cap">Your data on this computer</div>
        @if (objDataFolder is not null)
        {
            <div class="gate-step" style="font-family:ui-monospace,Menlo,monospace;font-size:12px;word-break:break-all" data-testid="data-folder">@objDataFolder</div>
        }
        @if (objStoreProblem is not null)
        {
            <div class="gate-step" style="color:var(--destructive)" data-testid="data-store-problem">@objStoreProblem</div>
        }
        else if (objDataFolder is not null)
        {
            <div class="gate-step" data-testid="data-store-status">
                <Badge Variant="BadgeVariant.Outline" Class="badge-ok" data-testid="badge-store-ready">
                    <span class="dot ok"></span> Local library ready
                </Badge>
            </div>
        }
    </div>

    <div class="gate-btns">
        <span data-testid="link-sign-in-as-admin" style="display:inline-flex">
        <Button Href="/login" data-testid="signin-admin">
            <LucideIcon Name="log-in" Size="14" />
            Sign in as admin
        </Button>
        </span>
        <span data-testid="btn-check-again" style="display:inline-flex">
        <Button Variant="ButtonVariant.Outline" OnClick="CheckAgainAsync"
                Disabled="@objBusy" data-testid="check-again">
            @if (objBusy)
            {
                <Spinner Size="SpinnerSize.Small" Class="mr-2" />
                <span>Checking…</span>
            }
            else
            {
                <LucideIcon Name="refresh-cw" Size="14" />
                <span>Check again</span>
            }
        </Button>
        </span>
    </div>

    <div class="gate-steps">
        <div class="gate-cap">What your admin will do</div>
        <div class="gate-step">
            <span class="gate-step-n">1</span>
            Enable a model source (local GPU, RunPod or a closed API) on Registry &amp; providers, with its key.
        </div>
        <div class="gate-step">
            <span class="gate-step-n">2</span>
            Install or connect at least one model on that source.
        </div>
        <div class="gate-step">
            <span class="gate-step-n">3</span>
            The model appears as a registry row — studios unlock automatically for creators.
        </div>
    </div>
  </div>
</Card>

@code {
    private bool objBusy;
    private string? objDataFolder;
    private string? objStoreProblem;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var vClient = HttpClientFactory.CreateClient("TrStudioApi");
            var vResponse = await vClient.GetAsync("/api/v1/local-store");
            if (vResponse.IsSuccessStatusCode)
            {
                var vStore = await vResponse.Content.ReadFromJsonAsync<LocalStoreLike>();
                objDataFolder = vStore?.DataFolder;
            }
            else if (vResponse.StatusCode == System.Net.HttpStatusCode.ServiceUnavailable)
            {
                var vProblem = await vResponse.Content.ReadFromJsonAsync<ProblemLike>();
                objStoreProblem = vProblem?.Detail ?? "TrStudio could not prepare its library on this computer.";
            }
        }
        catch
        {
            // A host without the local-store route shows the plain first-run gate.
        }
    }

    private sealed class LocalStoreLike
    {
        public string? DataFolder { get; set; }
    }

    private sealed class ProblemLike
    {
        public string? Detail { get; set; }
    }

    /// <summary>Re-evaluates the setup gate and forwards to the studio once setup completes.</summary>
    private async Task CheckAgainAsync()
    {
        objBusy = true;
        try
        {
            var vClient = HttpClientFactory.CreateClient("TrStudioApi");
            var vResponse = await vClient.GetAsync(ApiRoutes.SetupGate);
            if (vResponse.IsSuccessStatusCode)
            {
                var vGate = await vResponse.Content.ReadFromJsonAsync<SetupGateResponse>();
                if (vGate is not null && vGate.SetupComplete)
                {
                    var vTarget = string.IsNullOrWhiteSpace(vGate.RedirectPath) ? "/avatar" : vGate.RedirectPath;
                    Navigation.NavigateTo(vTarget, forceLoad: true);
                    return;
                }
            }

            ToastService.Show("Still waiting — no model is ready on this install yet.", "Setup incomplete");
        }
        catch
        {
            ToastService.Error("Couldn't reach the setup service. Try again shortly.", "Check failed");
        }
        finally
        {
            objBusy = false;
        }
    }
}
