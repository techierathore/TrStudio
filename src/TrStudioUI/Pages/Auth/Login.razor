@page "/login"
@layout TrStudioUI.Layout.EmptyLayout
@inject NavigationManager Navigation
@inject IHttpClientFactory HttpClientFactory
@inject IAuthSession AuthSession
@inject ToastService ToastService

@*
    Sign-in screen (REQ-UI-001) — centered brand card on the bare EmptyLayout.
    Validates email/password client-side (submit stays disabled until valid), posts to
    the AppManager-backed /api/v1/auth/login, surfaces auth failures in a Danger Alert
    and routes to the setup-gate-aware role landing on success (BRD-84). "Remember me" (owner
    decision 6B, BRD-153 to BRD-157) keeps the sign-in on this computer for 30 days; on open, a kept
    sign-in is used without asking.
*@

<PageTitle>TrStudio — Sign in</PageTitle>

<Card Class="auth-card" data-testid="card-1">
    <div class="auth-brand">
        <div class="auth-brand-art" data-testid="img-trstudio-logo">
            <img class="brand-logo-light" src="_content/TrStudioUI/brand/TrStudio-horizontal.svg" alt="TrStudio" />
            <span class="brand-logo-dark"><img class="brand-logo-tile" src="_content/TrStudioUI/brand/TrStudio-appicon.svg" alt="" /><img class="brand-logo-word" src="_content/TrStudioUI/brand/TrStudio-wordmark-white.png" alt="TrStudio" /></span>
        </div>
        <div>
            <h1 class="auth-brand-name">Welcome back to TrStudio</h1>
            <div class="auth-brand-tag">Avatar-led AI image &amp; video studio</div>
        </div>
    </div>

    @if (objMissingSettings is not null)
    {
        @* Phase 3 (REQ-UI-098): this build carries no AppManager id or key. *@
        <div data-testid="alert-missing-sign-in-settings">
            <Alert Variant="AlertVariant.Warning" AccentBorder="true" Class="mb-4">
                <LucideIcon Name="triangle-alert" Size="16" />
                <AlertTitle>Sign-in is not set up in this copy</AlertTitle>
                <AlertDescription>@objMissingSettings</AlertDescription>
            </Alert>
        </div>
    }

    @if (objUnreachable is not null)
    {
        @* Phase 3 (REQ-UI-099): AppManager cannot be reached; the user stays on Login. *@
        <div data-testid="alert-sign-in-unreachable">
            <Alert Variant="AlertVariant.Danger" AccentBorder="true" Class="mb-4">
                <LucideIcon Name="wifi-off" Size="16" />
                <AlertTitle>Sign-in service unreachable</AlertTitle>
                <AlertDescription>@objUnreachable</AlertDescription>
            </Alert>
        </div>
    }

    @if (objKeptEnded is not null)
    {
        @* Owner decision 6B (REQ-FN-101): a kept sign-in ended (30 days, or refused by AppManager). *@
        <div data-testid="alert-kept-sign-in-ended">
            <Alert Variant="AlertVariant.Info" AccentBorder="true" Class="mb-4">
                <LucideIcon Name="clock" Size="16" />
                <AlertTitle>Please sign in again</AlertTitle>
                <AlertDescription>@objKeptEnded</AlertDescription>
            </Alert>
        </div>
    }

    @if (objError is not null)
    {
        <div data-testid="login-error">
            <Alert Variant="AlertVariant.Danger" AccentBorder="true" Class="mb-4">
                <LucideIcon Name="circle-alert" Size="16" />
                <AlertTitle>Sign-in failed</AlertTitle>
                <AlertDescription>@objError</AlertDescription>
            </Alert>
        </div>
    }

    <div class="auth-field">
        <Field IsInvalid="@(objSubmitted && !IsEmailValid)">
            <FieldLabel>
                <Label For="email">Email</Label>
            </FieldLabel>
            <FieldContent>
                <Input Id="email" Type="InputType.Email" @bind-Value="objEmail"
                       Placeholder="you@studio.com" AriaInvalid="@(objSubmitted && !IsEmailValid)" data-testid="field-email" />
                @if (objSubmitted && !IsEmailValid)
                {
                    <FieldError>Enter a valid email address.</FieldError>
                }
            </FieldContent>
        </Field>
    </div>

    <div class="auth-field">
        <div class="auth-fieldrow">
            <Label For="pwd">Password</Label>
            <a class="auth-link" href="/forgot-password" data-testid="link-forgot-password">Forgot password?</a>
        </div>
        <Field IsInvalid="@(objSubmitted && !IsPasswordValid)">
            <FieldContent>
                <Input Id="pwd" Type="InputType.Password" @bind-Value="objPassword" Placeholder="••••••••" data-testid="field-pwd" />
                @if (objSubmitted && !IsPasswordValid)
                {
                    <FieldError>Password is required.</FieldError>
                }
            </FieldContent>
        </Field>
    </div>

    @* Owner decision 6B (REQ-FN-099): ticked keeps this sign-in on this computer for 30 days. *@
    <div class="auth-remember" data-testid="remember-me-row">
        <Checkbox @bind-Checked="objRememberMe" Id="remember-me" data-testid="remember-me" />
        <Label For="remember-me">Remember me on this computer for 30 days</Label>
    </div>

    @* The mockup's `sign-in` is the button itself (a wrapper here measured as the card's colour). *@
    <Button Class="auth-submit" Type="ButtonType.Submit" OnClick="HandleSignInAsync"
            Disabled="@(objBusy || !IsFormValid || objMissingSettings is not null)" data-testid="sign-in">
        @if (objBusy)
        {
            <Spinner Size="SpinnerSize.Small" Class="mr-2" />
            <span>Signing in…</span>
        }
        else
        {
            <LucideIcon Name="log-in" Size="14" />
            <span>Sign in</span>
        }
    </Button>

    <div class="auth-divline">AppManager</div>
    <div class="auth-note">
        Your identity and license are managed by AppManager. TrStudio never stores your password —
        only your AppManager userId.
    </div>
    <div class="auth-note" data-testid="note-local-data">
        Your work stays on this computer, in your own TrStudio folder. Nothing to install or configure.
    </div>

    <div class="auth-switch" style="margin-top:6px">Workspace not set up yet? <a href="/setup-required" data-testid="setup-required-link">See the setup gate</a></div>
    <div class="auth-switch">New to TrStudio? <a href="/register" data-testid="link-create-an-account">Create an account</a></div>
</Card>

@code {
    private string objEmail = string.Empty;
    private string objPassword = string.Empty;
    private bool objSubmitted;
    private bool objBusy;
    private string? objError;
    private string? objMissingSettings;
    private string? objUnreachable;
    private string? objKeptEnded;
    private bool objRememberMe;

    protected override async Task OnInitializedAsync()
    {
        // Phase 3: the engine runs in this app. If its local library could not be prepared, Setup
        // required says why (REQ-UI-102); if the build has no sign-in settings, say so (REQ-UI-098).
        try
        {
            var vClient = HttpClientFactory.CreateClient("TrStudioApi");
            var vStore = await vClient.GetAsync("/api/v1/local-store");
            if (vStore.StatusCode == System.Net.HttpStatusCode.ServiceUnavailable)
            {
                Navigation.NavigateTo("/setup-required");
                return;
            }

            var vSettings = await vClient.GetFromJsonAsync<SignInSettingsLike>(ApiRoutes.Auth + "/sign-in-settings");
            if (vSettings is { Configured: false })
            {
                objMissingSettings = vSettings.Message;
            }
        }
        catch
        {
            // A host without these routes keeps the plain sign-in form.
        }
    }

    /// <summary>
    /// Owner decision 6B (REQ-FN-100, REQ-FN-101): a sign-in kept with "Remember me" opens the app
    /// without asking. Runs once, after the first live render: a pre-rendered pass must not use up the
    /// kept token or show a notice the live pass then loses.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool aFirstRender)
    {
        if (!aFirstRender || objMissingSettings is not null)
        {
            return;
        }

        try
        {
            var vClient = HttpClientFactory.CreateClient("TrStudioApi");
            var vResume = await vClient.PostAsync(ApiRoutes.Auth + "/resume", null);
            if (vResume.StatusCode == System.Net.HttpStatusCode.OK)
            {
                var vResumed = await vResume.Content.ReadFromJsonAsync<ResumedLike>();
                if (vResumed?.Session is not null)
                {
                    await AuthSession.SetAsync(vResumed.Session, vResumed.Email);
                    Navigation.NavigateTo(ResolveLanding(vResumed.Session));
                    return;
                }
            }
            else if (vResume.StatusCode != System.Net.HttpStatusCode.NoContent)
            {
                var (vTitle, vMessage) = await ReadErrorAsync(vResume);
                if (vTitle == "SIGN_IN_ENDED")
                {
                    objKeptEnded = vMessage;
                }
                else if (vTitle == "SIGN_IN_UNREACHABLE")
                {
                    objUnreachable = vMessage;
                }

                StateHasChanged();
            }
        }
        catch
        {
            // A host without the route keeps the plain sign-in form.
        }
    }

    /// <summary>Whether the email field holds a syntactically valid address.</summary>
    private bool IsEmailValid =>
        !string.IsNullOrWhiteSpace(objEmail)
        && objEmail.Contains('@', StringComparison.Ordinal)
        && objEmail.IndexOf('.', objEmail.IndexOf('@', StringComparison.Ordinal)) > 0;

    /// <summary>Whether a password has been entered.</summary>
    private bool IsPasswordValid => !string.IsNullOrWhiteSpace(objPassword);

    /// <summary>Whether the whole form is valid and submittable.</summary>
    private bool IsFormValid => IsEmailValid && IsPasswordValid;

    /// <summary>Validates, posts the login and routes to the role landing on success.</summary>
    private async Task HandleSignInAsync()
    {
        objSubmitted = true;
        objError = null;
        objUnreachable = null;
        objKeptEnded = null;
        if (!IsFormValid)
        {
            return;
        }

        objBusy = true;
        try
        {
            var vClient = HttpClientFactory.CreateClient("TrStudioApi");
            var vRequest = new LoginRequest { Email = objEmail, Password = objPassword, RememberMe = objRememberMe };
            var vResponse = await vClient.PostAsJsonAsync(ApiRoutes.Auth + "/login", vRequest);

            if (vResponse.IsSuccessStatusCode)
            {
                var vSession = await vResponse.Content.ReadFromJsonAsync<LoginResponse>();
                if (vSession is not null)
                {
                    // Persist the session BEFORE navigating so the next circuit's API calls carry it.
                    await AuthSession.SetAsync(vSession, objEmail);
                }

                Navigation.NavigateTo(ResolveLanding(vSession));
                if (!string.IsNullOrWhiteSpace(vSession?.NotKeptReason))
                {
                    // Owner run 16 Nov 2026: "Remember me" could not be kept (an unsigned Mac build); say why
                    // once the signed-in shell, which holds the toast area, has drawn.
                    await Task.Delay(800);
                    ToastService.Show(vSession.NotKeptReason, "Signed in, not remembered");
                }

                return;
            }

            var (vTitle, vMessage) = await ReadErrorAsync(vResponse);
            if (vTitle == "SIGN_IN_UNREACHABLE")
            {
                objUnreachable = vMessage;
            }
            else if (vTitle == "SIGN_IN_NOT_CONFIGURED")
            {
                objMissingSettings = vMessage;
            }
            else
            {
                objError = vMessage;
            }
        }
        catch (Exception vException)
        {
            objError = $"Could not reach the sign-in service. {vException.Message}";
        }
        finally
        {
            objBusy = false;
        }
    }

    /// <summary>Resolves the post-login landing path from the session (setup-gate aware).</summary>
    private static string ResolveLanding(LoginResponse? aSession)
    {
        if (aSession is null)
        {
            return "/avatar";
        }

        if (!string.IsNullOrWhiteSpace(aSession.DefaultLandingPath))
        {
            return aSession.DefaultLandingPath;
        }

        return aSession.Role == UserRole.Operator ? "/admin/ops" : "/avatar";
    }

    /// <summary>Extracts a human-readable message from an API ProblemDetails response.</summary>
    private static async Task<(string? Title, string Message)> ReadErrorAsync(HttpResponseMessage aResponse)
    {
        try
        {
            var vProblem = await aResponse.Content.ReadFromJsonAsync<ProblemLike>();
            if (!string.IsNullOrWhiteSpace(vProblem?.Detail))
            {
                return (vProblem.Title, vProblem.Detail!);
            }
        }
        catch
        {
            // Non-JSON body — fall through to a generic message.
        }

        return (null, aResponse.StatusCode == System.Net.HttpStatusCode.Unauthorized
            ? "Invalid email or password."
            : "Sign-in failed. Please try again.");
    }

    private sealed class SignInSettingsLike
    {
        public bool Configured { get; set; }
        public string? Message { get; set; }
    }

    private sealed class ResumedLike
    {
        public LoginResponse? Session { get; set; }
        public string? Email { get; set; }
    }

    private sealed class ProblemLike
    {
        public string? Title { get; set; }
        public string? Detail { get; set; }
    }
}
