@page "/forgot-password"
@layout TrStudioUI.Layout.EmptyLayout
@inject IHttpClientFactory HttpClientFactory

@*
    Reset-password screen (REQ-UI-003). Email + "Send reset link"; the AppManager reset is
    intentionally enumeration-safe, so on success we always show the same generic confirmation
    (Success Alert). Submit stays disabled until a valid email is entered. No local password store.
*@

<PageTitle>TrStudio — Reset password</PageTitle>

<Card Class="auth-card" data-testid="forgot-card">
    <div class="auth-brand">
        <div class="auth-brand-logo shell-logo brand-gradient">TR</div>
        <div>
            <h1 class="auth-brand-name">Reset your password</h1>
            <div class="auth-brand-tag">We'll email you a secure reset link</div>
        </div>
    </div>

    <div class="auth-field">
        <Field IsInvalid="@(objSubmitted && !IsEmailValid)">
            <FieldLabel><Label For="email">Email</Label></FieldLabel>
            <FieldContent>
                <Input Id="email" Type="InputType.Email" @bind-Value="objEmail" Placeholder="you@studio.com" />
                @if (objSubmitted && !IsEmailValid)
                {
                    <FieldError>Enter a valid email address.</FieldError>
                }
            </FieldContent>
        </Field>
    </div>

    <Button Class="auth-submit" Type="ButtonType.Submit" OnClick="HandleSendAsync"
            Disabled="@(objBusy || !IsEmailValid)" data-testid="send-btn">
        @if (objBusy)
        {
            <Spinner Size="SpinnerSize.Small" Class="mr-2" />
            <span>Sending…</span>
        }
        else
        {
            <LucideIcon Name="mail" Size="14" />
            <span>Send reset link</span>
        }
    </Button>

    @if (objSent)
    {
        <div data-testid="forgot-success">
            <Alert Variant="AlertVariant.Success" Class="mt-4">
                <LucideIcon Name="check-circle" Size="16" />
                <AlertDescription>
                    If an account exists for this email, the reset link arrives within a few minutes —
                    check spam if you don't see it.
                </AlertDescription>
            </Alert>
        </div>
    }

    <div class="auth-divline">AppManager</div>
    <div class="auth-note">
        Password resets are handled by AppManager — TrStudio never stores your password, only your
        AppManager userId.
    </div>

    <div class="auth-switch"><a href="/login">← Back to sign in</a></div>
</Card>

@code {
    private string objEmail = string.Empty;
    private bool objSubmitted;
    private bool objBusy;
    private bool objSent;

    private bool IsEmailValid =>
        !string.IsNullOrWhiteSpace(objEmail)
        && objEmail.Contains('@', StringComparison.Ordinal)
        && objEmail.IndexOf('.', objEmail.IndexOf('@', StringComparison.Ordinal)) > 0;

    /// <summary>Requests a reset link; always shows the generic success message (enumeration-safe).</summary>
    private async Task HandleSendAsync()
    {
        objSubmitted = true;
        if (!IsEmailValid)
        {
            return;
        }

        objBusy = true;
        try
        {
            var vClient = HttpClientFactory.CreateClient("TrStudioApi");
            var vRequest = new ForgotPasswordRequest { Email = objEmail };
            await vClient.PostAsJsonAsync(ApiRoutes.Auth + "/forgot-password", vRequest);
        }
        catch
        {
            // Enumeration-safe: never reveal transport/account errors to the caller.
        }
        finally
        {
            objBusy = false;
            objSent = true;
        }
    }
}
