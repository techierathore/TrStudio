@page "/admin/setup/hardware"
@page "/admin/setup"
@inject IHttpClientFactory HttpClientFactory
@inject ToastService ToastService
@inject IAuthSession AuthSession

@*
    Admin Hardware & guided setup (REQ-UI-070). Readiness summary cards (GPU / memory /
    MPS-CoreML / disk) with ready/warn Badges, a guided-setup stepper (ONNX, MuseTalk,
    isolated Python + ComfyUI, network volume) with live Progress, and a low-disk Warning
    Alert linking to the Model Library. Consumes the capabilities + setup endpoints, with a
    representative fallback while those admin endpoints are being wired.
*@

<PageTitle>TrStudio — Hardware &amp; Setup</PageTitle>

<div class="stack" style="max-width:1100px">
    <div>
        <h1 class="page-title">Hardware &amp; Setup</h1>
        <p class="page-sub" style="margin-bottom:0">
            Detected capabilities on this node and guided environment provisioning — isolated from
            system Python.
        </p>
    </div>

    @if (objCapabilitiesLoading)
    {
        <div class="kpi-grid">
            @for (var vIndex = 0; vIndex < 4; vIndex++)
            {
                <Card>
                    <CardContent Class="pt-6">
                        <Skeleton Class="h-4 w-1/2 mb-3" />
                        <Skeleton Class="h-6 w-2/3 mb-2" />
                        <Skeleton Class="h-3 w-4/5" />
                    </CardContent>
                </Card>
            }
        </div>
    }
    else if (objCapabilityCards.Count > 0)
    {
        <div class="kpi-grid" data-testid="capability-cards">
            @foreach (var vCard in objCapabilityCards)
            {
                <Card>
                    <CardContent Class="pt-6">
                        <div class="flex-between">
                            <span class="kpi-lbl">@vCard.Label</span>
                            <Badge Variant="BadgeVariant.Outline" Class="@(vCard.Warn ? "badge-warn" : "badge-ok")">
                                @(vCard.Warn ? "low" : "ready")
                            </Badge>
                        </div>
                        <div class="kpi-big">@vCard.Value</div>
                        @if (vCard.Progress is not null)
                        {
                            <Progress Value="@vCard.Progress.Value" Class="h-2" />
                        }
                        <div class="kpi-lbl">@vCard.Detail</div>
                    </CardContent>
                </Card>
            }
        </div>
    }
    else
    {
        <Card data-testid="capabilities-unavailable">
            <CardContent Class="pt-6">
                <div class="kpi-lbl">
                    Host capabilities are unavailable — sign in as an administrator to detect this
                    node's GPU, memory and disk. No sample hardware is shown.
                </div>
            </CardContent>
        </Card>
    }

    <Card>
        <CardContent Class="pt-6">
            <div class="flex-between">
                <h3 class="setup-step-title" style="font-size:14px">Guided setup</h3>
                <span data-testid="setup-progress">
                    <Badge Variant="BadgeVariant.Outline" Class="badge-brand">
                        @objCompletedSteps of @objSteps.Count complete
                    </Badge>
                </span>
            </div>
            <p class="kpi-lbl" style="margin:6px 0 4px">
                Provisions an isolated environment — never collides with system Python.
            </p>

            @foreach (var vStep in objSteps)
            {
                <div class="setup-step">
                    <div class="setup-stepdot @vStep.DotClass">@vStep.DotLabel</div>
                    <div class="setup-step-body">
                        <div class="setup-step-title">@vStep.Title</div>
                        <div class="kpi-lbl" style="margin-bottom:@(vStep.Progress is null ? "0" : "6px")">@vStep.Detail</div>
                        @if (vStep.Progress is not null)
                        {
                            <Progress Value="@vStep.Progress.Value" />
                            <div class="kpi-lbl" style="margin-top:4px">@vStep.Progress.Value.ToString("0") % · resolving dependencies</div>
                        }
                    </div>
                    @if (vStep.Disabled)
                    {
                        <Button Disabled="true">Start</Button>
                    }
                    else
                    {
                        <Button Variant="ButtonVariant.Outline" OnClick="@(() => RunStepAsync(vStep))">@vStep.ActionLabel</Button>
                    }
                </div>
            }
        </CardContent>
    </Card>

    <div data-testid="low-disk-alert">
        <Alert Variant="AlertVariant.Warning" AccentBorder="true">
            <LucideIcon Name="alert-triangle" Size="16" />
            <AlertTitle>Disk space low</AlertTitle>
            <AlertDescription>
                The 24 GB Hunyuan-Avatar checkpoint exceeds local free space — attach a network volume
                before installing from the <a href="/admin/models">Model Library</a>.
            </AlertDescription>
        </Alert>
    </div>
</div>

@code {
    private List<CapabilityCard> objCapabilityCards = new();
    private List<SetupStepRow> objSteps = new();
    private bool objCapabilitiesLoading = true;

    private int objCompletedSteps => objSteps.Count(aStep => aStep.DotClass == "done");

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        // The guided-setup stepper is static provisioning scaffolding (no host detection), so it is
        // safe to render immediately. The capability cards are host-specific and must NOT be seeded
        // with sample hardware — they load from the authenticated report after the first render.
        SeedSteps();
    }

    /// <summary>
    /// Detects host capabilities AFTER the first interactive render — once JS interop is available and
    /// <see cref="IAuthSession"/> can hydrate the bearer token. Reporting only real, authenticated
    /// data (never a sample Mac profile on a non-Mac host) means the cards never misrepresent the node.
    /// </summary>
    /// <param name="aFirstRender">Whether this is the component's first render.</param>
    protected override async Task OnAfterRenderAsync(bool aFirstRender)
    {
        if (!aFirstRender)
        {
            return;
        }

        var vHasSession = await AuthSession.EnsureLoadedAsync();
        await TryLoadCapabilitiesAsync(vHasSession);
        await TryLoadSetupAsync(vHasSession);
        objCapabilitiesLoading = false;
        StateHasChanged();
    }

    /// <summary>
    /// Loads the live host-capability report. With no session, or when the endpoint is unreachable,
    /// the cards stay empty and an "unavailable" note renders — never a sample hardware profile.
    /// </summary>
    /// <param name="aHasSession">Whether a signed-in session is present.</param>
    private async Task TryLoadCapabilitiesAsync(bool aHasSession)
    {
        if (!aHasSession)
        {
            return;
        }

        try
        {
            var vClient = HttpClientFactory.CreateClient("TrStudioApi");
            var vResponse = await vClient.GetAsync(ApiRoutes.Capabilities);
            if (!vResponse.IsSuccessStatusCode)
            {
                return;
            }

            var vReport = await vResponse.Content.ReadFromJsonAsync<HostCapabilityReport>();
            if (vReport is not null)
            {
                ApplyReport(vReport);
            }
        }
        catch
        {
            // Endpoint not reachable / unauthenticated — keep the cards empty (the unavailable note
            // renders) rather than showing a sample hardware profile.
        }
    }

    /// <summary>Maps a live capability report onto the readiness cards.</summary>
    private void ApplyReport(HostCapabilityReport aReport)
    {
        var vDiskUsedPct = aReport.TotalDiskGb > 0
            ? (aReport.TotalDiskGb - aReport.FreeDiskGb) / aReport.TotalDiskGb * 100.0
            : 0.0;
        var vLowDisk = aReport.FreeDiskGb < aReport.TotalDiskGb * 0.25;

        objCapabilityCards = new List<CapabilityCard>
        {
            new("GPU cores", aReport.GpuCoreCount is > 0 ? $"{aReport.GpuCoreCount}-core" : "—", aReport.OsDescription, false, null),
            new("Unified memory", aReport.UnifiedMemoryGb is > 0 ? $"{aReport.UnifiedMemoryGb:0} GB" : $"{aReport.TotalRamGb:0} GB", "unified memory", false, null),
            new("MPS + CoreML", aReport.HasMpsCoreMl ? "Enabled" : "Unavailable", aReport.HasMpsCoreMl ? "Metal · ANE available" : "CPU only", !aReport.HasMpsCoreMl, null),
            new("Disk free", $"{aReport.FreeDiskGb:0} GB", $"of {aReport.TotalDiskGb:0} GB · large models → volume", vLowDisk, vDiskUsedPct)
        };
    }

    /// <summary>
    /// Seeds the guided-setup stepper with a representative fallback (shown only until the live
    /// <c>GET /admin/setup</c> snapshot loads, or when it is unreachable). The three provisioning
    /// steps carry the real backend step keys so their run button targets the actual endpoint even
    /// in the fallback; the network-volume row has no backing step and stays disabled.
    /// </summary>
    private void SeedSteps()
    {
        objSteps = new List<SetupStepRow>
        {
            new() { StepKey = "OnnxRuntime", Title = "ONNX Runtime", Detail = "CoreML execution provider installed · v1.20.1", DotClass = "done", DotLabel = "✓", ActionLabel = "Reinstall", Disabled = false, Progress = null },
            new() { StepKey = "PythonEnv", Title = "Isolated Python environment", Detail = "python-build-standalone venv (python 3.11) provisioned", DotClass = "done", DotLabel = "✓", ActionLabel = "Verify", Disabled = false, Progress = null },
            new() { StepKey = "ComfyUi", Title = "Managed ComfyUI", Detail = "Provisioning ComfyUI core… installing dependencies", DotClass = "run", DotLabel = "3", ActionLabel = "Logs", Disabled = false, Progress = 64.0 },
            new() { StepKey = string.Empty, Title = "Network volume mount", Detail = "For large checkpoints (SDXL, Hunyuan-Avatar) — unlocks after ComfyUI", DotClass = "", DotLabel = "4", ActionLabel = "Start", Disabled = true, Progress = null }
        };
    }

    /// <summary>
    /// Loads the live guided-setup snapshot (<c>GET /api/v1/admin/setup</c>) and replaces the seeded
    /// stepper with the real per-step state. With no session, or when the endpoint is unreachable,
    /// the representative stepper stays in place.
    /// </summary>
    /// <param name="aHasSession">Whether a signed-in session is present.</param>
    private async Task TryLoadSetupAsync(bool aHasSession)
    {
        if (!aHasSession)
        {
            return;
        }

        try
        {
            var vClient = HttpClientFactory.CreateClient("TrStudioApi");
            var vResponse = await vClient.GetAsync(ApiRoutes.Setup);
            if (!vResponse.IsSuccessStatusCode)
            {
                return;
            }

            var vStatus = await vResponse.Content.ReadFromJsonAsync<SetupStatus>();
            if (vStatus is { Steps.Length: > 0 })
            {
                objSteps = vStatus.Steps.Select((aStep, aIndex) => MapSetupStep(aStep, aIndex)).ToList();
            }
        }
        catch
        {
            // Setup endpoint not reachable / unauthenticated — keep the representative stepper.
        }
    }

    /// <summary>Maps a live <see cref="SetupStepInfo"/> onto the stepper row the wizard renders.</summary>
    private static SetupStepRow MapSetupStep(SetupStepInfo aInfo, int aIndex)
    {
        var vRow = new SetupStepRow
        {
            StepKey = aInfo.StepKey,
            Title = string.IsNullOrWhiteSpace(aInfo.StepName) ? aInfo.StepKey : aInfo.StepName,
            DotLabel = (aIndex + 1).ToString(),
            ActionLabel = "Start",
            Disabled = false,
            Detail = "Ready to provision.",
            DotClass = string.Empty
        };
        ApplyStepState(vRow, aInfo);
        return vRow;
    }

    /// <summary>Reflects a step's returned state (dot, action label, progress, detail) onto its row.</summary>
    private static void ApplyStepState(SetupStepRow aRow, SetupStepInfo aInfo)
    {
        var vRunning = string.Equals(aInfo.State, "Running", StringComparison.OrdinalIgnoreCase);
        var vDone = string.Equals(aInfo.State, "Completed", StringComparison.OrdinalIgnoreCase);

        aRow.DotClass = vDone ? "done" : vRunning ? "run" : string.Empty;
        aRow.DotLabel = vDone ? "✓" : aRow.DotLabel;
        aRow.ActionLabel = vDone ? "Verify" : vRunning ? "Logs" : "Start";
        aRow.Progress = vRunning ? aInfo.ProgressPercent : (double?)null;

        if (!string.IsNullOrWhiteSpace(aInfo.ErrorMessage))
        {
            aRow.Detail = aInfo.ErrorMessage!;
        }
        else if (!string.IsNullOrWhiteSpace(aInfo.Message))
        {
            aRow.Detail = aInfo.Message!;
        }
    }

    /// <summary>
    /// Runs a guided-setup step (<c>POST /api/v1/admin/setup/steps/{key}/run</c>) and reflects the
    /// returned step state. Handles the 400 unknown-step and 409 already-running responses the handler
    /// returns, and degrades to an informational toast when the endpoint is unreachable.
    /// </summary>
    /// <param name="aStep">The step whose run button was clicked.</param>
    private async Task RunStepAsync(SetupStepRow aStep)
    {
        if (string.IsNullOrWhiteSpace(aStep.StepKey))
        {
            ToastService.Show($"{aStep.Title}: {aStep.ActionLabel} requested.", "Guided setup");
            return;
        }

        var vClient = HttpClientFactory.CreateClient("TrStudioApi");
        try
        {
            var vResponse = await vClient.PostAsync($"{ApiRoutes.Setup}/steps/{Uri.EscapeDataString(aStep.StepKey)}/run", content: null);
            if (vResponse.IsSuccessStatusCode)
            {
                var vStep = await vResponse.Content.ReadFromJsonAsync<SetupStepInfo>();
                if (vStep is not null)
                {
                    ApplyStepState(aStep, vStep);
                }

                ToastService.Success($"{aStep.Title}: step started.", "Guided setup");
                return;
            }

            switch ((int)vResponse.StatusCode)
            {
                case 409:
                    ToastService.Show("Another setup step is already running — wait for it to finish first.", "Guided setup");
                    return;
                case 400:
                    ToastService.Error($"“{aStep.Title}” isn't a runnable setup step on this host.", "Guided setup");
                    return;
            }
        }
        catch
        {
            // Setup endpoint not reachable — fall through to the illustrative toast.
        }

        ToastService.Show($"{aStep.Title}: {aStep.ActionLabel} requested.", "Guided setup");
    }

    private sealed record CapabilityCard(string Label, string Value, string Detail, bool Warn, double? Progress);

    /// <summary>A single guided-setup stepper row; mutable so a step's returned state updates in place.</summary>
    private sealed class SetupStepRow
    {
        /// <summary>The backend setup step key (e.g. "OnnxRuntime", "PythonEnv", "ComfyUi"); empty for rows with no backing step.</summary>
        public string StepKey { get; set; } = string.Empty;

        public string Title { get; set; } = string.Empty;
        public string Detail { get; set; } = string.Empty;
        public string DotClass { get; set; } = string.Empty;
        public string DotLabel { get; set; } = string.Empty;
        public string ActionLabel { get; set; } = "Start";
        public bool Disabled { get; set; }
        public double? Progress { get; set; }
    }
}
