@page "/admin/setup/hardware"
@page "/admin/setup"
@inject IHttpClientFactory HttpClientFactory
@inject ToastService ToastService
@inject IAuthSession AuthSession
@implements IDisposable
@using Microsoft.AspNetCore.Components.Sections

@*
    Admin Hardware & guided setup (REQ-UI-070). Readiness summary cards (GPU / memory /
    MPS-CoreML / disk) with ready/warn Badges, a guided-setup stepper (ONNX, isolated Python,
    managed ComfyUI, network volume) with live Progress, and a low-disk Warning Alert (shown only
    when the live capability report actually flags low disk) linking to the Model Library. The
    stepper's step DEFINITIONS are static config; every step STATE comes from the live
    /api/v1/admin/setup snapshot — no fake progress/versions; an unreachable API raises a warning Alert.
*@

<PageTitle>TrStudio — Hardware &amp; Setup</PageTitle>

<SectionContent SectionName="topbar-context">
    @if (objReport is not null)
    {
        <Badge Variant="BadgeVariant.Outline" Class="@(objReport.IsReadyForLocalInference ? "hw-status badge-ok" : "hw-status badge-warn")" data-testid="badge-status"
               title="@string.Join(" ", objReport.Warnings)">
            <span class="dot @(objReport.IsReadyForLocalInference ? "ok" : "warn")" style="margin-right:5px"></span>
            @(objReport.IsReadyForLocalInference ? "Node healthy" : "Needs attention")
        </Badge>
    }
    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Class="hw-redetect" Disabled="@objRedetecting" OnClick="RedetectAsync" data-testid="btn-re-detect">
        @(objRedetecting ? "Detecting…" : "Re-detect")
    </Button>
</SectionContent>

<div class="stack hw-page" style="max-width:1100px">
    <div>
        <h1 class="page-title">Hardware &amp; Setup</h1>
        <p class="page-sub" style="margin-bottom:0">
            Detected capabilities on this node and guided environment provisioning — isolated from
            system Python.
        </p>
    </div>

    @if (objApiDown)
    {
        <div data-testid="api-down-alert">
            <Alert Variant="AlertVariant.Warning" AccentBorder="true">
                <LucideIcon Name="circle-alert" Size="16" />
                <AlertTitle>Couldn't reach the API — data unavailable</AlertTitle>
                <AlertDescription>Host capabilities and setup state couldn't be loaded. Check that TrStudioApi is running and reload.</AlertDescription>
            </Alert>
        </div>
    }

    @if (objCapabilitiesLoading)
    {
        <div class="kpi-grid">
            @for (var vIndex = 0; vIndex < 4; vIndex++)
            {
                <Card>
                    <CardContent Class="pt-6">
                        <Skeleton Class="h-4 w-1/2 mb-3" />
                        <Skeleton Class="h-6 w-2/3 mb-2" />
                        <Skeleton Class="h-3 w-4/5" />
                    </CardContent>
                </Card>
            }
        </div>
    }
    else if (objCapabilityCards.Count > 0)
    {
        <div class="kpi-grid">
            @for (var vIndex = 0; vIndex < objCapabilityCards.Count; vIndex++)
            {
                var vCard = objCapabilityCards[vIndex];
                var vCardTestId = $"card-{vIndex + 1}";
                var vBadgeTestId = CardBadgeTestIds[vIndex];
                <Card data-testid="@vCardTestId">
                    <CardContent Class="pt-6">
                        <div class="flex-between">
                            <span class="kpi-lbl">@vCard.Label</span>
                            <Badge Variant="BadgeVariant.Outline" Class="@(vCard.Warn ? "badge-warn" : "badge-ok")" data-testid="@vBadgeTestId">
                                @(vCard.Warn ? "low" : "ready")
                            </Badge>
                        </div>
                        <div class="kpi-big">@vCard.Value</div>
                        @if (vCard.Progress is not null)
                        {
                            <Progress Value="@vCard.Progress.Value" Class="hw-prog" IndicatorClass="hw-ind" data-testid="progress" />
                        }
                        <div class="kpi-lbl">@vCard.Detail</div>
                    </CardContent>
                </Card>
            }
        </div>
    }
    else
    {
        <Card data-testid="capabilities-unavailable">
            <CardContent Class="pt-6">
                <div class="kpi-lbl">
                    Host capabilities are unavailable — sign in as an administrator to detect this
                    node's GPU, memory and disk. No sample hardware is shown.
                </div>
            </CardContent>
        </Card>
    }

    <Card data-testid="card-guided-setup">
        <CardContent Class="pt-6">
            <div class="flex-between">
                <h3 class="setup-step-title" style="font-size:14px">Guided setup</h3>
                <Badge Variant="BadgeVariant.Outline" Class="badge-brand" data-testid="badge-2-of-4-complete">
                    @objCompletedSteps of @objSteps.Count complete
                </Badge>
            </div>
            <p class="kpi-lbl" style="margin:6px 0 4px">
                Provisions an isolated environment — never collides with system Python.
            </p>

            @{ var vButtonIds = StepButtonTestIds(); }
            @for (var vStepIndex = 0; vStepIndex < objSteps.Count; vStepIndex++)
            {
                var vStep = objSteps[vStepIndex];
                var vButtonId = vButtonIds[vStepIndex];
                <div class="setup-step">
                    <div class="setup-stepdot @vStep.DotClass">@vStep.DotLabel</div>
                    <div class="setup-step-body">
                        <div class="setup-step-title">@vStep.Title</div>
                        <div class="kpi-lbl" style="margin-bottom:@(vStep.Progress is null ? "0" : "6px")">@vStep.Detail</div>
                        @if (vStep.Progress is not null)
                        {
                            <Progress Value="@vStep.Progress.Value" Class="hw-prog" IndicatorClass="hw-ind" data-testid="progress-2" />
                            <div class="kpi-lbl" style="margin-top:4px" data-testid="@($"step-progress-{vStep.StepKey}")">@vStep.Progress.Value.ToString("0") % · @(string.IsNullOrWhiteSpace(vStep.Running) ? "starting" : vStep.Running)</div>
                        }
                    </div>
                    @if (vStep.Disabled)
                    {
                        <Button Disabled="true" data-testid="@vButtonId">Start</Button>
                    }
                    else
                    {
                        <Button Variant="ButtonVariant.Outline" OnClick="@(() => StepActionAsync(vStep))" data-testid="@vButtonId">@vStep.ActionLabel</Button>
                    }
                </div>
            }
        </CardContent>
    </Card>

    @if (objLowDisk)
    {
        <div>
            <Alert Variant="AlertVariant.Warning" AccentBorder="true" data-testid="alert-warn">
                <AlertTitle>Disk space low</AlertTitle>
                <AlertDescription>
                    Only @objFreeDiskGb.ToString("0") GB of @objTotalDiskGb.ToString("0") GB is free on this node —
                    large checkpoints may not fit. Attach a network volume before installing from the
                    <a href="/admin/models" class="hw-link" data-testid="link-model-library">Model Library</a>.
                    <a href="/admin/ops" class="hw-link" data-testid="link-configure-volume">Configure volume →</a>
                </AlertDescription>
            </Alert>
        </div>
    }
</div>

@code {
    private List<CapabilityCard> objCapabilityCards = new();
    private List<SetupStepRow> objSteps = new();
    private bool objCapabilitiesLoading = true;
    private HostCapabilityReport? objReport;
    private bool objRedetecting;
    private bool objApiDown;
    private bool objLowDisk;
    private double objFreeDiskGb;
    private double objTotalDiskGb;

    /// <summary>The mockup's names for the four readiness cards' status badges, in card order.</summary>
    private static readonly string[] CardBadgeTestIds = { "badge-ready", "badge-ready-2", "badge-ready-3", "badge-low" };

    /// <summary>
    /// The mockup's control name for each step's action button, from its label (btn-reinstall, btn-verify,
    /// btn-logs, btn-start); a repeated label gets -2, -3 … in page order, as the mockups number them.
    /// </summary>
    private List<string> StepButtonTestIds()
    {
        var vSeen = new Dictionary<string, int>();
        var vIds = new List<string>();
        foreach (var vStep in objSteps)
        {
            var vBase = "btn-" + (vStep.Disabled ? "start" : vStep.ActionLabel.ToLowerInvariant());
            vSeen[vBase] = vSeen.TryGetValue(vBase, out var vCount) ? vCount + 1 : 1;
            vIds.Add(vSeen[vBase] == 1 ? vBase : $"{vBase}-{vSeen[vBase]}");
        }

        return vIds;
    }

    private int objCompletedSteps => objSteps.Count(aStep => aStep.DotClass == "done");

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        // The guided-setup stepper's step DEFINITIONS (keys/titles) are static provisioning config, so
        // they are safe to render immediately — but every step STATE (done/running/progress) is live
        // data and starts neutral until the authenticated GET /admin/setup snapshot replaces it. The
        // capability cards are host-specific and load from the authenticated report after first render.
        InitializeStepDefinitions();
    }

    /// <summary>
    /// Detects host capabilities AFTER the first interactive render — once JS interop is available and
    /// <see cref="IAuthSession"/> can hydrate the bearer token. Reporting only real, authenticated
    /// data (never a sample Mac profile on a non-Mac host) means the cards never misrepresent the node.
    /// </summary>
    /// <param name="aFirstRender">Whether this is the component's first render.</param>
    protected override async Task OnAfterRenderAsync(bool aFirstRender)
    {
        if (!aFirstRender)
        {
            return;
        }

        var vHasSession = await AuthSession.EnsureLoadedAsync();
        await TryLoadCapabilitiesAsync(vHasSession);
        await TryLoadSetupAsync(vHasSession);
        objCapabilitiesLoading = false;
        StateHasChanged();
    }

    /// <summary>
    /// Loads the live host-capability report. With no session, or when the endpoint is unreachable,
    /// the cards stay empty and an "unavailable" note renders — never a sample hardware profile.
    /// </summary>
    /// <param name="aHasSession">Whether a signed-in session is present.</param>
    private async Task TryLoadCapabilitiesAsync(bool aHasSession)
    {
        if (!aHasSession)
        {
            return;
        }

        try
        {
            var vClient = HttpClientFactory.CreateClient("TrStudioApi");
            var vResponse = await vClient.GetAsync(ApiRoutes.Capabilities);
            if (!vResponse.IsSuccessStatusCode)
            {
                objApiDown = true;
                return;
            }

            var vReport = await vResponse.Content.ReadFromJsonAsync<HostCapabilityReport>();
            if (vReport is not null)
            {
                ApplyReport(vReport);
            }
        }
        catch
        {
            // API unreachable — keep the cards empty (the unavailable note renders) and raise the
            // warning Alert; never a sample hardware profile.
            objApiDown = true;
        }
    }

    /// <summary>Probes the node again (the capability report is detected fresh on every request) and redraws the cards.</summary>
    private async Task RedetectAsync()
    {
        objRedetecting = true;
        objApiDown = false;
        await TryLoadCapabilitiesAsync(await AuthSession.EnsureLoadedAsync());
        objRedetecting = false;
        if (objApiDown)
        {
            ToastService.Error("Couldn't reach the API — hardware wasn't re-detected.", "Hardware");
        }
        else
        {
            ToastService.Success("Hardware re-detected.", "Hardware");
        }
    }

    /// <summary>Maps a live capability report onto the readiness cards.</summary>
    private void ApplyReport(HostCapabilityReport aReport)
    {
        objReport = aReport;
        var vDiskUsedPct = aReport.TotalDiskGb > 0
            ? (aReport.TotalDiskGb - aReport.FreeDiskGb) / aReport.TotalDiskGb * 100.0
            : 0.0;
        var vLowDisk = aReport.FreeDiskGb < aReport.TotalDiskGb * 0.25;

        // Drive the page-level low-disk Alert from the LIVE report only (never a canned warning).
        objLowDisk = vLowDisk;
        objFreeDiskGb = aReport.FreeDiskGb;
        objTotalDiskGb = aReport.TotalDiskGb;

        objCapabilityCards = new List<CapabilityCard>
        {
            new("GPU cores", aReport.GpuCoreCount is > 0 ? $"{aReport.GpuCoreCount}-core" : "—", aReport.OsDescription, false, null),
            new("Unified memory", aReport.UnifiedMemoryGb is > 0 ? $"{aReport.UnifiedMemoryGb:0} GB" : $"{aReport.TotalRamGb:0} GB", "unified memory", false, null),
            new("MPS + CoreML", aReport.HasMpsCoreMl ? "Enabled" : "Unavailable", aReport.HasMpsCoreMl ? "Metal · ANE available" : "CPU only", !aReport.HasMpsCoreMl, null),
            new("Disk free", $"{aReport.FreeDiskGb:0} GB", $"of {aReport.TotalDiskGb:0} GB · large models → volume", vLowDisk, vDiskUsedPct)
        };
    }

    /// <summary>
    /// Initializes the stepper with the static step DEFINITIONS only (legitimate provisioning config:
    /// the real backend step keys + titles) in a neutral not-yet-checked state — no fake versions,
    /// completion ticks or progress. The live <c>GET /admin/setup</c> snapshot supplies every state.
    /// The network-volume row has no backing step and stays disabled.
    /// </summary>
    private void InitializeStepDefinitions()
    {
        objSteps = new List<SetupStepRow>
        {
            new() { StepKey = "OnnxRuntime", Title = "ONNX Runtime", Detail = "State not loaded yet.", DotClass = "", DotLabel = "1", ActionLabel = "Start", Disabled = false, Progress = null },
            new() { StepKey = "PythonEnv", Title = "Isolated Python environment", Detail = "State not loaded yet.", DotClass = "", DotLabel = "2", ActionLabel = "Start", Disabled = false, Progress = null },
            new() { StepKey = "ComfyUi", Title = "Managed ComfyUI", Detail = "State not loaded yet.", DotClass = "", DotLabel = "3", ActionLabel = "Start", Disabled = false, Progress = null },
            new() { StepKey = string.Empty, Title = "Network volume mount", Detail = "For large checkpoints — no backing setup step yet", DotClass = "", DotLabel = "4", ActionLabel = "Start", Disabled = true, Progress = null }
        };
    }

    /// <summary>
    /// Loads the live guided-setup snapshot (<c>GET /api/v1/admin/setup</c>) and replaces the neutral
    /// stepper with the real per-step state. When the endpoint is unreachable the steps stay in their
    /// neutral state and the API-down Alert renders.
    /// </summary>
    /// <param name="aHasSession">Whether a signed-in session is present.</param>
    private async Task TryLoadSetupAsync(bool aHasSession)
    {
        if (!aHasSession)
        {
            return;
        }

        try
        {
            var vClient = HttpClientFactory.CreateClient("TrStudioApi");
            var vResponse = await vClient.GetAsync(ApiRoutes.Setup);
            if (!vResponse.IsSuccessStatusCode)
            {
                objApiDown = true;
                return;
            }

            var vStatus = await vResponse.Content.ReadFromJsonAsync<SetupStatus>();
            if (vStatus is { Steps.Length: > 0 })
            {
                // The live steps replace the neutral ones; the network-volume row has no backing step and stays.
                var vVolumeRow = objSteps.Last(aStep => string.IsNullOrEmpty(aStep.StepKey));
                objSteps = vStatus.Steps.Select((aStep, aIndex) => MapSetupStep(aStep, aIndex)).ToList();
                vVolumeRow.DotLabel = (objSteps.Count + 1).ToString();
                objSteps.Add(vVolumeRow);
                // A step still running (started before this page opened) is followed until it ends.
                foreach (var vRunning in objSteps.Where(aStep => aStep.Progress is not null))
                {
                    _ = FollowStepAsync(vRunning);
                }
            }
        }
        catch
        {
            // API unreachable — the neutral stepper stays and the warning Alert renders.
            objApiDown = true;
        }
    }

    /// <summary>Maps a live <see cref="SetupStepInfo"/> onto the stepper row the wizard renders.</summary>
    private static SetupStepRow MapSetupStep(SetupStepInfo aInfo, int aIndex)
    {
        var vRow = new SetupStepRow
        {
            StepKey = aInfo.StepKey,
            Title = string.IsNullOrWhiteSpace(aInfo.StepName) ? aInfo.StepKey : aInfo.StepName,
            DotLabel = (aIndex + 1).ToString(),
            ActionLabel = "Start",
            Disabled = false,
            Detail = "Ready to provision.",
            DotClass = string.Empty
        };
        ApplyStepState(vRow, aInfo);
        return vRow;
    }

    /// <summary>Reflects a step's returned state (dot, action label, progress, detail) onto its row.</summary>
    private static void ApplyStepState(SetupStepRow aRow, SetupStepInfo aInfo)
    {
        var vRunning = string.Equals(aInfo.State, "Running", StringComparison.OrdinalIgnoreCase);
        var vDone = string.Equals(aInfo.State, "Completed", StringComparison.OrdinalIgnoreCase);

        aRow.DotClass = vDone ? "done" : vRunning ? "run" : string.Empty;
        aRow.DotLabel = vDone ? "✓" : aRow.DotLabel;
        // A finished ONNX Runtime install is re-run as a reinstall; the other finished steps re-run as a verify.
        aRow.ActionLabel = vDone
            ? (string.Equals(aRow.StepKey, "OnnxRuntime", StringComparison.OrdinalIgnoreCase) ? "Reinstall" : "Verify")
            : vRunning ? "Logs" : "Start";
        aRow.Progress = vRunning ? aInfo.ProgressPercent : (double?)null;
        aRow.Running = vRunning ? aInfo.Message ?? string.Empty : string.Empty;

        if (!string.IsNullOrWhiteSpace(aInfo.ErrorMessage))
        {
            aRow.Detail = aInfo.ErrorMessage!;
        }
        else if (!string.IsNullOrWhiteSpace(aInfo.Message))
        {
            aRow.Detail = aInfo.Message!;
        }
    }

    /// <summary>A running step's button shows its latest progress line; any other step's button runs it.</summary>
    /// <param name="aStep">The step whose button was clicked.</param>
    private Task StepActionAsync(SetupStepRow aStep)
        => aStep.ActionLabel == "Logs" ? ShowStepLogAsync(aStep) : RunStepAsync(aStep);

    /// <summary>
    /// Reads the running step's latest state (<c>GET /api/v1/admin/setup/steps/{key}</c>), shows its
    /// progress line and refreshes the row.
    /// </summary>
    /// <param name="aStep">The running step.</param>
    private async Task ShowStepLogAsync(SetupStepRow aStep)
    {
        try
        {
            var vClient = HttpClientFactory.CreateClient("TrStudioApi");
            var vInfo = await vClient.GetFromJsonAsync<SetupStepInfo>($"{ApiRoutes.Setup}/steps/{Uri.EscapeDataString(aStep.StepKey)}");
            if (vInfo is not null)
            {
                ApplyStepState(aStep, vInfo);
                ToastService.Show($"{vInfo.ProgressPercent}% · {vInfo.ErrorMessage ?? vInfo.Message ?? vInfo.State}", aStep.Title);
                return;
            }
        }
        catch
        {
            // Fall through to the honest failure toast.
        }

        ToastService.Error($"Couldn't read the latest progress of “{aStep.Title}”.", "Guided setup");
    }

    /// <summary>
    /// Runs a guided-setup step (<c>POST /api/v1/admin/setup/steps/{key}/run</c>) and reflects the
    /// returned step state. Handles the 400 unknown-step and 409 already-running responses the handler
    /// returns, and degrades to an informational toast when the endpoint is unreachable.
    /// </summary>
    /// <param name="aStep">The step whose run button was clicked.</param>
    private async Task RunStepAsync(SetupStepRow aStep)
    {
        if (string.IsNullOrWhiteSpace(aStep.StepKey))
        {
            ToastService.Show($"{aStep.Title}: {aStep.ActionLabel} requested.", "Guided setup");
            return;
        }

        var vClient = HttpClientFactory.CreateClient("TrStudioApi");
        try
        {
            var vResponse = await vClient.PostAsync($"{ApiRoutes.Setup}/steps/{Uri.EscapeDataString(aStep.StepKey)}/run", content: null);
            if (vResponse.IsSuccessStatusCode)
            {
                var vStep = await vResponse.Content.ReadFromJsonAsync<SetupStepInfo>();
                if (vStep is not null)
                {
                    ApplyStepState(aStep, vStep);
                }

                ToastService.Success($"{aStep.Title}: step started.", "Guided setup");
                _ = FollowStepAsync(aStep);
                return;
            }

            switch ((int)vResponse.StatusCode)
            {
                case 409:
                    ToastService.Show("Another setup step is already running — wait for it to finish first.", "Guided setup");
                    return;
                case 400:
                    ToastService.Error($"“{aStep.Title}” isn't a runnable setup step on this host.", "Guided setup");
                    return;
            }
        }
        catch
        {
            // Fall through to the honest failure toast.
        }

        ToastService.Error($"Couldn't reach the API — “{aStep.Title}” wasn't started.", "Guided setup");
    }

    /// <summary>Stops following running steps when the page closes.</summary>
    private readonly CancellationTokenSource objFollowCts = new();

    /// <summary>
    /// Follows a running step (owner run of 17 Nov 2026: the row stayed at "0 %" and a failure was seen
    /// only after pressing Logs): reads it every 1.5 s, shows its progress line, and when it ends shows
    /// "done" or its error, with a toast.
    /// </summary>
    /// <param name="aStep">The running step.</param>
    private async Task FollowStepAsync(SetupStepRow aStep)
    {
        if (aStep.Following || string.IsNullOrWhiteSpace(aStep.StepKey))
        {
            return;
        }

        aStep.Following = true;
        try
        {
            var vClient = HttpClientFactory.CreateClient("TrStudioApi");
            while (!objFollowCts.IsCancellationRequested)
            {
                await Task.Delay(1500, objFollowCts.Token);
                SetupStepInfo? vInfo;
                try
                {
                    vInfo = await vClient.GetFromJsonAsync<SetupStepInfo>($"{ApiRoutes.Setup}/steps/{Uri.EscapeDataString(aStep.StepKey)}", objFollowCts.Token);
                }
                catch (HttpRequestException)
                {
                    continue;
                }

                if (vInfo is null)
                {
                    continue;
                }

                ApplyStepState(aStep, vInfo);
                await InvokeAsync(StateHasChanged);
                if (string.Equals(vInfo.State, "Running", StringComparison.OrdinalIgnoreCase))
                {
                    continue;
                }

                if (string.Equals(vInfo.State, "Completed", StringComparison.OrdinalIgnoreCase))
                {
                    ToastService.Success($"{aStep.Title}: done.", "Guided setup");
                }
                else if (!string.IsNullOrWhiteSpace(vInfo.ErrorMessage))
                {
                    ToastService.Error(vInfo.ErrorMessage!, aStep.Title);
                }

                break;
            }
        }
        catch (OperationCanceledException)
        {
            // the page closed
        }
        finally
        {
            aStep.Following = false;
        }
    }

    /// <inheritdoc />
    public void Dispose()
    {
        objFollowCts.Cancel();
        objFollowCts.Dispose();
    }

    private sealed record CapabilityCard(string Label, string Value, string Detail, bool Warn, double? Progress);

    /// <summary>A single guided-setup stepper row; mutable so a step's returned state updates in place.</summary>
    private sealed class SetupStepRow
    {
        /// <summary>The backend setup step key (e.g. "OnnxRuntime", "PythonEnv", "ComfyUi"); empty for rows with no backing step.</summary>
        public string StepKey { get; set; } = string.Empty;

        public string Title { get; set; } = string.Empty;
        public string Detail { get; set; } = string.Empty;
        public string DotClass { get; set; } = string.Empty;
        public string DotLabel { get; set; } = string.Empty;
        public string ActionLabel { get; set; } = "Start";
        public bool Disabled { get; set; }
        public double? Progress { get; set; }

        /// <summary>The running step's own progress message (e.g. "Downloading CPython …").</summary>
        public string Running { get; set; } = string.Empty;

        /// <summary>True while the page follows this step.</summary>
        public bool Following { get; set; }
    }
}
