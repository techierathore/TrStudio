@page "/admin/registry"
@inject IHttpClientFactory HttpClientFactory
@inject ToastService ToastService
@inject IAuthSession AuthSession
@using Microsoft.AspNetCore.Components.Sections
@using TrBlazeUI.Components.Table
@using TrBlazeUI.Components.NativeSelect

@*
    Admin Registry & providers (REQ-UI-071). A filter/sortable DataTable of registry rows
    (id, name, task, provider, tier Badge, license, safety Badge), an add/edit Sheet carrying
    the declarative params-schema editor (key/type/required/default rows with validation), and
    a Provider-keys panel of masked write-only Password inputs with an enabled Switch. Consumes
    the registry + provider-key endpoints with a representative fallback while unauthenticated.
    Phase 2 (REQ-UI-083/084/097): Venice provider card (address, masked key, enabled, Test
    connection), Provider / Provider model id / Fill from Venice and two ability checkboxes in the
    edit sheet, and a Venice badge in the table. No Venice address, key or model id lives in code.
    Control names follow docs/mockups/admin-registry.html (the search box and + Add model sit in the
    topbar; the mockup's inline Edit model card is this Sheet, drawn open as state "edit-open").
*@

<PageTitle>TrStudio — Registry &amp; Providers</PageTitle>

<SectionContent SectionName="topbar-context">
    <Input @bind-Value="objSearch" @bind-Value:event="oninput" Placeholder="Search registry…" Class="registry-search"
           aria-label="Search registry" data-testid="field-search-registry" />
    <Button OnClick="OpenAddSheet" Class="registry-add" data-testid="btn-add-model">+ Add model</Button>
</SectionContent>

<div class="stack registry-page">
    <div>
        <h1 class="page-title">Registry &amp; Providers</h1>
        <p class="page-sub" style="margin-bottom:0">
            Declarative model rows. The params schema here auto-renders TrStudio's controls —
            no code change.
        </p>
    </div>

    <div class="registry-layout">
        <Card Class="p-0 overflow-hidden" data-testid="card-1">
            <div class="table-scroll">
                <Table Class="registry-table" data-testid="table-1">
                    <TableHeader>
                        <TableRow>
                            <TableHead>id</TableHead>
                            <TableHead>name</TableHead>
                            <TableHead>task</TableHead>
                            <TableHead>provider</TableHead>
                            <TableHead>tier</TableHead>
                            <TableHead>license</TableHead>
                            <TableHead>safety</TableHead>
                        </TableRow>
                    </TableHeader>
                    <TableBody>
                        @if (objLoading)
                        {
                            <TableRow><TableCell colspan="7" Class="kpi-lbl">Loading the registry…</TableCell></TableRow>
                        }
                        else if (VisibleRows.Count == 0)
                        {
                            <TableRow><TableCell colspan="7" Class="kpi-lbl">@(objRows.Count == 0 ? "No registry rows yet — add a model." : "No rows match this search.")</TableCell></TableRow>
                        }
                        @{
                            var vBadgeCounts = new Dictionary<string, int>(StringComparer.Ordinal);
                        }
                        @foreach (var vRow in objLoading ? new List<RegistryRow>() : VisibleRows)
                        {
                            var vSuffix = vRow.IsVenice ? "-venice" : string.Empty;
                            var vProviderId = vRow.IsVenice ? NextId(vBadgeCounts, "badge-venice") : null;
                            var vTierId = NextId(vBadgeCounts, $"badge-{vRow.Tier}{vSuffix}");
                            var vSafetyId = NextId(vBadgeCounts, $"badge-{vRow.Safety}{vSuffix}");
                            <TableRow Class="@(objSheetOpen && !objIsNew && vRow.Id == objEditId ? "registry-row sel" : "registry-row")"
                                      @onclick="@(() => OpenEditSheet(vRow))">
                                <TableCell>
                                    <button type="button" class="registry-id" aria-label="@($"Edit model {vRow.Name}")"
                                            @onclick="@(() => OpenEditSheet(vRow))" @onclick:stopPropagation="true">@vRow.Id</button>
                                </TableCell>
                                <TableCell>
                                    <div><b>@vRow.Name</b></div>
                                    <div class="kpi-lbl" style="font-size:11px">@vRow.Subtitle</div>
                                </TableCell>
                                <TableCell>@vRow.Task</TableCell>
                                <TableCell>
                                    @if (vRow.IsVenice)
                                    {
                                        <Badge Variant="BadgeVariant.Outline" Class="badge-brand" data-testid="@vProviderId">Venice</Badge>
                                    }
                                    else
                                    {
                                        @vRow.Provider
                                    }
                                </TableCell>
                                <TableCell><Badge Variant="BadgeVariant.Outline" Class="@vRow.TierTone" data-testid="@vTierId">@vRow.Tier</Badge></TableCell>
                                <TableCell>@vRow.License</TableCell>
                                <TableCell>
                                    <Badge Variant="BadgeVariant.Outline" Class="@vRow.SafetyTone" data-testid="@vSafetyId">@vRow.Safety</Badge>
                                </TableCell>
                            </TableRow>
                        }
                    </TableBody>
                </Table>
            </div>
        </Card>

        <Card data-testid="card-provider-keys">
            <CardHeader>
                <CardTitle>Provider keys</CardTitle>
                <CardDescription>Encrypted at rest · never logged.</CardDescription>
            </CardHeader>
            <CardContent Class="flex-col">
                @if (objKeyNote is not null)
                {
                    @* Phase 3 (REQ-UI-104): where the keys are kept and what protects them. *@
                    <Alert Variant="AlertVariant.Info" AccentBorder="true" data-testid="key-protection-note">
                        <AlertDescription>@objKeyNote</AlertDescription>
                    </Alert>
                }
                @foreach (var vKey in objProviderKeys)
                {
                    var vSlug = KeySlug(vKey);
                    <div data-testid="@($"provider-{vSlug}")">
                        <div class="flex-between">
                            <div class="flex-row">
                                <Label>@KeyLabel(vKey)</Label>
                                @if (vKey.Stored)
                                {
                                    <Badge Variant="BadgeVariant.Outline" Class="badge-ok" data-testid="@($"badge-{vSlug}-configured")">Configured</Badge>
                                    @* Owner, 17 Nov 2026: a stored key can be removed here, after one confirming click. *@
                                    @if (objConfirmRemove == vKey.ProviderName)
                                    {
                                        <Button Variant="ButtonVariant.Destructive" Size="ButtonSize.Small" OnClick="@(() => RemoveKeyAsync(vKey))"
                                                aria-label="@($"Confirm remove {KeyLabel(vKey)} key")" data-testid="@($"btn-remove-{vSlug}-confirm")">Remove</Button>
                                        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="@(() => objConfirmRemove = null)"
                                                aria-label="@($"Keep {KeyLabel(vKey)} key")" data-testid="@($"btn-remove-{vSlug}-keep")">Keep</Button>
                                    }
                                    else
                                    {
                                        <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="@(() => objConfirmRemove = vKey.ProviderName)"
                                                aria-label="@($"Remove {KeyLabel(vKey)} key")" data-testid="@($"btn-remove-{vSlug}")">Remove key</Button>
                                    }
                                }
                            </div>
                            <div class="flex-row">
                                <span class="kpi-lbl" style="font-size:11px">@(vKey.Enabled ? "enabled" : "disabled")</span>
                                <Switch @bind-Checked="vKey.Enabled" AriaLabel="@($"Enable {KeyLabel(vKey)}")" data-testid="@SwitchId(vKey, vSlug)" />
                            </div>
                        </div>
                        @if (vKey.ProviderName == RunPodProvider)
                        {
                            @* Phase 3 (REQ-FN-096): the RunPod endpoint id is kept beside its key. *@
                            <Label Class="mt-2">Endpoint id</Label>
                            <Input @bind-Value="vKey.Account" Class="mt-1" Placeholder="Your RunPod serverless endpoint id"
                                   data-testid="field-runpod-endpoint" />
                            <Label Class="mt-2">API key</Label>
                        }
                        <Input Type="InputType.Password" @bind-Value="vKey.Value" Class="mt-2"
                               Placeholder="@(vKey.Stored ? $"Stored {vKey.MaskedKey} · enter a new key to replace" : "Enter the key")"
                               data-testid="@(vKey.ProviderName == RunPodProvider ? "field-runpod-key" : $"field-{vSlug}")" />
                    </div>
                    @if (vKey.ProviderName == RunPodProvider)
                    {
                        @* Phase 3 (REQ-RAG-006): scripts and captions use the enabled text-chat row that has an
                           address, a model and a key; the list shows which one that is. *@
                        <div data-testid="provider-text-model">
                            <div class="flex-between">
                                <Label>Text model (scripts and captions)</Label>
                                <span class="kpi-lbl" style="font-size:11px">from the enabled text-chat row</span>
                            </div>
                            <NativeSelect TValue="string" Value="@TextModelInUse" disabled Class="w-full mt-2"
                                          aria-label="Text model (scripts and captions)" data-testid="field-text-model">
                                @if (TextChatRows.Count == 0)
                                {
                                    <option value="">No text-chat row yet</option>
                                }
                                @foreach (var vText in TextChatRows)
                                {
                                    <option value="@vText.Id">@TextModelLabel(vText)</option>
                                }
                            </NativeSelect>
                        </div>
                    }
                }
                <div data-testid="provider-venice">
                    <div class="flex-between">
                        <div class="flex-row">
                            <Label>Venice</Label>
                            <Badge Variant="BadgeVariant.Outline" Class="badge-brand" data-testid="badge-cloud-venice">Cloud</Badge>
                        </div>
                        <div class="flex-row">
                            <span class="kpi-lbl" style="font-size:11px">@(objVenice.Enabled ? "enabled" : "disabled")</span>
                            <Switch @bind-Checked="objVenice.Enabled" AriaLabel="Enable Venice" data-testid="switch-venice" />
                        </div>
                    </div>
                    <Field Class="mt-2">
                        <FieldLabel>Address</FieldLabel>
                        <FieldContent>
                            <Input @bind-Value="objVenice.BaseUrl" Placeholder="https://… (Venice API address)" data-testid="field-venice-address" />
                        </FieldContent>
                    </Field>
                    <Field Class="mt-2">
                        <FieldLabel>API key</FieldLabel>
                        <FieldContent>
                            <Input Type="InputType.Password" @bind-Value="objVenice.NewKey"
                                   Placeholder="@(string.IsNullOrEmpty(objVenice.MaskedKey) ? "Enter the Venice key" : objVenice.MaskedKey)"
                                   data-testid="field-venice-key" />
                        </FieldContent>
                    </Field>
                    <div class="flex-row mt-2">
                        <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="TestVeniceAsync" Class="whitespace-nowrap shrink-0"
                                Disabled="@objVenice.Testing" data-testid="btn-test-connection">
                            @(objVenice.Testing ? "Testing…" : "Test connection")
                        </Button>
                        @if (objVenice.Connected == true)
                        {
                            <Badge Variant="BadgeVariant.Outline" Class="badge-ok" data-testid="badge-connected">Connected</Badge>
                        }
                    </div>
                    @if (objVenice.Connected == false && !string.IsNullOrWhiteSpace(objVenice.Message))
                    {
                        <div class="field-err" style="margin-top:6px" data-testid="venice-error">@objVenice.Message</div>
                    }
                </div>
                <Alert Variant="AlertVariant.Info" AccentBorder="true" data-testid="alert-info">
                    <AlertDescription>
                        Keys are write-only — saved values are masked and cannot be read back.
                    </AlertDescription>
                </Alert>
                <Button Variant="ButtonVariant.Outline" OnClick="SaveKeysAsync">Save keys</Button>
            </CardContent>
        </Card>
    </div>
</div>

<Sheet @bind-Open="objSheetOpen">
    <SheetContent Class="w-[400px] sm:w-[560px]" data-testid="card-edit-model">
        <SheetHeader>
            <div class="flex-row">
                <SheetTitle>@(objIsNew ? "Add model" : "Edit model")</SheetTitle>
                @if (!objIsNew && !string.IsNullOrWhiteSpace(objEditId))
                {
                    <Badge Variant="BadgeVariant.Outline" Class="badge-brand" data-testid="@($"badge-{objEditId}")">@objEditId</Badge>
                }
            </div>
            <SheetDescription>
                Declarative row — the params schema below auto-renders the studio controls.
            </SheetDescription>
        </SheetHeader>

        <div class="flex-col" style="padding:16px 0">
            <Field>
                <FieldLabel>Display name</FieldLabel>
                <FieldContent>
                    <Input @bind-Value="objEditName" Placeholder="e.g. MuseTalk" data-testid="field-display-name" />
                </FieldContent>
            </Field>

            <div class="flex-row" style="align-items:flex-start">
                <Field Class="grow">
                    <FieldLabel>Task</FieldLabel>
                    <FieldContent>
                        <Select @bind-Value="objEditTask" TValue="string" Class="w-full">
                            <SelectTrigger data-testid="field-task"><SelectValue Placeholder="Select task" /></SelectTrigger>
                            <SelectContent>
                                @foreach (var vTask in objTaskOptions)
                                {
                                    <SelectItem Value="@vTask" Text="@vTask" TValue="string">@vTask</SelectItem>
                                }
                            </SelectContent>
                        </Select>
                    </FieldContent>
                </Field>
                <Field Class="grow">
                    <FieldLabel>Tier</FieldLabel>
                    <FieldContent>
                        <Select @bind-Value="objEditTier" TValue="string" Class="w-full">
                            <SelectTrigger data-testid="field-tier"><SelectValue Placeholder="Select tier" /></SelectTrigger>
                            <SelectContent>
                                <SelectItem Value="@("fast")" Text="fast" TValue="string">fast</SelectItem>
                                <SelectItem Value="@("high")" Text="high" TValue="string">high</SelectItem>
                                <SelectItem Value="@("premium")" Text="premium" TValue="string">premium</SelectItem>
                            </SelectContent>
                        </Select>
                    </FieldContent>
                </Field>
            </div>

            @if (objEditIsTextChat)
            {
                <Field>
                    <FieldLabel>Endpoint</FieldLabel>
                    <FieldContent>
                        <Input @bind-Value="objEditEndpoint" Placeholder="https://api.openai.com/v1" data-testid="textchat-endpoint" />
                    </FieldContent>
                </Field>
                <Field>
                    <FieldLabel>Chat model</FieldLabel>
                    <FieldContent>
                        <Input @bind-Value="objEditChatModel" Placeholder="e.g. gpt-4o" data-testid="textchat-model" />
                    </FieldContent>
                </Field>
                <div class="flex-between">
                    <Label>Vision-capable (accepts image attachments)</Label>
                    <Switch @bind-Checked="objEditVision" AriaLabel="Vision-capable" data-testid="textchat-vision" />
                </div>
                <Field>
                    <FieldLabel>API key</FieldLabel>
                    <FieldContent>
                        <Input Type="InputType.Password" @bind-Value="objEditApiKey"
                               Placeholder="Enter a new key to replace" data-testid="textchat-key" />
                    </FieldContent>
                </Field>
                <Alert Variant="AlertVariant.Default">
                    <AlertDescription>
                        Text-chat rows power the Prompt Studio LLM picker. The key is encrypted at rest
                        (write-only) and never runs a generation job.
                    </AlertDescription>
                </Alert>
            }
            else
            {
            <div class="flex-row" style="align-items:flex-start" data-testid="venice-model-fields">
                <Field Class="grow">
                    <FieldLabel>Provider</FieldLabel>
                    <FieldContent>
                        <Select @bind-Value="objEditProvider" TValue="string" Class="w-full">
                            <SelectTrigger data-testid="field-provider"><SelectValue Placeholder="Select provider" /></SelectTrigger>
                            <SelectContent>
                                @foreach (var vProvider in objProviderOptions)
                                {
                                    <SelectItem Value="@vProvider.Value" Text="@vProvider.Label" TValue="string">@vProvider.Label</SelectItem>
                                }
                            </SelectContent>
                        </Select>
                    </FieldContent>
                </Field>
                <Field Class="grow">
                    <FieldLabel>Provider model id</FieldLabel>
                    <FieldContent>
                        <div class="flex-row">
                            <Input @bind-Value="objEditProviderModelId" Placeholder="e.g. the Venice model id" data-testid="field-provider-model-id" />
                            <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="FillFromVeniceAsync"
                                    Disabled="@(!objEditIsVenice || objFilling)" data-testid="btn-fill-from-venice">
                                @(objFilling ? "Filling…" : "Fill from Venice")
                            </Button>
                        </div>
                    </FieldContent>
                </Field>
            </div>
            <div class="flex-row" data-testid="model-abilities">
                <div class="flex-row">
                    <Checkbox @bind-Checked="objEditTakesReference" Id="takes-reference-picture" data-testid="field-takes-reference-picture" />
                    <Label For="takes-reference-picture">Takes a reference picture</Label>
                </div>
                <div class="flex-row">
                    <Checkbox @bind-Checked="objEditKeepsCharacter" Id="keeps-fixed-character" data-testid="field-keeps-fixed-character" />
                    <Label For="keeps-fixed-character">Keeps a fixed character</Label>
                </div>
            </div>
            @if (objFillError is not null)
            {
                <div class="field-err" data-testid="venice-fill-error">@objFillError</div>
            }
            <div>
                <div class="flex-between">
                    <Label>Params schema</Label>
                    <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="AddParamRow" data-testid="btn-row">
                        <LucideIcon Name="plus" Size="14" />
                        row
                    </Button>
                </div>
                <div class="params-grid" style="margin-top:8px">
                    <div class="hd">key</div>
                    <div class="hd">type</div>
                    <div class="hd">req</div>
                    <div class="hd">default</div>
                    <div></div>
                    @for (var vIndex = 0; vIndex < objParams.Count; vIndex++)
                    {
                        var vParam = objParams[vIndex];
                        var vBad = IsBadParam(vParam);
                        <Input @bind-Value="vParam.Key" Placeholder="key" Class="@(vBad ? "border-destructive" : null)"
                               data-testid="@(vIndex == 0 ? "field-params-schema" : $"field-{5 + 3 * vIndex}")" />
                        <Select @bind-Value="vParam.Type" TValue="string">
                            <SelectTrigger data-testid="@($"field-{6 + 3 * vIndex}")"><SelectValue Placeholder="type" /></SelectTrigger>
                            <SelectContent>
                                @foreach (var vType in objTypeOptions)
                                {
                                    <SelectItem Value="@vType" Text="@vType" TValue="string">@vType</SelectItem>
                                }
                            </SelectContent>
                        </Select>
                        <Switch @bind-Checked="vParam.Required" AriaLabel="Required" data-testid="@(vIndex == 0 ? "switch" : $"switch-{vIndex + 1}")" />
                        <Input @bind-Value="vParam.Default" Placeholder="—" Class="@(vBad ? "border-destructive" : null)"
                               data-testid="@($"field-{7 + 3 * vIndex}")" />
                        <button type="button" class="params-del" aria-label="Remove row" @onclick="@(() => RemoveParamRow(vParam))">✕</button>
                    }
                </div>
                @foreach (var vEnum in objParams.Where(aParam => aParam.Values is { Length: > 0 }))
                {
                    <div class="kpi-lbl" style="font-size:11px;margin-top:4px" data-testid="param-values">
                        @vEnum.Key: @string.Join(", ", vEnum.Values!)
                    </div>
                }
                @if (objSchemaError is not null)
                {
                    <div class="field-err" data-testid="field-error">⚠ @objSchemaError</div>
                }
            </div>
            }
        </div>

        <SheetFooter>
            <SheetClose AsChild>
                <Button Variant="ButtonVariant.Outline" data-testid="btn-cancel">Cancel</Button>
            </SheetClose>
            <Button OnClick="SaveModelAsync" Disabled="@(objSchemaError is not null)" data-testid="btn-save">Save</Button>
        </SheetFooter>
    </SheetContent>
</Sheet>

@code {
    private List<RegistryRow> objRows = new();
    private List<ProviderKeyRow> objProviderKeys = new();
    private bool objLoading = true;

    private bool objSheetOpen;
    private bool objIsNew;
    private string objEditId = string.Empty;
    private string objEditName = string.Empty;
    private string? objEditTask;
    private string? objEditTier;
    private List<ParamRow> objParams = new();

    /// <summary>Chat-completion endpoint URL for a text-chat row (REQ-FN-074); ignored for generation models.</summary>
    private string objEditEndpoint = string.Empty;

    /// <summary>Underlying chat model name for a text-chat row (e.g. "gpt-4o").</summary>
    private string objEditChatModel = string.Empty;

    /// <summary>Whether the text-chat row accepts image attachments (vision-capable, BRD-90).</summary>
    private bool objEditVision;

    /// <summary>A newly entered API key for the text-chat row, stored write-only under the model id; empty leaves the stored key untouched.</summary>
    private string objEditApiKey = string.Empty;

    /// <summary>True while the edit sheet is showing a text-chat row, which swaps the params grid for the LLM fields.</summary>
    private bool objEditIsTextChat => string.Equals(objEditTask, "text-chat", StringComparison.Ordinal);

    /// <summary>The Venice provider card state (address, masked key, enabled, last test result) — REQ-UI-083.</summary>
    private readonly VeniceProviderState objVenice = new();

    /// <summary>The provider kind (enum name) chosen in the edit sheet — REQ-UI-084.</summary>
    private string? objEditProvider;

    /// <summary>The provider's own model id for the row (e.g. a Venice model id); typed by the admin, never hard-coded.</summary>
    private string objEditProviderModelId = string.Empty;

    /// <summary>Whether the row takes a reference picture (studios filter on it).</summary>
    private bool objEditTakesReference;

    /// <summary>Whether the row keeps a fixed character (studios filter on it).</summary>
    private bool objEditKeepsCharacter;

    /// <summary>The most input pictures the row accepts, as filled from Venice; null when not stated.</summary>
    private int? objEditMaxInputImages;

    /// <summary>The exact generation task filled from Venice; used on save over the coarse category mapping.</summary>
    private GenerationTaskType? objEditExactTask;

    /// <summary>True while a Fill-from-Venice lookup is in flight.</summary>
    private bool objFilling;

    /// <summary>Venice's own text when Fill from Venice fails; null otherwise.</summary>
    private string? objFillError;

    /// <summary>True when the edit sheet's provider is Venice, which enables Fill from Venice.</summary>
    private bool objEditIsVenice => string.Equals(objEditProvider, nameof(ProviderKind.Venice), StringComparison.Ordinal);

    /// <summary>Provider choices for the edit sheet (text-chat rows pin their own provider).</summary>
    private static readonly (string Value, string Label)[] objProviderOptions =
    {
        (nameof(ProviderKind.OnnxLocal), "local (Mac)"),
        (nameof(ProviderKind.ComfyUi), "ComfyUI"),
        (nameof(ProviderKind.RunPod), "RunPod"),
        (nameof(ProviderKind.HeyGen), "HeyGen"),
        (nameof(ProviderKind.ClosedApi), "Cloud API"),
        (nameof(ProviderKind.Voice), "Voice"),
        (nameof(ProviderKind.StubEcho), "Stub (dev)"),
        (nameof(ProviderKind.Venice), "Venice")
    };

    /// <summary>The full backing model being edited (preserves fields the sheet doesn't surface); null for a new row.</summary>
    private RegistryModel? objEditModel;

    /// <summary>Loaded registry models keyed by id so the edit sheet round-trips the real model, not a lossy view.</summary>
    private readonly Dictionary<string, RegistryModel> objModelsById = new();

    private readonly string[] objTaskOptions = { "avatar", "image", "video", "voice", "text-chat" };
    private readonly string[] objTypeOptions = { "file", "string", "int", "float", "bool", "enum", "image", "audio", "mask" };

    /// <summary>Validation message when a bool param has no default value; null when the schema is valid.</summary>
    private string? objSchemaError
    {
        get
        {
            var vBad = objParams.FirstOrDefault(aParam =>
                string.Equals(aParam.Type, "bool", StringComparison.Ordinal) && string.IsNullOrWhiteSpace(aParam.Default));
            return vBad is null ? null : $"\"{vBad.Key}\" — bool params need a default value.";
        }
    }

    /// <summary>
    /// Loads the registry and provider keys AFTER the first interactive render — once JS interop is
    /// available and <see cref="IAuthSession"/> can hydrate the bearer token. Loading here (not in
    /// <c>OnInitializedAsync</c>, which runs during prerender before the token exists) avoids a wasted
    /// anonymous 401 and the sample-row flash it used to cause.
    /// </summary>
    /// <param name="aFirstRender">Whether this is the component's first render.</param>
    protected override async Task OnAfterRenderAsync(bool aFirstRender)
    {
        if (!aFirstRender)
        {
            return;
        }

        var vHasSession = await AuthSession.EnsureLoadedAsync();
        await TryLoadRegistryAsync(vHasSession);
        objLoading = false;
        StateHasChanged();
    }

    /// <summary>
    /// Loads the owner/admin-scoped registry and provider keys. With no session both stay empty (the
    /// real empty state) rather than flashing sample rows or fake keys; a representative registry
    /// sample only stands in when the AUTHENTICATED registry call succeeds with zero rows. Provider
    /// keys are never seeded with sample values — masked keys must reflect real stored keys only.
    /// </summary>
    /// <param name="aHasSession">Whether a signed-in session is present.</param>
    private async Task TryLoadRegistryAsync(bool aHasSession)
    {
        if (!aHasSession)
        {
            return;
        }

        try
        {
            var vClient = HttpClientFactory.CreateClient("TrStudioApi");

            var vRegistry = await vClient.GetAsync(ApiRoutes.Registry);
            if (vRegistry.IsSuccessStatusCode)
            {
                var vModels = await vRegistry.Content.ReadFromJsonAsync<List<RegistryModel>>();
                objModelsById.Clear();
                foreach (var vModel in vModels ?? new List<RegistryModel>())
                {
                    objModelsById[vModel.Id] = vModel;
                }

                objRows = (vModels ?? new List<RegistryModel>()).Select(aModel => MapRow(aModel, objClosedApiLabel)).ToList();
            }

            var vKeys = await vClient.GetAsync(ApiRoutes.Providers + "/keys");
            if (vKeys.IsSuccessStatusCode)
            {
                var vInfos = await vKeys.Content.ReadFromJsonAsync<List<ProviderKeyInfo>>();
                // A text-chat row's key is stored under the row's id; it belongs to that row, not to this list.
                objRowKeyIds = (vInfos ?? new List<ProviderKeyInfo>())
                    .Where(aInfo => objModelsById.ContainsKey(aInfo.ProviderName))
                    .Select(aInfo => aInfo.ProviderName)
                    .ToHashSet(StringComparer.Ordinal);
                vInfos = vInfos?.Where(aInfo => !objRowKeyIds.Contains(aInfo.ProviderName)).ToList();
                var vVeniceInfo = vInfos?.FirstOrDefault(aInfo =>
                    string.Equals(aInfo.ProviderName, nameof(ProviderKind.Venice), StringComparison.OrdinalIgnoreCase));
                objVenice.Load(vVeniceInfo);
                vInfos = vInfos?.Where(aInfo => !ReferenceEquals(aInfo, vVeniceInfo)).ToList();
                // The raw secret never leaves the key store, so the password field starts empty
                // (placeholder "Enter a new key to replace") — a saved value only sends a NEW key.
                objProviderKeys = (vInfos ?? new List<ProviderKeyInfo>())
                    .Select(aInfo => new ProviderKeyRow(aInfo.ProviderName, string.Empty, aInfo.IsEnabled)
                    {
                        Stored = true,
                        MaskedKey = aInfo.MaskedKey,
                        Account = aInfo.Account,
                        StoredAccount = aInfo.Account
                    })
                    .ToList();

                // Phase 3 (REQ-FN-096): every key a user owns is entered here, so the known providers are
                // always listed, stored or not.
                foreach (var vKnown in KnownProviders)
                {
                    if (!objProviderKeys.Any(aRow => string.Equals(aRow.ProviderName, vKnown, StringComparison.OrdinalIgnoreCase)))
                    {
                        objProviderKeys.Add(new ProviderKeyRow(vKnown, string.Empty, true));
                    }
                }

                // The mockup's order: HeyGen, the closed-API aggregator, RunPod, then any other stored key.
                objProviderKeys = objProviderKeys
                    .OrderBy(aRow => KnownOrder(aRow.ProviderName))
                    .ToList();

                // The closed-API aggregator's vendor (its Account) names the table's provider column.
                var vClosed = objProviderKeys.FirstOrDefault(aRow => aRow.ProviderName == ClosedApiProvider);
                objClosedApiLabel = VendorLabel(vClosed?.Account);
                objRows = objRows.Select(aRow => MapRow(objModelsById[aRow.Id], objClosedApiLabel)).ToList();
            }

            var vNote = await vClient.GetAsync(ApiRoutes.Providers + "/protection");
            if (vNote.IsSuccessStatusCode)
            {
                objKeyNote = (await vNote.Content.ReadFromJsonAsync<KeyNoteLike>())?.Note;
            }
        }
        catch
        {
            // Endpoints not reachable / unauthenticated — keep the table and keys empty rather than
            // flashing sample rows.
        }
    }

    /// <summary>Maps a registry model onto a table row: the task category, the provider's own name and the safety class.</summary>
    /// <param name="aModel">The registry model.</param>
    /// <param name="aClosedApiLabel">The closed-API aggregator's display name (its vendor).</param>
    private static RegistryRow MapRow(RegistryModel aModel, string aClosedApiLabel)
    {
        var (vTier, vTierTone) = aModel.Tier switch
        {
            GenerationTier.Fast => ("fast", "badge-ok"),
            GenerationTier.High => ("high", "badge-brand"),
            _ => ("premium", "badge-primary")
        };
        var (vSafety, vSafetyTone) = SafetyOf(aModel);
        var vIsVenice = aModel.ProviderKind == ProviderKind.Venice;
        var vTaskText = TaskText(aModel.Task);
        var vSubtitle = !string.IsNullOrWhiteSpace(aModel.ProviderModelId)
            ? $"{aModel.ProviderModelId} · {vTaskText}"
            : vTaskText;
        var vProvider = aModel.ProviderKind == ProviderKind.ClosedApi
            ? aClosedApiLabel
            : aModel.ProviderKind == ProviderKind.TextLlm
            ? "Text LLM"
            : objProviderOptions.FirstOrDefault(aOption => aOption.Value == aModel.ProviderKind.ToString()).Label ?? aModel.ProviderKind.ToString();
        return new RegistryRow(aModel.Id, aModel.DisplayName, vSubtitle, CategoryFor(aModel.Task),
            vProvider, vTier, vTierTone, aModel.License, vSafety, vSafetyTone, vIsVenice);
    }

    /// <summary>
    /// The table's safety column: "gated" for a real-person-gated row, "consent" for a voice row (a voice is
    /// only cloned with the speaker's consent), "restricted" for a row whose license limits use
    /// (non-commercial, community or responsible-AI terms), otherwise "general".
    /// </summary>
    /// <param name="aModel">The registry model.</param>
    private static (string Label, string Tone) SafetyOf(RegistryModel aModel)
    {
        if (aModel.SafetyClass == SafetyClass.RealPersonGated)
        {
            return ("gated", "badge-warn");
        }

        if (aModel.Task == GenerationTaskType.TextToSpeech)
        {
            return ("consent", "badge-warn");
        }

        var vLicense = aModel.License ?? string.Empty;
        return RestrictiveLicenseWords.Any(aWord => vLicense.Contains(aWord, StringComparison.OrdinalIgnoreCase))
            ? ("restricted", "badge-warn")
            : ("general", "");
    }

    /// <summary>License words that mark a restricted use.</summary>
    private static readonly string[] RestrictiveLicenseWords = { "non-commercial", "community", "comm.", "openrail" };

    /// <summary>The row's task in words, shown under its name.</summary>
    private static string TaskText(GenerationTaskType aTask) => aTask switch
    {
        GenerationTaskType.LipSync => "lip-sync",
        GenerationTaskType.TextToImage => "text to image",
        GenerationTaskType.ImageToVideo => "image to video",
        GenerationTaskType.TextToVideo => "text to video",
        GenerationTaskType.TextToSpeech => "text to speech",
        GenerationTaskType.TextChat => "text chat",
        _ => aTask.ToString()
    };

    /// <summary>The rows the search box leaves (id, name, task, provider or license containing the text).</summary>
    private List<RegistryRow> VisibleRows => string.IsNullOrWhiteSpace(objSearch)
        ? objRows
        : objRows.Where(aRow => new[] { aRow.Id, aRow.Name, aRow.Task, aRow.Provider, aRow.License, aRow.Subtitle }
            .Any(aText => (aText ?? string.Empty).Contains(objSearch.Trim(), StringComparison.OrdinalIgnoreCase))).ToList();

    /// <summary>The next control name for a repeated badge: the first is the bare name, later ones -2, -3 …</summary>
    private static string NextId(Dictionary<string, int> aCounts, string aName)
    {
        aCounts[aName] = aCounts.TryGetValue(aName, out var vCount) ? vCount + 1 : 1;
        return aCounts[aName] <= 1 ? aName : $"{aName}-{aCounts[aName]}";
    }

    /// <summary>The closed-API aggregator's name for its vendor (the engine's default vendor is fal).</summary>
    private static string VendorLabel(string? aVendor) =>
        string.IsNullOrWhiteSpace(aVendor) || string.Equals(aVendor, "fal", StringComparison.OrdinalIgnoreCase) ? "fal.ai" : aVendor.Trim();

    /// <summary>The name a provider-key row shows.</summary>
    private string KeyLabel(ProviderKeyRow aRow) => aRow.ProviderName == ClosedApiProvider ? objClosedApiLabel : aRow.ProviderName;

    /// <summary>The provider-key row's part of its control names (e.g. heygen, fal-ai, runpod).</summary>
    private string KeySlug(ProviderKeyRow aRow) => KeyLabel(aRow).ToLowerInvariant().Replace(".", "-").Replace(" ", "-");

    /// <summary>The enabled switch's control name, as the mockup numbers them (HeyGen switch-5, fal.ai switch-6).</summary>
    private static string SwitchId(ProviderKeyRow aRow, string aSlug) => aRow.ProviderName switch
    {
        "HeyGen" => "switch-5",
        ClosedApiProvider => "switch-6",
        _ => $"switch-{aSlug}"
    };

    /// <summary>The enabled text-chat rows, in registry order.</summary>
    private List<RegistryModel> TextChatRows => objModelsById.Values
        .Where(aModel => aModel.Task == GenerationTaskType.TextChat && aModel.IsEnabled)
        .OrderBy(aModel => aModel.DisplayName, StringComparer.Ordinal)
        .ToList();

    /// <summary>True when the text-chat row can write scripts and captions: an address, a model and a stored key.</summary>
    private bool IsTextModelReady(RegistryModel aModel) =>
        !string.IsNullOrWhiteSpace(aModel.Endpoint) && !string.IsNullOrWhiteSpace(aModel.ChatModel) && objRowKeyIds.Contains(aModel.Id);

    /// <summary>The row scripts and captions use (the first ready one), else the first enabled row.</summary>
    private string? TextModelInUse => (TextChatRows.FirstOrDefault(IsTextModelReady) ?? TextChatRows.FirstOrDefault())?.Id;

    private string TextModelLabel(RegistryModel aModel) =>
        IsTextModelReady(aModel) ? aModel.DisplayName : $"{aModel.DisplayName} (not set up)";

    /// <summary>True for the bool param the schema check stops on.</summary>
    private static bool IsBadParam(ParamRow aParam) =>
        string.Equals(aParam.Type, "bool", StringComparison.Ordinal) && string.IsNullOrWhiteSpace(aParam.Default);

