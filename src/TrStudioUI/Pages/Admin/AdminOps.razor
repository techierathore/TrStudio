@page "/admin/ops"
@inject IHttpClientFactory HttpClientFactory
@inject ToastService ToastService
@inject IAuthSession AuthSession
@using Microsoft.AspNetCore.Components.Sections

@*
    Admin RunPod & ops (REQ-UI-073). Spend guardrail cards (RunPod GPU, closed APIs, total vs the
    monthly cap) with near-cap Alert, a RunPod control card (start/stop, auto-idle-stop Switch,
    cold-start Badge, and a clean "not configured" state), worker-health + queue-depth cards, and a
    filterable generation-log DataTable with one-click reproduce. Live-only: /admin/ops supplies the
    spend + worker/queue/error snapshot, /admin/runpod the control card and the generation-log
    endpoint the table — no representative fallback; an unreachable API raises a warning Alert.
*@

<PageTitle>TrStudio — RunPod &amp; Ops</PageTitle>

@* The spend ledger counts the calendar month (UTC), so the billing cycle is this month's first to last day. *@
<SectionContent SectionName="topbar-context">
    <Badge Variant="BadgeVariant.Outline" data-testid="badge-billing-cycle-jun-1-jun">Billing cycle: @BillingCycle</Badge>
</SectionContent>

<div class="stack ops-page" style="max-width:1100px">
    <div>
        <h1 class="page-title">RunPod &amp; Ops</h1>
        <p class="page-sub" style="margin-bottom:0">
            Spend guardrails across RunPod and closed APIs, worker health, and the generation log.
            The monthly cap spans all providers.
        </p>
    </div>

    @if (objApiDown)
    {
        <div data-testid="api-down-alert">
            <Alert Variant="AlertVariant.Warning" AccentBorder="true">
                <LucideIcon Name="circle-alert" Size="16" />
                <AlertTitle>Couldn't reach the API — data unavailable</AlertTitle>
                <AlertDescription>Spend, worker health and the generation log couldn't be loaded. Check that TrStudioApi is running and reload.</AlertDescription>
            </Alert>
        </div>
    }

    @if (objSpend is not null && objSpend.CapPct >= 80)
    {
        <div>
            <Alert Variant="@(objSpend.CapPct >= 95 ? AlertVariant.Danger : AlertVariant.Warning)" AccentBorder="true" data-testid="alert-warn">
                <AlertTitle>Approaching monthly cap</AlertTitle>
                <AlertDescription>
                    Total spend is at @objSpend.CapPct.ToString("0")% of the @Money(objSpend.MonthlyCap) cap —
                    per-job estimates are now enforced before every run.
                </AlertDescription>
            </Alert>
        </div>
    }

    @if (objSpendLoading)
    {
        <div class="ops-grid-3">
            @for (var vIndex = 0; vIndex < 3; vIndex++)
            {
                <Card>
                    <CardContent Class="pt-6">
                        <Skeleton Class="h-4 w-1/2 mb-3" />
                        <Skeleton Class="h-6 w-2/3 mb-2" />
                        <Skeleton Class="h-2 w-full mb-2" />
                        <Skeleton Class="h-3 w-4/5" />
                    </CardContent>
                </Card>
            }
        </div>
    }
    else if (objSpend is not null)
    {
        <div class="ops-grid-3">
            <Card data-testid="card-1">
                <CardContent Class="pt-6">
                    <div class="flex-between">
                        <span class="kpi-lbl">RunPod (GPU)</span>
                        <Badge Variant="BadgeVariant.Outline" data-testid="badge-this-cycle">this cycle</Badge>
                    </div>
                    <div class="kpi-big">@Money(objSpend.RunPodSpend)</div>
                    <Progress Value="@Pct(objSpend.RunPodSpend, objSpend.MonthlyCap)" Class="ops-prog" IndicatorClass="hw-ind" data-testid="progress" />
                    <div class="kpi-lbl" style="margin-top:6px">GPU serverless compute</div>
                </CardContent>
            </Card>
            <Card data-testid="card-2">
                <CardContent Class="pt-6">
                    <div class="flex-between">
                        <span class="kpi-lbl">Closed APIs</span>
                        <Badge Variant="BadgeVariant.Outline" data-testid="badge-heygen-fal-ai">HeyGen · fal.ai</Badge>
                    </div>
                    <div class="kpi-big">@Money(objSpend.ClosedApiSpend)</div>
                    <Progress Value="@Pct(objSpend.ClosedApiSpend, objSpend.MonthlyCap)" Class="ops-prog" IndicatorClass="hw-ind" data-testid="progress-2" />
                    <div class="kpi-lbl" style="margin-top:6px">Metered per-call generation keys</div>
                </CardContent>
            </Card>
            <Card data-testid="card-3">
                <CardContent Class="pt-6">
                    <div class="flex-between">
                        <span class="kpi-lbl">Total vs @Money(objSpend.MonthlyCap) cap</span>
                        <Badge Variant="BadgeVariant.Outline" Class="@(objSpend.CapPct >= 80 ? "badge-warn" : "badge-ok")" data-testid="badge-88">
                            @objSpend.CapPct.ToString("0")%
                        </Badge>
                    </div>
                    <div class="kpi-big" style="@(objSpend.CapPct >= 80 ? "color:var(--alert-warning)" : "")">@Money(objSpend.TotalSpend)</div>
                    <Progress Value="@objSpend.CapPct" Class="ops-prog" IndicatorClass="@(objSpend.CapPct >= 80 ? "ops-warnfill" : "hw-ind")" data-testid="progress-3" />
                    <div class="kpi-lbl" style="margin-top:6px">@Money(objSpend.Remaining) remaining</div>
                </CardContent>
            </Card>
        </div>
    }

    <div class="ops-grid-2">
        <Card data-testid="card-runpod-control">
            <CardContent Class="pt-6">
                @if (objRunPodLoading)
                {
                    <Skeleton Class="h-4 w-1/3 mb-3" />
                    <Skeleton Class="h-8 w-full mb-2" />
                    <Skeleton Class="h-3 w-2/3" />
                }
                else if (objRunPod is { Configured: true })
                {
                    <div class="flex-between">
                        <h3 class="card-h3" style="margin:0">RunPod control</h3>
                        <Badge Variant="BadgeVariant.Outline" Class="@objRunPod.StateTone" data-testid="badge-status">
                            <span class="dot @objRunPod.StateDot"></span> @objRunPod.WorkerState
                        </Badge>
                    </div>

                    <div class="flex-row" style="margin:14px 0 6px;align-items:flex-start">
                        <div class="flex-col grow" style="gap:2px">
                            <span style="font-weight:600;font-size:13px">Auto idle-stop</span>
                            <span class="kpi-lbl">Scale endpoint to zero after 60s idle</span>
                        </div>
                        <Switch Checked="objRunPod.AutoIdleStop" CheckedChanged="SetAutoIdleStopAsync" AriaLabel="Auto idle-stop" data-testid="switch" />
                    </div>
                    <Separator />
                    <div class="flex-row" style="margin-top:12px;align-items:flex-start">
                        <div class="flex-col grow" style="gap:2px">
                            <span style="font-weight:600;font-size:13px">Endpoint state</span>
                            <span class="kpi-lbl">@objRunPod.EndpointName · serverless</span>
                        </div>
                        <Button OnClick="StartEndpointAsync" data-testid="btn-start-endpoint">Start endpoint</Button>
                        <Button Variant="ButtonVariant.Outline" OnClick="StopEndpointAsync" data-testid="btn-stop">Stop</Button>
                    </div>

                    @if (objRunPod.Unreachable)
                    {
                        <div style="margin-top:12px">
                            <Alert Variant="AlertVariant.Default" Class="ops-alert-info" data-testid="alert-info">
                                <AlertDescription>
                                    RunPod's health check didn't answer for this endpoint — check the endpoint id and API key.
                                    <Badge Variant="BadgeVariant.Outline" Class="badge-warn" data-testid="badge-starting">unreachable</Badge>
                                </AlertDescription>
                            </Alert>
                        </div>
                    }
                    else if (objRunPod.ColdStart)
                    {
                        <div style="margin-top:12px">
                            <Alert Variant="AlertVariant.Default" Class="ops-alert-info" data-testid="alert-info">
                                <AlertDescription>
                                    Endpoint is scaled to zero — the next request pays a cold-start penalty.
                                    <Badge Variant="BadgeVariant.Outline" Class="badge-warn" data-testid="badge-starting">cold</Badge>
                                </AlertDescription>
                            </Alert>
                        </div>
                    }
                }
                else
                {
                    <div class="flex-between">
                        <h3 class="card-h3" style="margin:0">RunPod control</h3>
                        <Badge Variant="BadgeVariant.Outline">not configured</Badge>
                    </div>
                    <div data-testid="runpod-unconfigured" style="margin-top:12px">
                        <Alert Variant="AlertVariant.Default">
                            <LucideIcon Name="cloud-off" Size="16" />
                            <AlertTitle>RunPod not configured</AlertTitle>
                            <AlertDescription>
                                No RunPod serverless endpoint is attached. Add a RunPod API key and endpoint id
                                under the environment settings to enable GPU offload — until then, generation runs
                                on local and closed-API providers only.
                            </AlertDescription>
                        </Alert>
                    </div>
                }
            </CardContent>
        </Card>

        <Card data-testid="card-worker-health">
            <CardContent Class="pt-6">
                <h3 class="card-h3">Worker health</h3>
                @if (objOps is null)
                {
                    <div class="kpi-lbl" style="margin-top:8px">
                        Live worker/queue snapshot unavailable — it loads from /api/v1/admin/ops.
                    </div>
                }
                else
                {
                    <div class="kv-row">
                        <span class="kv-lbl">Status</span>
                        <Badge Variant="BadgeVariant.Outline" Class="@(objOps.Healthy ? "badge-ok" : "badge-warn")" data-testid="badge-status-2">
                            <span class="dot @(objOps.Healthy ? "ok" : "warn")"></span> @(objOps.Healthy ? "healthy" : "no recent heartbeat")
                        </Badge>
                    </div>
                    <div class="kv-row">
                        <span class="kv-lbl">Worker servers</span>
                        <b>@objOps.Workers.Count · @objOps.Workers.Sum(aWorker => aWorker.WorkerCount) workers</b>
                    </div>
                    <div class="kv-row">
                        <span class="kv-lbl">Queue depth</span>
                        <Badge Variant="BadgeVariant.Outline" Class="badge-brand" data-testid="badge-2-jobs">@objOps.Queue.TotalEnqueued queued · @objOps.Queue.TotalProcessing running</Badge>
                    </div>
                    <div class="kv-row">
                        <span class="kv-lbl">Error rate (@(objOps.Errors.WindowHours)h)</span>
                        <Badge Variant="BadgeVariant.Outline" Class="@(objOps.Errors.ErrorRatePct > 5 ? "badge-warn" : "badge-ok")" data-testid="badge-0-8">
                            @objOps.Errors.ErrorRatePct.ToString("0.0")%
                        </Badge>
                    </div>
                    <div class="kv-row">
                        <span class="kv-lbl">Outcomes in window</span>
                        <b>@objOps.Errors.Succeeded ok · @objOps.Errors.Failed failed · @objOps.Errors.Blocked blocked</b>
                    </div>
                    @if (AvgLatency is { } vLatency)
                    {
                        <div class="kv-row">
                            <span class="kv-lbl">Avg job latency</span>
                            <b>@vLatency</b>
                        </div>
                    }
                }
            </CardContent>
        </Card>
    </div>

    <Card Class="p-0" data-testid="card-generation-log">
        <div class="flex-between" style="padding:14px 16px;gap:12px">
            <h3 class="card-h3" style="margin:0;white-space:nowrap">Generation log</h3>
            <Input @bind-Value="objLogFilter" Placeholder="Filter by user / model…" Class="ops-log-filter" aria-label="Filter by user or model" data-testid="field-filter-by-user-model" />
        </div>
        <div class="table-scroll">
            <DataTable TData="LogRow" Data="@FilteredLog" IsLoading="@objLogLoading" ShowToolbar="false" InitialPageSize="10" data-testid="table-1">
                <Columns>
                    <DataTableColumn TData="LogRow" TValue="string" Property="@(r => r.User)" Header="User" />
                    <DataTableColumn TData="LogRow" TValue="string" Property="@(r => r.Model)" Header="Model" />
                    <DataTableColumn TData="LogRow" TValue="string" Property="@(r => r.Params)" Header="Params" />
                    <DataTableColumn TData="LogRow" TValue="string" Property="@(r => r.Cost)" Header="Cost" />
                    <DataTableColumn TData="LogRow" TValue="string" Property="@(r => r.Duration)" Header="Duration" />
                    <DataTableColumn TData="LogRow" TValue="string" Property="@(r => r.Outcome)" Header="Outcome">
                        <CellTemplate Context="objRow">
                            <Badge Variant="BadgeVariant.Outline" Class="@objRow.OutcomeTone" data-testid="@objRow.OutcomeTestId">@objRow.Outcome</Badge>
                        </CellTemplate>
                    </DataTableColumn>
                    <DataTableColumn TData="LogRow" TValue="string" Property="@(r => r.Model)" Header="">
                        <CellTemplate Context="objRow">
                            <Button Size="ButtonSize.Small" Variant="ButtonVariant.Outline" Class="ops-reproduce" OnClick="@(() => ReproduceAsync(objRow))" data-testid="@objRow.ReproduceTestId">
                                Reproduce
                            </Button>
                        </CellTemplate>
                    </DataTableColumn>
                </Columns>
            </DataTable>
        </div>
    </Card>
</div>

@*
    Mobile reflow (REQ-UI-073). The .stack shell is a CSS grid, and grid cells default to
    min-width:auto — so the wide generation-log DataTable forced the whole page past the viewport
    (~823px at 390px). Allowing the direct cells to shrink lets the table scroll inside its own
    .table-scroll container (page never scrolls horizontally), matching the min-width:0 pattern the
    other admin grids (registry-layout / ops-grid / models-layout) already use. Desktop is unchanged.
*@
<style>
    .ops-page > * {
        min-width: 0;
    }

    .ops-page .ops-log-filter {
        max-width: 220px;
    }

    @@media (max-width: 430px) {
        .ops-page .ops-grid-3,
        .ops-page .ops-grid-2 {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private SpendSummary? objSpend;
    private RunPodView? objRunPod;
    private OpsDashboardResponse? objOps;
    private List<LogRow> objLogRows = new();
    private string objLogFilter = string.Empty;

    private bool objSpendLoading = true;
    private bool objRunPodLoading = true;
    private bool objLogLoading = true;
    private bool objApiDown;
    private double objLatencyMs = -1;

    /// <summary>The generation-log rows narrowed by the free-text user/model filter.</summary>
    private IEnumerable<LogRow> FilteredLog => string.IsNullOrWhiteSpace(objLogFilter)
        ? objLogRows
        : objLogRows.Where(aRow =>
            aRow.User.Contains(objLogFilter, StringComparison.OrdinalIgnoreCase) ||
            aRow.Model.Contains(objLogFilter, StringComparison.OrdinalIgnoreCase));

    /// <summary>
    /// Loads spend, RunPod status and the generation log AFTER the first interactive render — once
    /// JS interop is available and <see cref="IAuthSession"/> can hydrate the bearer token, so the
    /// owner-scoped calls carry the token instead of racing prerender with an anonymous 401.
    /// </summary>
    /// <param name="aFirstRender">Whether this is the component's first render.</param>
    protected override async Task OnAfterRenderAsync(bool aFirstRender)
    {
        if (!aFirstRender)
        {
            return;
        }

        var vHasSession = await AuthSession.EnsureLoadedAsync();
        await LoadAsync(vHasSession);
        objSpendLoading = false;
        objRunPodLoading = false;
        objLogLoading = false;
        StateHasChanged();
    }

    /// <summary>
    /// Loads the live ops data: the /admin/ops snapshot (spend + worker/queue/error health), the
    /// /admin/runpod control state and the generation log. Nothing is seeded — failures leave the
    /// cards in their honest unavailable states and raise the API-down Alert.
    /// </summary>
    /// <param name="aHasSession">Whether a signed-in session is present.</param>
    private async Task LoadAsync(bool aHasSession)
    {
        if (!aHasSession)
        {
            return;
        }

        var vClient = HttpClientFactory.CreateClient("TrStudioApi");

        try
        {
            var vOps = await vClient.GetAsync(ApiRoutes.AdminOps);
            if (vOps.IsSuccessStatusCode)
            {
                objOps = await vOps.Content.ReadFromJsonAsync<OpsDashboardResponse>();
                if (objOps is not null)
                {
                    objSpend = MapSpend(objOps.Spend);
                }
            }
            else
            {
                objApiDown = true;
            }
        }
        catch
        {
            // API unreachable — never fake data; the warning Alert renders instead.
            objApiDown = true;
        }

        try
        {
            var vRunPod = await vClient.GetAsync("/api/v1/admin/runpod");
            if (vRunPod.IsSuccessStatusCode)
            {
                var vStatus = await vRunPod.Content.ReadFromJsonAsync<RunPodStatusResponse>();
                if (vStatus is not null)
                {
                    objRunPod = new RunPodView
                    {
                        Configured = vStatus.Configured,
                        AutoIdleStop = vStatus.AutoIdleStop,
                        WorkerState = vStatus.WorkerState,
                        EndpointName = vStatus.EndpointId ?? "endpoint",
                        ColdStart = vStatus.ColdStart,
                        Unreachable = string.Equals(vStatus.WorkerState, "unreachable", StringComparison.OrdinalIgnoreCase),
                    };
                }
            }
        }
        catch
        {
            // RunPod status unreachable — the control card renders its "not configured" state.
            objApiDown = true;
        }

        try
        {
            var vLog = await vClient.GetAsync($"{ApiRoutes.GenerationLog}?aPage=1&aPageSize=25");
            if (vLog.IsSuccessStatusCode)
            {
                var vPage = await vLog.Content.ReadFromJsonAsync<PagedResult<GenerationLogEntry>>();
                objLogRows = NameRows((vPage?.Items ?? Array.Empty<GenerationLogEntry>()).Select(MapLog).ToList());
                objLatencyMs = (vPage?.Items ?? Array.Empty<GenerationLogEntry>())
                    .Where(aEntry => aEntry.DurationMs is > 0 && aEntry.CreatedUtc >= DateTime.UtcNow.AddHours(-24))
                    .Select(aEntry => (double)aEntry.DurationMs!.Value)
                    .DefaultIfEmpty(-1).Average();
            }
        }
        catch
        {
            // Log unreachable — the table stays honestly empty.
            objApiDown = true;
        }
    }

    /// <summary>Maps the live spend summary onto the guardrail-card view (per-channel + cap).</summary>
    /// <param name="aSpend">The instance month-to-date spend snapshot.</param>
    private static SpendSummary MapSpend(SpendSummaryResponse aSpend) => new()
    {
        RunPodSpend = ChannelTotal(aSpend, "RunPod"),
        ClosedApiSpend = ChannelTotal(aSpend, "ClosedApi"),
        TotalSpend = aSpend.SpentToDateUsd,
        MonthlyCap = aSpend.MonthlyCapUsd,
        Remaining = aSpend.RemainingUsd,
    };

    /// <summary>Reads one channel's month-to-date total from the by-channel map (case-insensitive).</summary>
    private static decimal ChannelTotal(SpendSummaryResponse aSpend, string aChannel) =>
        aSpend.ByChannel.FirstOrDefault(aPair => string.Equals(aPair.Key, aChannel, StringComparison.OrdinalIgnoreCase)).Value;

    private static LogRow MapLog(GenerationLogEntry aEntry)
    {
        var vCost = aEntry.ActualCost ?? aEntry.CostEstimate;
        var (vOutcome, vTone) = OutcomeTone(aEntry.Outcome);
        return new LogRow(
            aEntry.LogId,
            aEntry.Outcome,
            Shorten(aEntry.UserId),
            aEntry.ModelId,
            $"{aEntry.Tier.ToString().ToLowerInvariant()} · {SummariseParams(aEntry.ParamsJson)}",
            vCost is null ? "—" : Money(vCost.Value),
            aEntry.DurationMs is null ? "—" : FormatDuration(aEntry.DurationMs.Value),
            vOutcome,
            vTone);
    }

    private async Task ReproduceAsync(LogRow aRow)
    {
        var vClient = HttpClientFactory.CreateClient("TrStudioApi");
        try
        {
            var vResponse = await vClient.PostAsync($"{ApiRoutes.GenerationLog}/{aRow.LogId}/reproduce", content: null);
            if (vResponse.IsSuccessStatusCode)
            {
                ToastService.Success($"Re-queued \"{aRow.Model}\" from the log.", "Reproduce");
                return;
            }
        }
        catch
        {
            // Fall through to the honest failure toast.
        }

        ToastService.Error($"Couldn't reach the API — \"{aRow.Model}\" wasn't re-queued.", "Generation log");
    }

    /// <summary>Saves the auto idle-stop toggle; on failure the switch returns to its saved value.</summary>
    /// <param name="aEnabled">The new toggle value.</param>
    private async Task SetAutoIdleStopAsync(bool aEnabled)
    {
        if (objRunPod is null)
        {
            return;
        }

        var vPrevious = objRunPod.AutoIdleStop;
        objRunPod.AutoIdleStop = aEnabled;
        try
        {
            var vClient = HttpClientFactory.CreateClient("TrStudioApi");
            var vResponse = await vClient.PostAsync($"{ApiRoutes.RunPod}/auto-idle-stop?enabled={(aEnabled ? "true" : "false")}", content: null);
            if (vResponse.IsSuccessStatusCode)
            {
                ToastService.Success(aEnabled ? "Auto idle-stop is on." : "Auto idle-stop is off.", "RunPod");
                return;
            }
        }
        catch
        {
            // Fall through to the honest failure toast.
        }

        objRunPod.AutoIdleStop = vPrevious;
        ToastService.Error("Couldn't reach the API — auto idle-stop wasn't changed.", "RunPod");
    }

    private Task StartEndpointAsync() => ControlRunPodAsync("start", "Endpoint start requested.");

    private Task StopEndpointAsync() => ControlRunPodAsync("stop", "Endpoint stop requested.");

    private async Task ControlRunPodAsync(string aAction, string aFallbackMessage)
    {
        var vClient = HttpClientFactory.CreateClient("TrStudioApi");
        try
        {
            var vResponse = await vClient.PostAsync($"/api/v1/admin/runpod/{aAction}", content: null);
            if (vResponse.IsSuccessStatusCode)
            {
                ToastService.Success(aFallbackMessage, "RunPod");
                return;
            }
        }
        catch
        {
            // Fall through to the honest failure toast.
        }

        ToastService.Error($"Couldn't reach the API — the {aAction} request wasn't sent.", "RunPod");
    }

    private static (string, string) OutcomeTone(string aOutcome) => aOutcome.ToLowerInvariant() switch
    {
        "succeeded" or "success" => ("success", "badge-ok"),
        "capped" => ("capped", "badge-warn"),
        "blocked" => ("blocked", "badge-warn"),
        "cancelled" => ("cancelled", ""),
        _ => ("failed", "badge-danger")
    };

    private static string SummariseParams(string aParamsJson)
    {
        if (string.IsNullOrWhiteSpace(aParamsJson))
        {
            return "—";
        }

        var vTrimmed = aParamsJson.Trim().Trim('{', '}').Trim();
        return vTrimmed.Length > 40 ? vTrimmed[..40] + "…" : (vTrimmed.Length == 0 ? "—" : vTrimmed);
    }

    private static string Shorten(string aUserId) =>
        aUserId.Length > 12 ? aUserId[..12] + "…" : aUserId;

    private static string FormatDuration(long aMs)
    {
        var vSeconds = aMs / 1000.0;
        if (vSeconds < 60)
        {
            return $"{vSeconds:0.0}s";
        }

        var vMinutes = (int)(vSeconds / 60);
        var vRest = (int)(vSeconds % 60);
        return $"{vMinutes}m {vRest}s";
    }

    private static string Money(decimal aAmount) => $"${aAmount:0.00}";

    private static double Pct(decimal aValue, decimal aCap) =>
        aCap <= 0 ? 0 : (double)(aValue / aCap) * 100.0;

    /// <summary>Spend-to-date summary across RunPod and closed APIs against the monthly cap.</summary>
    private sealed class SpendSummary
    {
        public decimal RunPodSpend { get; set; }
        public decimal ClosedApiSpend { get; set; }
        public decimal TotalSpend { get; set; }
        public decimal MonthlyCap { get; set; }
        public decimal Remaining { get; set; }

        /// <summary>Total spend as a percentage of the monthly cap (0 when no cap is set).</summary>
        public double CapPct => MonthlyCap <= 0 ? 0 : (double)(TotalSpend / MonthlyCap) * 100.0;
    }

    /// <summary>RunPod serverless endpoint status for the control card (from RunPodStatusResponse).</summary>
    private sealed class RunPodView
    {
        public bool Configured { get; set; }
        public bool AutoIdleStop { get; set; }
        public string WorkerState { get; set; } = "not-configured";
        public string EndpointName { get; set; } = "endpoint";
        public bool ColdStart { get; set; }

        /// <summary>Whether RunPod's health check failed for the configured endpoint.</summary>
        public bool Unreachable { get; set; }

        /// <summary>Badge tone reflecting whether the endpoint is warm, cold or scaled to zero.</summary>
        public string StateTone => ColdStart || Unreachable ? "badge-warn" : "badge-ok";

        /// <summary>Status-dot tone paired with <see cref="StateTone"/>.</summary>
        public string StateDot => ColdStart || Unreachable ? "warn" : "ok";
    }

    private sealed record LogRow(
        Guid LogId, string RawOutcome, string User, string Model, string Params, string Cost, string Duration,
        string Outcome, string OutcomeTone)
    {
        /// <summary>The outcome badge's control name: badge-&lt;outcome&gt;, numbered from the second of a kind.</summary>
        public string OutcomeTestId { get; set; } = string.Empty;

        /// <summary>The Reproduce button's control name: btn-reproduce, numbered from the second row.</summary>
        public string ReproduceTestId { get; set; } = string.Empty;
    }

    /// <summary>
    /// Gives each log row its mockup control names in list order: the Reproduce buttons are numbered
    /// btn-reproduce, btn-reproduce-2, …, and each outcome's badges badge-success, badge-success-2, ….
    /// </summary>
    private static List<LogRow> NameRows(List<LogRow> aRows)
    {
        var vSeen = new Dictionary<string, int>();
        for (var vIndex = 0; vIndex < aRows.Count; vIndex++)
        {
            var vRow = aRows[vIndex];
            var vCount = vSeen[vRow.Outcome] = vSeen.GetValueOrDefault(vRow.Outcome) + 1;
            vRow.OutcomeTestId = vCount == 1 ? $"badge-{vRow.Outcome}" : $"badge-{vRow.Outcome}-{vCount}";
            vRow.ReproduceTestId = vIndex == 0 ? "btn-reproduce" : $"btn-reproduce-{vIndex + 1}";
        }

        return aRows;
    }

    /// <summary>The billing cycle the spend ledger counts: this calendar month (UTC), e.g. "Nov 1 – Nov 30".</summary>
    private static string BillingCycle
    {
        get
        {
            var vNow = DateTime.UtcNow;
            var vMonth = System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetAbbreviatedMonthName(vNow.Month);
            return $"{vMonth} 1 – {vMonth} {DateTime.DaysInMonth(vNow.Year, vNow.Month)}";
        }
    }

    /// <summary>Average duration of the logged jobs in the last 24 h, or null when none ran.</summary>
    private string? AvgLatency => objLatencyMs < 0 ? null : FormatDuration((long)objLatencyMs);
}
