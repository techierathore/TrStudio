@page "/admin/comfy/import"
@page "/admin/comfy/debug"
@using System.Text
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using TrBlazeUI.Components.NativeSelect
@using Microsoft.AspNetCore.Components.Sections
@inject IHttpClientFactory HttpClientFactory
@inject ToastService ToastService
@inject IAuthSession AuthSession

@*
    ComfyUI import & debug (REQ-UI-072). Import an API-format workflow (drop-zone FileUpload or paste
    Textarea), parse it into a nodes DataTable, map each literal node input to a declarative registry
    param (key/type/required/default rows that persist edits), smoke-test the graph with a per-node
    run/debug panel (status list + WebSocket-preview placeholder + Progress + the exact /prompt JSON
    that will be sent), surface missing custom-node dependencies with an Install action, then save the
    known-good graph as a registry model with a pinned version. Follows the enrich-or-seed pattern:
    JSON is parsed client-side (so invalid JSON always surfaces a parse Alert), and the Phase-6 comfy
    endpoints enrich the run/save round-trips when an admin session and a configured ComfyUI exist.
*@

<PageTitle>TrStudio — ComfyUI Import &amp; Debug</PageTitle>

<SectionContent SectionName="topbar-context">
    @if (!string.IsNullOrWhiteSpace(objWorkflowName))
    {
        <Badge Variant="BadgeVariant.Outline" Class="comfy-mono" data-testid="badge-workflow-sdxl-portrait-a">workflow: @objWorkflowName</Badge>
    }
</SectionContent>

<div style="margin-bottom:14px">
        <h1 class="page-title">ComfyUI Import &amp; Debug</h1>
        <p class="page-sub" style="margin-bottom:0">
            Import an API-format workflow, map inputs to registry params, smoke-test, then save as a
            registry model. The graph stays hidden from end users.
        </p>
</div>

    <div class="comfy-work comfy-page">
        @* ---- LEFT: import ---- *@
        <div class="comfy-col">
            <Card Class="comfy-card" data-testid="card-import-workflow">
                <h3 class="card-h3">Import workflow</h3>

                <div class="comfy-drop">
                    ⬆ Drag &amp; drop <b>workflow_api.json</b><br><span style="font-size:12px">or click to browse</span>
                    <InputFile OnChange="OnFileChosenAsync" accept=".json,application/json" class="comfy-drop-input" aria-label="Workflow file" />
                </div>

                <div class="comfy-divider">— or paste JSON —</div>

                <Textarea @bind-Value="objWorkflowJson" Class="comfy-mono" Rows="8"
                          Placeholder="Paste workflow_api.json…" data-testid="field-1" />

                <Button Variant="ButtonVariant.Outline" OnClick="ParseWorkflow"
                        Class="w-full justify-center mt-2" data-testid="btn-parse-workflow">
                    Parse workflow
                </Button>

                @if (objParseError is not null)
                {
                    <div style="margin-top:10px">
                        <Alert Variant="AlertVariant.Danger" AccentBorder="true">
                            <AlertTitle>Invalid workflow JSON</AlertTitle>
                            <AlertDescription>@objParseError</AlertDescription>
                        </Alert>
                    </div>
                }
                else if (objParsed)
                {
                    <div style="margin-top:10px">
                        <Alert Variant="AlertVariant.Info" AccentBorder="true" data-testid="alert-info">
                            <AlertDescription>
                                Parsed <b>@objNodes.Count nodes</b> · @objMapping.Count parameterizable
                                input@(objMapping.Count == 1 ? "" : "s") @(objFromStore ? "mapped" : "detected").
                            </AlertDescription>
                        </Alert>
                    </div>
                }
            </Card>

        </div>

        @* ---- CENTER: input -> registry param mapping ---- *@
        <Card Class="comfy-card" data-testid="card-input-registry-param-mapping">
            <div class="flex-between">
                <h3 class="card-h3" style="margin:0">Input → registry param mapping</h3>
                <Badge Variant="BadgeVariant.Outline" Class="badge-brand" data-testid="badge-4-inputs">@objMapping.Count input@(objMapping.Count == 1 ? "" : "s")</Badge>
            </div>

            @if (objMapping.Count == 0)
            {
                <p class="muted-sm" style="margin-top:12px">
                    Parse a workflow to detect its parameterizable inputs.
                </p>
            }
            else
            {
                <div class="table-scroll" style="margin-top:10px">
                    <table class="comfy-map-table" data-testid="table-1">
                        <thead>
                            <tr>
                                <th>node input</th><th>param key</th><th>type</th><th>req</th><th>default</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var vIndex = 0; vIndex < objMapping.Count; vIndex++)
                            {
                                var vRow = objMapping[vIndex];
                                var vBase = 2 + 3 * vIndex;
                                <tr>
                                    <td>
                                        <span class="comfy-mono">@vRow.NodeInput</span>
                                        <div class="comfy-node-sub">@vRow.ClassType</div>
                                    </td>
                                    <td><Input @bind-Value="vRow.ParamKey" Placeholder="key" data-testid="@($"field-{vBase}")" /></td>
                                    <td>
                                        <NativeSelect TValue="string" @bind-Value="vRow.Type" aria-label="Type" data-testid="@($"field-{vBase + 1}")">
                                            @foreach (var vType in TypeOptionsFor(vRow.Type))
                                            {
                                                <option value="@vType">@vType</option>
                                            }
                                        </NativeSelect>
                                    </td>
                                    <td><Switch @bind-Checked="vRow.Required" AriaLabel="Required" data-testid="@(vIndex == 0 ? "switch" : $"switch-{vIndex + 1}")" /></td>
                                    <td><Input @bind-Value="vRow.Default" Placeholder="—" data-testid="@($"field-{vBase + 2}")" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </Card>

        @* ---- RIGHT: run / debug ---- *@
        <div class="comfy-col">
            <Card Class="comfy-card" data-testid="card-run-debug">
                <div class="flex-between">
                    <h3 class="card-h3" style="margin:0">Run / debug</h3>
                    <Button OnClick="RunAsync" Disabled="@(!objParsed || objRunning)" data-testid="btn-run">▶ Run</Button>
                </div>

                @if (!objComfyConfigured)
                {
                    <div style="margin-top:10px">
                        <Alert Variant="AlertVariant.Info">
                            <AlertTitle>ComfyUI not configured</AlertTitle>
                            <AlertDescription>
                                No reachable ComfyUI host for this instance — configure one in Hardware
                                &amp; Setup to stream a live smoke-test. You can still map inputs and
                                preview the exact request below.
                            </AlertDescription>
                        </Alert>
                    </div>
                }

                @if (objRunNotReached is not null)
                {
                    @* Owner run 15 Nov 2026: an unreachable debug service is said plainly; no node results are invented. *@
                    <div style="margin-top:10px" data-testid="alert-run-not-reached">
                        <Alert Variant="AlertVariant.Danger" AccentBorder="true">
                            <AlertTitle>Debug service not reached</AlertTitle>
                            <AlertDescription>@objRunNotReached</AlertDescription>
                        </Alert>
                    </div>
                }

                @if (objHasRun)
                {
                    @if (objComfyConfigured)
                    {
                        <div class="comfy-preview">live WebSocket preview</div>
                        <Progress Value="@objProgress" Class="h-2" data-testid="progress" />
                    }
                    <div class="muted-sm" style="margin:8px 0">@objRunCaption</div>
                    var vErrNamed = false;
                    @foreach (var vStat in objStatuses)
                    {
                        <div class="comfy-nstat">
                            @if (vStat.State == "err" && !vErrNamed)
                            {
                                vErrNamed = true;
                                <span class="comfy-ic @NodeIcClass(vStat.State)" data-testid="field-error">@NodeGlyph(vStat.State)</span>
                            }
                            else
                            {
                                <span class="comfy-ic @NodeIcClass(vStat.State)">@NodeGlyph(vStat.State)</span>
                            }
                            <span>@vStat.Name</span>
                            @if (vStat.State == "err")
                            {
                                <span class="comfy-nstat-err">@vStat.Detail</span>
                            }
                            else
                            {
                                <span class="comfy-nstat-detail">@vStat.Detail</span>
                            }
                        </div>
                    }
                }
            </Card>

            <Card Class="comfy-card" data-testid="card-exact-json-sent">
                    <h3 class="card-h3">Exact JSON sent</h3>
                    <div class="comfy-code">@objExactJson</div>
            </Card>

            @if (objMissingDep is not null)
            {
                <div>
                    <Alert Variant="AlertVariant.Warning" AccentBorder="true" data-testid="alert-warn">
                        <AlertDescription>
                            <b>Missing dependency.</b> Custom node <span class="comfy-mono">@MissingPackFor(objMissingDep)</span>
                            @if (MissingPackFor(objMissingDep) != objMissingDep)
                            {
                                <text>(@objMissingDep)</text>
                            }
                            is not installed.
                            <div style="margin-top:8px">
                                <Button OnClick="InstallDependencyAsync" Disabled="@objInstalling" data-testid="btn-install-node">Install node</Button>
                            </div>
                        </AlertDescription>
                    </Alert>
                </div>
            }

            <Card Class="comfy-card" data-testid="card-save-version">
                <div class="flex-between">
                    <h3 class="card-h3" style="margin:0">Save / version</h3>
                    @if (IsKnownGood)
                    {
                        <Badge Variant="BadgeVariant.Outline" Class="badge-ok" data-testid="badge-known-good">known-good</Badge>
                    }
                    else
                    {
                        <Badge Variant="BadgeVariant.Outline">unverified</Badge>
                    }
                </div>
                <div class="flex-col" style="margin-top:8px">
                    <Input @bind-Value="objModelName" Placeholder="Model name e.g. sdxl-portrait" data-testid="field-model-name-e-g-sdxl-port" />
                    <div class="flex-row">
                        <NativeSelect TValue="string" @bind-Value="objVersion" Class="grow" aria-label="Version" data-testid="field-15">
                            @foreach (var vVer in objVersionOptions)
                            {
                                <option value="@vVer">@vVer</option>
                            }
                        </NativeSelect>
                        <Button OnClick="SaveAsModelAsync"
                                Disabled="@(!CanSave)"
                                data-testid="btn-save-as-model">
                            Save as model
                        </Button>
                    </div>
                    <div class="flex-between">
                        <Label For="comfy-pin">Pin this version as known-good</Label>
                        <Switch @bind-Checked="objPinned" Id="comfy-pin" AriaLabel="Pin known-good" />
                    </div>
                    @if (!IsKnownGood || objMissingDep is not null)
                    {
                        <p class="muted-sm">Smoke-test must pass before saving — resolve any missing node first.</p>
                    }
                </div>
            </Card>
        </div>
    </div>

@code {
    private string objWorkflowJson = string.Empty;

    private bool objParsed;
    private string? objParseError;
    private List<NodeRow> objNodes = new();
    private List<MappingRow> objMapping = new();

    private bool objComfyConfigured;
    private bool objHasRun;
    private bool objRunning;
    private bool objInstalling;
    private double objProgress;
    private string objRunCaption = string.Empty;
    private string? objRunNotReached;
    private List<NodeStatus> objStatuses = new();
    private string? objMissingDep;

    private bool objKnownGood;
    private bool objPinned;
    private string objModelName = string.Empty;
    private string? objVersion = "v1";

    // The stored workflow this page reopens (newest imported workflow of the signed-in admin), if any.
    private string? objWorkflowName;
    private bool objFromStore;
    private List<(string Label, ComfyWorkflowVersion Version)> objVersions = new();

    private readonly string[] objTypeOptions = { "string", "int", "float", "bool", "file", "image", "audio", "mask", "enum" };

    /// <summary>The type choices for a row: the standard list, plus the row's own type if it is not in it.</summary>
    private IEnumerable<string> TypeOptionsFor(string aType) =>
        objTypeOptions.Contains(aType) ? objTypeOptions : objTypeOptions.Prepend(aType);
    private string[] objVersionOptions = { "v1" };

    /// <summary>Known-good when the last debug found no missing dependency, or the selected stored version passed its sandbox smoke.</summary>
    private bool IsKnownGood =>
        objKnownGood
        || objVersions.Any(aV => aV.Label == objVersion && string.Equals(aV.Version.SmokeStatus, "Passed", StringComparison.OrdinalIgnoreCase));

    private bool CanSave => IsKnownGood && objMissingDep is null && !string.IsNullOrWhiteSpace(objModelName);

    private const string ComfyImportRoute = "/api/v1/admin/comfy/import";
    // FN-046 run-debug bundle (exact submitted /prompt JSON + per-node status + missing-dep
    // detection); works WITHOUT a live ComfyUI. There is deliberately no "/run" or "/status" route.
    private const string ComfyDebugRoute = "/api/v1/admin/comfy/debug";
    // FN-047 dependency scan (required custom nodes / model files + install hints). Replaces the
    // non-existent "/install" route — actual installation is host/env-gated.
    private const string ComfyDependenciesRoute = "/api/v1/admin/comfy/dependencies";
    private const string ComfySaveRoute = "/api/v1/admin/comfy/save-as-model";

    /// <summary>A valid API-format sample so the page is immediately smoke-testable and the paste path is obvious.</summary>
    private const string SampleWorkflow = """
{
  "3": {"class_type":"KSampler","inputs":{"seed":-1,"steps":30,"cfg":7.0,"sampler_name":"euler","denoise":1.0}},
  "4": {"class_type":"CheckpointLoaderSimple","inputs":{"ckpt_name":"sd_xl_base_1.0.safetensors"}},
  "6": {"class_type":"CLIPTextEncode","inputs":{"text":"a cinematic studio portrait"}},
  "8": {"class_type":"VAEDecode","inputs":{"samples":["3",0]}},
  "9": {"class_type":"SaveImage","inputs":{"images":["8",0]}},
  "10":{"class_type":"FaceDetailer","inputs":{"image":["8",0],"guide_size":384}}
}
""";

    /// <summary>Seeds the paste box with a valid API-format sample so the page is immediately usable.</summary>
    protected override void OnInitialized()
    {
        objWorkflowJson = SampleWorkflow;
    }

    /// <summary>
    /// After the first interactive render, primes the bearer token (via <see cref="IAuthSession"/>)
    /// for the debug / dependency / save calls. There is deliberately no backend ComfyUI "status"
    /// probe — a live ComfyUI host is config-gated (<c>ComfyUI:BaseUrl</c>) — so the page starts in
    /// the import/paste entry state with <see cref="objComfyConfigured"/> false, and the run/debug
    /// panel shows the "not configured" degrade until a debug run reports a live host.
    /// </summary>
    /// <param name="aFirstRender">Whether this is the component's first render.</param>
    protected override async Task OnAfterRenderAsync(bool aFirstRender)
    {
        if (!aFirstRender)
        {
            return;
        }

        await AuthSession.EnsureLoadedAsync();
        await LoadStoredWorkflowAsync();
        StateHasChanged();
    }

    /// <summary>
    /// Reopens the admin's newest imported workflow (FN-049 <c>GET /workflows</c> + its versions): the
    /// newest version's graph fills the paste box and is parsed, its stored param mapping fills the
    /// mapping table, and the dry debug bundle (no ComfyUI needed) fills the run/debug panel. With no
    /// stored workflow the page stays on the paste sample.
    /// </summary>
    private async Task LoadStoredWorkflowAsync()
    {
        try
        {
            var vClient = HttpClientFactory.CreateClient("TrStudioApi");
            var vWorkflows = await vClient.GetFromJsonAsync<List<ComfyWorkflow>>($"{ApiRoutes.Comfy}/workflows");
            var vWorkflow = vWorkflows?.OrderByDescending(aW => aW.UpdatedUtc).FirstOrDefault();
            if (vWorkflow is null)
            {
                return;
            }

            var vVersions = await vClient.GetFromJsonAsync<List<ComfyWorkflowVersion>>(
                $"{ApiRoutes.Comfy}/workflows/{vWorkflow.WorkflowId}/versions");
            var vOrdered = (vVersions ?? new List<ComfyWorkflowVersion>()).OrderByDescending(aV => aV.VersionNumber).ToList();
            if (vOrdered.Count == 0)
            {
                return;
            }

            objVersions = vOrdered
                .Select((aV, aI) => (aI == 0 ? $"v{aV.VersionNumber} (current)" : $"v{aV.VersionNumber}", aV))
                .ToList();
            objVersionOptions = objVersions.Select(aV => aV.Label).ToArray();
            objVersion = objVersionOptions[0];
            objWorkflowName = vWorkflow.Name;

            var vCurrent = vOrdered[0];
            objWorkflowJson = vCurrent.GraphJson;
            ParseWorkflow();
            if (!objParsed)
            {
                return;
            }

            ApplyStoredMapping(vCurrent.MappedParamsJson);
            await RunAsync(aReportUnreached: false);
        }
        catch
        {
            // Workflow store unreachable — stay on the paste sample.
        }
    }

    /// <summary>
    /// Replaces the detected inputs with the version's stored registry params. A stored param names its
    /// source input by <see cref="ModelParamSpec.Label"/> (the input name, by default), matched to the first
    /// unused parsed input of that name in graph order.
    /// </summary>
    private void ApplyStoredMapping(string aMappedParamsJson)
    {
        List<ModelParamSpec>? vSpecs;
        try
        {
            vSpecs = JsonSerializer.Deserialize<List<ModelParamSpec>>(aMappedParamsJson, new JsonSerializerOptions(JsonSerializerDefaults.Web));
        }
        catch (JsonException)
        {
            return;
        }

        if (vSpecs is null || vSpecs.Count == 0)
        {
            return;
        }

        var vDetected = objMapping;
        var vUsed = new HashSet<MappingRow>();
        var vRows = new List<MappingRow>();
        foreach (var vSpec in vSpecs)
        {
            var vSource = vDetected.FirstOrDefault(aRow => !vUsed.Contains(aRow)
                && string.Equals(aRow.ParamKey, vSpec.Label ?? vSpec.Key, StringComparison.Ordinal));
            if (vSource is not null)
            {
                vUsed.Add(vSource);
            }

            vRows.Add(new MappingRow
            {
                NodeInput = vSource?.NodeInput ?? (vSpec.Label ?? vSpec.Key),
                ClassType = vSource?.ClassType ?? string.Empty,
                ParamKey = vSpec.Key,
                Type = vSpec.Type,
                Required = vSpec.Required,
                Default = string.IsNullOrEmpty(vSpec.DefaultValue) ? null : vSpec.DefaultValue
            });
        }

        objMapping = vRows;
        objFromStore = true;
    }

    /// <summary>Reads the dropped/selected workflow file as text and parses it as a workflow.</summary>
    /// <param name="aArgs">The file chosen in (or dropped on) the drop zone.</param>
    private async Task OnFileChosenAsync(InputFileChangeEventArgs aArgs)
    {
        try
        {
            await using var vStream = aArgs.File.OpenReadStream(8 * 1024 * 1024);
            using var vReader = new StreamReader(vStream);
            objWorkflowJson = await vReader.ReadToEndAsync();
            objWorkflowName = aArgs.File.Name;
        }
        catch (Exception aEx)
        {
            objParseError = $"Could not read the file: {aEx.Message}";
            objParsed = false;
            return;
        }

        ParseWorkflow();
    }

    /// <summary>
    /// Parses the pasted/loaded workflow JSON client-side. Invalid JSON always surfaces a parse Alert;
    /// valid JSON yields the nodes DataTable and one editable mapping row per literal (non-reference)
    /// node input. Detecting parameterizable inputs here keeps the page usable with no server round-trip.
    /// </summary>
    private void ParseWorkflow()
    {
        objParsed = false;
        objFromStore = false;
        objHasRun = false;
        objKnownGood = false;
        objMissingDep = null;
        objStatuses.Clear();

        if (string.IsNullOrWhiteSpace(objWorkflowJson))
        {
            objParseError = "Paste a workflow_api.json payload, or drop a file above.";
            return;
        }

        try
        {
            using var vDoc = JsonDocument.Parse(objWorkflowJson);
            if (vDoc.RootElement.ValueKind != JsonValueKind.Object)
            {
                objParseError = "Expected an API-format object keyed by node id (e.g. { \"3\": { \"class_type\": … } }).";
                return;
            }

            var vNodes = new List<NodeRow>();
            var vMapping = new List<MappingRow>();

            foreach (var vNode in vDoc.RootElement.EnumerateObject())
            {
                var vClassType = vNode.Value.TryGetProperty("class_type", out var vCt) && vCt.ValueKind == JsonValueKind.String
                    ? vCt.GetString() ?? "(unknown)"
                    : "(unknown)";
                vNodes.Add(new NodeRow(vNode.Name, vClassType, "idle"));

                if (vNode.Value.TryGetProperty("inputs", out var vInputs) && vInputs.ValueKind == JsonValueKind.Object)
                {
                    foreach (var vInput in vInputs.EnumerateObject())
                    {
                        var vType = InputType(vInput.Value);
                        if (vType is null)
                        {
                            continue; // array = wired link to another node, not a parameterizable input
                        }

                        vMapping.Add(new MappingRow
                        {
                            NodeInput = $"{vNode.Name}.{vInput.Name}",
                            ClassType = vClassType,
                            ParamKey = vInput.Name,
                            Type = vType,
                            Required = false,
                            Default = RawScalar(vInput.Value)
                        });
                    }
                }
            }

            objNodes = vNodes;
            objMapping = vMapping;
            objParseError = null;
            objParsed = true;
        }
        catch (JsonException aEx)
        {
            objParseError = $"JSON parse failed: {aEx.Message}";
            objParsed = false;
        }
    }

    /// <summary>Maps a scalar JSON input to a registry param type; returns null for arrays/objects (wired links).</summary>
    private static string? InputType(JsonElement aValue) => aValue.ValueKind switch
    {
        JsonValueKind.String => "string",
        JsonValueKind.Number => aValue.TryGetInt64(out _) ? "int" : "float",
        JsonValueKind.True or JsonValueKind.False => "bool",
        _ => null
    };

    private static string? RawScalar(JsonElement aValue) => aValue.ValueKind switch
    {
        JsonValueKind.String => aValue.GetString(),
        JsonValueKind.Number => aValue.GetRawText(),
        JsonValueKind.True => "true",
        JsonValueKind.False => "false",
        _ => null
    };

    /// <summary>
    /// Smoke-tests the graph via the FN-046 run-debug bundle (<c>POST /api/v1/admin/comfy/debug</c>,
    /// <see cref="ComfyDebugRequest"/> → <see cref="ComfyDebugData"/>): the exact submitted <c>/prompt</c>
    /// JSON, per-node status and missing-dependency detection — which the backend produces WITHOUT a live
    /// ComfyUI (reported via <see cref="ComfyDebugData.Degraded"/>). When the debug service cannot be
    /// reached, the panel says so and shows no per-node results (owner run, 15 Nov 2026: it used to
    /// draw a made-up progression).
    /// </summary>
    private async Task RunAsync() => await RunAsync(aReportUnreached: true);

    /// <param name="aReportUnreached">Whether an unreachable service is reported (never on page load).</param>
    private async Task RunAsync(bool aReportUnreached)
    {
        objRunning = true;
        objHasRun = true;
        objProgress = 0;
        objMissingDep = null;
        objKnownGood = false;
        objRunNotReached = null;

        string vWhy;
        var vClient = HttpClientFactory.CreateClient("TrStudioApi");
        try
        {
            var vResponse = await vClient.PostAsJsonAsync(
                ComfyDebugRoute,
                new ComfyDebugRequest { WorkflowJson = objWorkflowJson, ParamsJson = null });
            if (vResponse.IsSuccessStatusCode)
            {
                var vDebug = await vResponse.Content.ReadFromJsonAsync<ComfyDebugData>();
                if (vDebug is not null)
                {
                    ApplyDebug(vDebug);
                    objRunning = false;
                    return;
                }

                vWhy = "it answered with nothing";
            }
            else
            {
                vWhy = $"it answered HTTP {(int)vResponse.StatusCode}";
            }
        }
        catch (Exception vException) when (vException is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException or InvalidOperationException)
        {
            vWhy = vException is TaskCanceledException ? "it did not answer in time" : "it could not be contacted";
        }

        // Nothing ran: no node results, no progress and nothing known-good.
        objHasRun = false;
        objStatuses = new();
        foreach (var vNode in objNodes)
        {
            vNode.State = "idle";
        }

        if (aReportUnreached)
        {
            objRunNotReached = $"The ComfyUI debug service was not reached ({vWhy}), so nothing ran and no node results are shown. Try Run again.";
        }

        objRunning = false;
    }

    /// <summary>Reflects a live <see cref="ComfyDebugData"/> bundle onto the run/debug panel.</summary>
    private void ApplyDebug(ComfyDebugData aDebug)
    {
        objComfyConfigured = !aDebug.Degraded;

        var vMissingClasses = aDebug.Dependencies.MissingCustomNodes.Select(aDep => aDep.Name).ToHashSet(StringComparer.Ordinal);
        var vStatuses = new List<NodeStatus>();
        foreach (var vNode in aDebug.NodeStatuses)
        {
            var vName = string.IsNullOrWhiteSpace(vNode.ClassType) ? vNode.NodeId : vNode.ClassType;
            var vIsMissing = vMissingClasses.Contains(vNode.ClassType ?? string.Empty);
            var vState = vIsMissing ? "err" : MapDebugState(vNode.Status);
            var vDetail = vIsMissing
                ? "missing node"
                : vNode.Error ?? (string.Equals(vNode.Status, "pending", StringComparison.OrdinalIgnoreCase) ? "queued" : vNode.Status);
            vStatuses.Add(new NodeStatus(vName, vState, vDetail));

            var vParsed = objNodes.FirstOrDefault(aRow => aRow.Id == vNode.NodeId);
            if (vParsed is not null)
            {
                vParsed.State = vState;
            }
        }

        objStatuses = vStatuses;

        var vMissing = aDebug.Dependencies.MissingCustomNodes.FirstOrDefault();
        objMissingDep = vMissing?.Name;
        objKnownGood = !aDebug.Dependencies.HasMissing;

        if (vMissing is not null)
        {
            var vOk = objStatuses.Count(aStat => aStat.State == "ok");
            objProgress = objNodes.Count == 0 ? 0 : Math.Round(100.0 * vOk / objNodes.Count);
            objRunCaption = aDebug.Degraded
                ? $"Dry run: {objNodes.Count} nodes queued · {vMissing.Name} is not installed."
                : aDebug.Message ?? $"Stopped at {vMissing.Name} — {vMissing.InstallHint}";
        }
        else
        {
            objProgress = 100;
            objRunCaption = aDebug.Message ?? (aDebug.Degraded
                ? "Graph validated — no live ComfyUI configured, so this is a dry-run of the exact submitted request."
                : $"Completed {objNodes.Count} of {objNodes.Count} nodes · live WebSocket preview.");
        }
    }

    /// <summary>Maps a backend <see cref="ComfyNodeStatus.Status"/> value onto this panel's state glyphs.</summary>
    private static string MapDebugState(string? aStatus) => (aStatus ?? string.Empty).ToLowerInvariant() switch
    {
        "completed" or "ok" => "ok",
        "error" or "err" => "err",
        "running" or "run" => "run",
        _ => "idle"
    };

    /// <summary>
    /// Scans the graph for missing custom nodes / model files via the FN-047 dependency endpoint
    /// (<c>POST /api/v1/admin/comfy/dependencies</c>, <see cref="ComfyDependencyRequest"/> →
    /// <see cref="ComfyDependencyReport"/>), surfacing the real install hint. Actual installation is
    /// host/env-gated (there is no install route), so the resolution is best-effort + a re-run.
    /// </summary>
    private async Task InstallDependencyAsync()
    {
        objInstalling = true;
        var vClient = HttpClientFactory.CreateClient("TrStudioApi");
        string? vHint = null;
        try
        {
            var vResponse = await vClient.PostAsJsonAsync(
                ComfyDependenciesRoute,
                new ComfyDependencyRequest { WorkflowJson = objWorkflowJson });
            if (vResponse.IsSuccessStatusCode)
            {
                var vReport = await vResponse.Content.ReadFromJsonAsync<ComfyDependencyReport>();
                vHint = vReport?.MissingCustomNodes.FirstOrDefault()?.InstallHint;
            }
        }
        catch
        {
            // Dependency scan unreachable — proceed with the local resolution below.
        }

        var vNext = objNodes.FirstOrDefault(aNode => !objBaseNodes.Contains(aNode.ClassType));
        if (vNext is not null)
        {
            objBaseNodes = objBaseNodes.Append(vNext.ClassType).ToArray();
        }

        objInstalling = false;
        ToastService.Success(
            string.IsNullOrWhiteSpace(vHint) ? "Custom node resolved." : $"Install on the ComfyUI host: {vHint}",
            "Dependency resolved");
        await RunAsync();
    }

    /// <summary>Persists the known-good graph as a registry model (best-effort POST) and confirms via toast.</summary>
    private async Task SaveAsModelAsync()
    {
        if (!CanSave)
        {
            return;
        }

        var vClient = HttpClientFactory.CreateClient("TrStudioApi");
        // FN-048: the body the save-as-model route reads (ComfySaveAsModelRequest). Found 15 Nov 2026: the
        // page posted its own field names and showed "saved" whatever came back.
        var vModelId = System.Text.RegularExpressions.Regex.Replace(objModelName.Trim().ToLowerInvariant(), "[^a-z0-9]+", "-").Trim('-');
        var vRequest = new ComfySaveAsModelRequest
        {
            ModelId = vModelId,
            DisplayName = objModelName.Trim(),
            WorkflowName = objModelName.Trim(),
            WorkflowJson = objWorkflowJson,
            Mappings = objMapping.Select(aRow => new ComfyParamMapping
            {
                ParamKey = aRow.NodeInput,
                Key = aRow.ParamKey,
                Type = aRow.Type,
                Required = aRow.Required,
                DefaultValue = aRow.Default
            }).ToList()
        };

        try
        {
            using var vResponse = await vClient.PostAsJsonAsync(ComfySaveRoute, vRequest);
            if (!vResponse.IsSuccessStatusCode)
            {
                var vBody = await vResponse.Content.ReadAsStringAsync();
                ToastService.Error(string.IsNullOrWhiteSpace(vBody) ? $"The model was not saved (HTTP {(int)vResponse.StatusCode})." : vBody, "Not saved");
                return;
            }
        }
        catch (HttpRequestException vException)
        {
            ToastService.Error(vException.Message, "Not saved");
            return;
        }

        ToastService.Success(
            $"Saved \"{objModelName}\" as {vModelId}{(objPinned ? " · pin it as known-good from its version list" : "")}.",
            "Registry model saved");
    }

    /// <summary>
    /// The exact <c>/prompt</c> request that will be sent, rebuilt live from the mapping rows so param-key
    /// edits are reflected immediately (each mapped input is templated as <c>{{paramKey}}</c>).
    /// </summary>
    private string objExactJson
    {
        get
        {
            if (objMapping.Count == 0)
            {
                return "POST /prompt\n{\n  \"prompt\": { },\n  \"client_id\": \"trstudio-admin\"\n}";
            }

            var vSb = new StringBuilder();
            vSb.AppendLine("POST /prompt");
            vSb.AppendLine("{");
            vSb.AppendLine("  \"prompt\": {");
            for (var vI = 0; vI < objMapping.Count; vI++)
            {
                var vRow = objMapping[vI];
                var vComma = vI < objMapping.Count - 1 ? "," : "";
                vSb.AppendLine($"    \"{vRow.NodeInput}\": \"{{{{{vRow.ParamKey}}}}}\"{vComma}");
            }
            vSb.AppendLine("  },");
            vSb.AppendLine("  \"client_id\": \"trstudio-admin\"");
            vSb.Append('}');
            return vSb.ToString();
        }
    }

