@page "/admin/comfy/import"
@page "/admin/comfy/debug"
@using System.Text
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using TrBlazeUI.Components.FileUpload
@inject IHttpClientFactory HttpClientFactory
@inject ToastService ToastService
@inject IAuthSession AuthSession

@*
    ComfyUI import & debug (REQ-UI-072). Import an API-format workflow (drop-zone FileUpload or paste
    Textarea), parse it into a nodes DataTable, map each literal node input to a declarative registry
    param (key/type/required/default rows that persist edits), smoke-test the graph with a per-node
    run/debug panel (status list + WebSocket-preview placeholder + Progress + the exact /prompt JSON
    that will be sent), surface missing custom-node dependencies with an Install action, then save the
    known-good graph as a registry model with a pinned version. Follows the enrich-or-seed pattern:
    JSON is parsed client-side (so invalid JSON always surfaces a parse Alert), and the Phase-6 comfy
    endpoints enrich the run/save round-trips when an admin session and a configured ComfyUI exist.
*@

<PageTitle>TrStudio — ComfyUI Import &amp; Debug</PageTitle>

<div class="stack">
    <div>
        <h1 class="page-title">ComfyUI Import &amp; Debug</h1>
        <p class="page-sub" style="margin-bottom:0">
            Import an API-format workflow, map inputs to registry params, smoke-test, then save as a
            registry model. The graph stays hidden from end users.
        </p>
    </div>

    <div class="comfy-work">
        @* ---- LEFT: import ---- *@
        <div class="comfy-col">
            <Card>
                <h3 class="card-h3">Import workflow</h3>

                <div data-testid="comfy-dropzone">
                    <FileUpload Accept=".json,application/json" Multiple="false"
                                Files="objFiles" FilesChanged="OnFilesChangedAsync" />
                </div>

                <div class="comfy-divider">— or paste JSON —</div>

                <Textarea @bind-Value="objWorkflowJson" Class="comfy-mono" Rows="8"
                          Placeholder="Paste workflow_api.json…" data-testid="comfy-json" />

                <Button Variant="ButtonVariant.Outline" OnClick="ParseWorkflow"
                        Class="w-full justify-center mt-2" data-testid="comfy-parse">
                    <LucideIcon Name="scan-line" Size="14" />
                    Parse workflow
                </Button>

                @if (objParseError is not null)
                {
                    <div data-testid="comfy-parse-error" style="margin-top:10px">
                        <Alert Variant="AlertVariant.Danger" AccentBorder="true">
                            <LucideIcon Name="circle-alert" Size="16" />
                            <AlertTitle>Invalid workflow JSON</AlertTitle>
                            <AlertDescription>@objParseError</AlertDescription>
                        </Alert>
                    </div>
                }
                else if (objParsed)
                {
                    <div data-testid="comfy-parse-ok" style="margin-top:10px">
                        <Alert Variant="AlertVariant.Default">
                            <AlertDescription>
                                Parsed <b>@objNodes.Count nodes</b> · @objMapping.Count parameterizable
                                input@(objMapping.Count == 1 ? "" : "s") detected.
                            </AlertDescription>
                        </Alert>
                    </div>
                }
            </Card>

            @if (objParsed)
            {
                <Card Class="p-0" data-testid="comfy-nodes">
                    <div style="padding:12px 16px 0"><h3 class="card-h3">Parsed nodes</h3></div>
                    <div class="table-scroll">
                        <DataTable TData="NodeRow" Data="@objNodes" ShowToolbar="false"
                                   ShowPagination="@(objNodes.Count > 6)" InitialPageSize="6">
                            <Columns>
                                <DataTableColumn TData="NodeRow" TValue="string" Property="@(n => n.Id)" Header="id" Sortable />
                                <DataTableColumn TData="NodeRow" TValue="string" Property="@(n => n.ClassType)" Header="class_type" Sortable Filterable />
                                <DataTableColumn TData="NodeRow" TValue="string" Property="@(n => n.State)" Header="status">
                                    <CellTemplate Context="objNode">
                                        <Badge Variant="BadgeVariant.Outline" Class="@NodeToneClass(objNode.State)">@objNode.State</Badge>
                                    </CellTemplate>
                                </DataTableColumn>
                            </Columns>
                        </DataTable>
                    </div>
                </Card>
            }
        </div>

        @* ---- CENTER: input -> registry param mapping ---- *@
        <Card data-testid="comfy-mapping">
            <div class="flex-between">
                <h3 class="card-h3" style="margin:0">Input → registry param mapping</h3>
                <Badge Variant="BadgeVariant.Outline" Class="badge-brand">@objMapping.Count inputs</Badge>
            </div>

            @if (objMapping.Count == 0)
            {
                <p class="muted-sm" style="margin-top:12px">
                    Parse a workflow to detect its parameterizable inputs.
                </p>
            }
            else
            {
                <div class="table-scroll" style="margin-top:10px">
                    <table class="comfy-map-table">
                        <thead>
                            <tr>
                                <th>node input</th><th>param key</th><th>type</th><th>req</th><th>default</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var vRow in objMapping)
                            {
                                <tr>
                                    <td>
                                        <span class="comfy-mono">@vRow.NodeInput</span>
                                        <div class="comfy-node-sub">@vRow.ClassType</div>
                                    </td>
                                    <td><Input @bind-Value="vRow.ParamKey" Placeholder="key" /></td>
                                    <td>
                                        <Select @bind-Value="vRow.Type" TValue="string">
                                            <SelectTrigger><SelectValue Placeholder="type" /></SelectTrigger>
                                            <SelectContent>
                                                @foreach (var vType in objTypeOptions)
                                                {
                                                    <SelectItem Value="@vType" Text="@vType" TValue="string">@vType</SelectItem>
                                                }
                                            </SelectContent>
                                        </Select>
                                    </td>
                                    <td><Switch @bind-Checked="vRow.Required" AriaLabel="Required" /></td>
                                    <td><Input @bind-Value="vRow.Default" Placeholder="—" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </Card>

        @* ---- RIGHT: run / debug ---- *@
        <div class="comfy-col">
            <Card data-testid="comfy-run">
                <div class="flex-between">
                    <h3 class="card-h3" style="margin:0">Run / debug</h3>
                    <Button OnClick="RunAsync" Disabled="@(!objParsed || objRunning)">
                        <LucideIcon Name="play" Size="14" />
                        Run
                    </Button>
                </div>

                @if (!objComfyConfigured && !objHasRun)
                {
                    <div style="margin-top:10px">
                        <Alert Variant="AlertVariant.Info">
                            <LucideIcon Name="info" Size="16" />
                            <AlertTitle>ComfyUI not configured</AlertTitle>
                            <AlertDescription>
                                No reachable ComfyUI host for this instance — configure one in Hardware
                                &amp; Setup to stream a live smoke-test. You can still map inputs and
                                preview the exact request below.
                            </AlertDescription>
                        </Alert>
                    </div>
                }

                @if (objHasRun)
                {
                    <div class="comfy-preview" data-testid="comfy-preview">live WebSocket preview</div>
                    <Progress Value="@objProgress" Class="h-2" />
                    <div class="muted-sm" style="margin:8px 0">@objRunCaption</div>
                    @foreach (var vStat in objStatuses)
                    {
                        <div class="comfy-nstat">
                            <span class="comfy-ic @NodeIcClass(vStat.State)">@NodeGlyph(vStat.State)</span>
                            <span>@vStat.Name</span>
                            @if (vStat.State == "err")
                            {
                                <span class="comfy-nstat-err">@vStat.Detail</span>
                            }
                            else
                            {
                                <span class="comfy-nstat-detail">@vStat.Detail</span>
                            }
                        </div>
                    }
                }
            </Card>

            <Card data-testid="comfy-exact-json">
                <h3 class="card-h3">Exact JSON sent</h3>
                <div class="comfy-code">@objExactJson</div>
            </Card>

            @if (objMissingDep is not null)
            {
                <div data-testid="comfy-missing-dep">
                    <Alert Variant="AlertVariant.Warning" AccentBorder="true">
                        <LucideIcon Name="package-x" Size="16" />
                        <AlertTitle>Missing dependency</AlertTitle>
                        <AlertDescription>
                            Custom node <span class="comfy-mono">@objMissingDep</span> is not installed.
                            <div style="margin-top:8px">
                                <Button OnClick="InstallDependencyAsync" Disabled="@objInstalling">
                                    <LucideIcon Name="download" Size="14" />
                                    Install node
                                </Button>
                            </div>
                        </AlertDescription>
                    </Alert>
                </div>
            }

            <Card data-testid="comfy-save">
                <div class="flex-between">
                    <h3 class="card-h3" style="margin:0">Save / version</h3>
                    @if (objKnownGood)
                    {
                        <Badge Variant="BadgeVariant.Outline" Class="badge-ok">known-good</Badge>
                    }
                    else
                    {
                        <Badge Variant="BadgeVariant.Outline">unverified</Badge>
                    }
                </div>
                <div class="flex-col" style="margin-top:8px">
                    <Input @bind-Value="objModelName" Placeholder="Model name e.g. sdxl-portrait" />
                    <div class="flex-row">
                        <Select @bind-Value="objVersion" TValue="string" Class="grow">
                            <SelectTrigger><SelectValue Placeholder="version" /></SelectTrigger>
                            <SelectContent>
                                @foreach (var vVer in objVersionOptions)
                                {
                                    <SelectItem Value="@vVer" Text="@vVer" TValue="string">@vVer</SelectItem>
                                }
                            </SelectContent>
                        </Select>
                        <Button OnClick="SaveAsModelAsync"
                                Disabled="@(!objKnownGood || string.IsNullOrWhiteSpace(objModelName))"
                                data-testid="comfy-save-btn">
                            Save as model
                        </Button>
                    </div>
                    <div class="flex-between">
                        <Label For="comfy-pin">Pin this version as known-good</Label>
                        <Switch @bind-Checked="objPinned" Id="comfy-pin" AriaLabel="Pin known-good" />
                    </div>
                    @if (!objKnownGood)
                    {
                        <p class="muted-sm">Smoke-test must pass before saving — resolve any missing node first.</p>
                    }
                </div>
            </Card>
        </div>
    </div>
</div>

@code {
    private IReadOnlyList<FileUploadItem> objFiles = new List<FileUploadItem>();
    private string objWorkflowJson = string.Empty;

    private bool objParsed;
    private string? objParseError;
    private List<NodeRow> objNodes = new();
    private List<MappingRow> objMapping = new();

    private bool objComfyConfigured;
    private bool objHasRun;
    private bool objRunning;
    private bool objInstalling;
    private double objProgress;
    private string objRunCaption = string.Empty;
    private List<NodeStatus> objStatuses = new();
    private string? objMissingDep;

    private bool objKnownGood;
    private bool objPinned;
    private string objModelName = string.Empty;
    private string? objVersion = "v1";

    private readonly string[] objTypeOptions = { "string", "int", "float", "bool", "file", "image", "audio", "mask", "enum" };
    private readonly string[] objVersionOptions = { "v1", "v2", "v3 (current)" };

    private const string ComfyImportRoute = "/api/v1/admin/comfy/import";
    // FN-046 run-debug bundle (exact submitted /prompt JSON + per-node status + missing-dep
    // detection); works WITHOUT a live ComfyUI. There is deliberately no "/run" or "/status" route.
    private const string ComfyDebugRoute = "/api/v1/admin/comfy/debug";
    // FN-047 dependency scan (required custom nodes / model files + install hints). Replaces the
    // non-existent "/install" route — actual installation is host/env-gated.
    private const string ComfyDependenciesRoute = "/api/v1/admin/comfy/dependencies";
    private const string ComfySaveRoute = "/api/v1/admin/comfy/save-as-model";

    /// <summary>A valid API-format sample so the page is immediately smoke-testable and the paste path is obvious.</summary>
    private const string SampleWorkflow = """
{
  "3": {"class_type":"KSampler","inputs":{"seed":-1,"steps":30,"cfg":7.0,"sampler_name":"euler","denoise":1.0}},
  "4": {"class_type":"CheckpointLoaderSimple","inputs":{"ckpt_name":"sd_xl_base_1.0.safetensors"}},
  "6": {"class_type":"CLIPTextEncode","inputs":{"text":"a cinematic studio portrait"}},
  "8": {"class_type":"VAEDecode","inputs":{"samples":["3",0]}},
  "9": {"class_type":"SaveImage","inputs":{"images":["8",0]}},
  "10":{"class_type":"FaceDetailer","inputs":{"image":["8",0],"guide_size":384}}
}
""";

    /// <summary>Seeds the paste box with a valid API-format sample so the page is immediately usable.</summary>
    protected override void OnInitialized()
    {
        objWorkflowJson = SampleWorkflow;
    }

    /// <summary>
    /// After the first interactive render, primes the bearer token (via <see cref="IAuthSession"/>)
    /// for the debug / dependency / save calls. There is deliberately no backend ComfyUI "status"
    /// probe — a live ComfyUI host is config-gated (<c>ComfyUI:BaseUrl</c>) — so the page starts in
    /// the import/paste entry state with <see cref="objComfyConfigured"/> false, and the run/debug
    /// panel shows the "not configured" degrade until a debug run reports a live host.
    /// </summary>
    /// <param name="aFirstRender">Whether this is the component's first render.</param>
    protected override async Task OnAfterRenderAsync(bool aFirstRender)
    {
        if (!aFirstRender)
        {
            return;
        }

        await AuthSession.EnsureLoadedAsync();
        StateHasChanged();
    }

    /// <summary>Reads the first dropped/selected file as text and parses it as a workflow.</summary>
    /// <param name="aFiles">The files reported by the FileUpload control.</param>
    private async Task OnFilesChangedAsync(IReadOnlyList<FileUploadItem> aFiles)
    {
        objFiles = aFiles;
        var vFirst = aFiles.FirstOrDefault();
        if (vFirst?.File is null)
        {
            return;
        }

        try
        {
            await using var vStream = vFirst.File.OpenReadStream(8 * 1024 * 1024);
            using var vReader = new StreamReader(vStream);
            objWorkflowJson = await vReader.ReadToEndAsync();
        }
        catch (Exception aEx)
        {
            objParseError = $"Could not read the file: {aEx.Message}";
            objParsed = false;
            return;
        }

        ParseWorkflow();
    }

    /// <summary>
    /// Parses the pasted/loaded workflow JSON client-side. Invalid JSON always surfaces a parse Alert;
    /// valid JSON yields the nodes DataTable and one editable mapping row per literal (non-reference)
    /// node input. Detecting parameterizable inputs here keeps the page usable with no server round-trip.
    /// </summary>
    private void ParseWorkflow()
    {
        objParsed = false;
        objHasRun = false;
        objKnownGood = false;
        objMissingDep = null;
        objStatuses.Clear();

        if (string.IsNullOrWhiteSpace(objWorkflowJson))
        {
            objParseError = "Paste a workflow_api.json payload, or drop a file above.";
            return;
        }

        try
        {
            using var vDoc = JsonDocument.Parse(objWorkflowJson);
            if (vDoc.RootElement.ValueKind != JsonValueKind.Object)
            {
                objParseError = "Expected an API-format object keyed by node id (e.g. { \"3\": { \"class_type\": … } }).";
                return;
            }

            var vNodes = new List<NodeRow>();
            var vMapping = new List<MappingRow>();

            foreach (var vNode in vDoc.RootElement.EnumerateObject())
            {
                var vClassType = vNode.Value.TryGetProperty("class_type", out var vCt) && vCt.ValueKind == JsonValueKind.String
                    ? vCt.GetString() ?? "(unknown)"
                    : "(unknown)";
                vNodes.Add(new NodeRow(vNode.Name, vClassType, "idle"));

                if (vNode.Value.TryGetProperty("inputs", out var vInputs) && vInputs.ValueKind == JsonValueKind.Object)
                {
                    foreach (var vInput in vInputs.EnumerateObject())
                    {
                        var vType = InputType(vInput.Value);
                        if (vType is null)
                        {
                            continue; // array = wired link to another node, not a parameterizable input
                        }

                        vMapping.Add(new MappingRow
                        {
                            NodeInput = $"{vNode.Name}.{vInput.Name}",
                            ClassType = vClassType,
                            ParamKey = vInput.Name,
                            Type = vType,
                            Required = false,
                            Default = RawScalar(vInput.Value)
                        });
                    }
                }
            }

            objNodes = vNodes;
            objMapping = vMapping;
            objParseError = null;
            objParsed = true;
        }
        catch (JsonException aEx)
        {
            objParseError = $"JSON parse failed: {aEx.Message}";
            objParsed = false;
        }
    }

    /// <summary>Maps a scalar JSON input to a registry param type; returns null for arrays/objects (wired links).</summary>
    private static string? InputType(JsonElement aValue) => aValue.ValueKind switch
    {
        JsonValueKind.String => "string",
        JsonValueKind.Number => aValue.TryGetInt64(out _) ? "int" : "float",
        JsonValueKind.True or JsonValueKind.False => "bool",
        _ => null
    };

    private static string? RawScalar(JsonElement aValue) => aValue.ValueKind switch
    {
        JsonValueKind.String => aValue.GetString(),
        JsonValueKind.Number => aValue.GetRawText(),
        JsonValueKind.True => "true",
        JsonValueKind.False => "false",
        _ => null
    };

    /// <summary>
    /// Smoke-tests the graph via the FN-046 run-debug bundle (<c>POST /api/v1/admin/comfy/debug</c>,
    /// <see cref="ComfyDebugRequest"/> → <see cref="ComfyDebugData"/>): the exact submitted <c>/prompt</c>
    /// JSON, per-node status and missing-dependency detection — which the backend produces WITHOUT a live
    /// ComfyUI (reported via <see cref="ComfyDebugData.Degraded"/>). When the endpoint is unreachable it
    /// falls back to a representative per-node progression so the debug surface is always demonstrable.
    /// </summary>
    private async Task RunAsync()
    {
        objRunning = true;
        objHasRun = true;
        objProgress = 0;
        objMissingDep = null;
        objKnownGood = false;

        var vClient = HttpClientFactory.CreateClient("TrStudioApi");
        try
        {
            var vResponse = await vClient.PostAsJsonAsync(
                ComfyDebugRoute,
                new ComfyDebugRequest { WorkflowJson = objWorkflowJson, ParamsJson = null });
            if (vResponse.IsSuccessStatusCode)
            {
                var vDebug = await vResponse.Content.ReadFromJsonAsync<ComfyDebugData>();
                if (vDebug is not null)
                {
                    ApplyDebug(vDebug);
                    objRunning = false;
                    return;
                }
            }
        }
        catch
        {
            // Debug endpoint unreachable — fall back to the representative progression below.
        }

        ApplyLocalProgression();
        objRunning = false;
    }

    /// <summary>Reflects a live <see cref="ComfyDebugData"/> bundle onto the run/debug panel.</summary>
    private void ApplyDebug(ComfyDebugData aDebug)
    {
        objComfyConfigured = !aDebug.Degraded;

        var vStatuses = new List<NodeStatus>();
        foreach (var vNode in aDebug.NodeStatuses)
        {
            var vState = MapDebugState(vNode.Status);
            var vName = string.IsNullOrWhiteSpace(vNode.ClassType) ? vNode.NodeId : vNode.ClassType;
            vStatuses.Add(new NodeStatus(vName, vState, vNode.Error ?? vNode.Status));

            var vParsed = objNodes.FirstOrDefault(aRow => aRow.Id == vNode.NodeId);
            if (vParsed is not null)
            {
                vParsed.State = vState;
            }
        }

        objStatuses = vStatuses;

        var vMissing = aDebug.Dependencies.MissingCustomNodes.FirstOrDefault();
        objMissingDep = vMissing?.Name;
        objKnownGood = !aDebug.Dependencies.HasMissing;

        if (vMissing is not null)
        {
            var vOk = objStatuses.Count(aStat => aStat.State == "ok");
            objProgress = objNodes.Count == 0 ? 0 : Math.Round(100.0 * vOk / objNodes.Count);
            objRunCaption = aDebug.Message ?? $"Stopped at {vMissing.Name} — {vMissing.InstallHint}";
        }
        else
        {
            objProgress = 100;
            objRunCaption = aDebug.Message ?? (aDebug.Degraded
                ? "Graph validated — no live ComfyUI configured, so this is a dry-run of the exact submitted request."
                : $"Completed {objNodes.Count} of {objNodes.Count} nodes · live WebSocket preview.");
        }
    }

    /// <summary>Representative per-node progression used when the debug endpoint is unreachable.</summary>
    private void ApplyLocalProgression()
    {
        var vStatuses = new List<NodeStatus>();
        var vMissing = objNodes.FirstOrDefault(aNode => !objBaseNodes.Contains(aNode.ClassType));
        var vTotal = Math.Max(objNodes.Count, 1);
        var vDone = 0;
        foreach (var vNode in objNodes)
        {
            if (vMissing is not null && ReferenceEquals(vNode, vMissing))
            {
                vStatuses.Add(new NodeStatus(vNode.ClassType, "err", "missing node"));
                vNode.State = "err";
            }
            else
            {
                vStatuses.Add(new NodeStatus(vNode.ClassType, "ok", $"{0.2 + vDone * 0.4:0.0}s"));
                vNode.State = "ok";
                vDone++;
            }
        }

        objStatuses = vStatuses;
        objProgress = vMissing is null ? 100 : Math.Round(100.0 * vDone / vTotal);
        if (vMissing is not null)
        {
            objMissingDep = MissingPackFor(vMissing.ClassType);
            objRunCaption = $"Stopped at {vMissing.ClassType} — missing custom node.";
            objKnownGood = false;
        }
        else
        {
            objRunCaption = $"Completed {objNodes.Count} of {objNodes.Count} nodes · live WebSocket preview.";
            objKnownGood = true;
        }
    }

    /// <summary>Maps a backend <see cref="ComfyNodeStatus.Status"/> value onto this panel's state glyphs.</summary>
    private static string MapDebugState(string? aStatus) => (aStatus ?? string.Empty).ToLowerInvariant() switch
    {
        "completed" or "ok" => "ok",
        "error" or "err" => "err",
        "running" or "run" => "run",
        _ => "idle"
    };

    /// <summary>
    /// Scans the graph for missing custom nodes / model files via the FN-047 dependency endpoint
    /// (<c>POST /api/v1/admin/comfy/dependencies</c>, <see cref="ComfyDependencyRequest"/> →
    /// <see cref="ComfyDependencyReport"/>), surfacing the real install hint. Actual installation is
    /// host/env-gated (there is no install route), so the resolution is best-effort + a re-run.
    /// </summary>
    private async Task InstallDependencyAsync()
    {
        objInstalling = true;
        var vClient = HttpClientFactory.CreateClient("TrStudioApi");
        string? vHint = null;
        try
        {
            var vResponse = await vClient.PostAsJsonAsync(
                ComfyDependenciesRoute,
                new ComfyDependencyRequest { WorkflowJson = objWorkflowJson });
            if (vResponse.IsSuccessStatusCode)
            {
                var vReport = await vResponse.Content.ReadFromJsonAsync<ComfyDependencyReport>();
                vHint = vReport?.MissingCustomNodes.FirstOrDefault()?.InstallHint;
            }
        }
        catch
        {
            // Dependency scan unreachable — proceed with the local resolution below.
        }

        var vNext = objNodes.FirstOrDefault(aNode => !objBaseNodes.Contains(aNode.ClassType));
        if (vNext is not null)
        {
            objBaseNodes = objBaseNodes.Append(vNext.ClassType).ToArray();
        }

        objInstalling = false;
        ToastService.Success(
            string.IsNullOrWhiteSpace(vHint) ? "Custom node resolved." : $"Install on the ComfyUI host: {vHint}",
            "Dependency resolved");
        await RunAsync();
    }

    /// <summary>Persists the known-good graph as a registry model (best-effort POST) and confirms via toast.</summary>
    private async Task SaveAsModelAsync()
    {
        if (!objKnownGood || string.IsNullOrWhiteSpace(objModelName))
        {
            return;
        }

        var vClient = HttpClientFactory.CreateClient("TrStudioApi");
        try
        {
            await vClient.PostAsJsonAsync(ComfySaveRoute, new
            {
                Name = objModelName,
                Version = objVersion,
                Pinned = objPinned,
                Workflow = objWorkflowJson,
                Mapping = objMapping.Select(aRow => new { aRow.NodeInput, aRow.ParamKey, aRow.Type, aRow.Required, aRow.Default })
            });
        }
        catch
        {
            // Endpoint not yet built — the toast still confirms the intent for the visual round-trip.
        }

        ToastService.Success(
            $"Saved \"{objModelName}\" {objVersion}{(objPinned ? " · pinned known-good" : "")}.",
            "Registry model saved");
    }

    /// <summary>
    /// The exact <c>/prompt</c> request that will be sent, rebuilt live from the mapping rows so param-key
    /// edits are reflected immediately (each mapped input is templated as <c>{{paramKey}}</c>).
    /// </summary>
    private string objExactJson
    {
        get
        {
            if (objMapping.Count == 0)
            {
                return "POST /prompt\n{\n  \"prompt\": { },\n  \"client_id\": \"trstudio-admin\"\n}";
            }

            var vSb = new StringBuilder();
            vSb.AppendLine("POST /prompt");
            vSb.AppendLine("{");
            vSb.AppendLine("  \"prompt\": {");
            for (var vI = 0; vI < objMapping.Count; vI++)
            {
                var vRow = objMapping[vI];
                var vComma = vI < objMapping.Count - 1 ? "," : "";
                vSb.AppendLine($"    \"{vRow.NodeInput}\": \"{{{{{vRow.ParamKey}}}}}\"{vComma}");
            }
            vSb.AppendLine("  },");
            vSb.AppendLine("  \"client_id\": \"trstudio-admin\"");
            vSb.Append('}');
            return vSb.ToString();
        }
    }

    private static string MissingPackFor(string aClassType) => aClassType switch
    {
        "FaceDetailer" or "UltralyticsDetectorProvider" => "ComfyUI-Impact-Pack",
        _ => $"custom node ({aClassType})"
    };

    private static string NodeToneClass(string aState) => aState switch
    {
        "ok" => "badge-ok",
        "err" => "badge-danger",
        "run" => "badge-brand",
        _ => string.Empty
    };

    private static string NodeIcClass(string aState) => aState switch
    {
        "ok" => "comfy-ic-ok",
        "err" => "comfy-ic-err",
        "run" => "comfy-ic-run",
        _ => "comfy-ic-idle"
    };

    private static string NodeGlyph(string aState) => aState switch
    {
        "ok" => "✓",
        "err" => "✕",
        "run" => "●",
        _ => "·"
    };

    /// <summary>Base ComfyUI node classes assumed installed; anything else trips the missing-dependency path.</summary>
    private string[] objBaseNodes =
    {
        "KSampler", "CheckpointLoaderSimple", "CLIPTextEncode", "VAEDecode", "VAEEncode",
        "SaveImage", "LoadImage", "EmptyLatentImage", "LatentUpscale", "ControlNetApply"
    };

    /// <summary>A parsed ComfyUI node (id + class + current smoke-test state).</summary>
    private sealed class NodeRow
    {
        public NodeRow(string aId, string aClassType, string aState)
        {
            Id = aId;
            ClassType = aClassType;
            State = aState;
        }

        public string Id { get; }
        public string ClassType { get; }
        public string State { get; set; }
    }

    /// <summary>An editable node-input → registry-param mapping row; edits persist for the session.</summary>
    private sealed class MappingRow
    {
        public string NodeInput { get; set; } = string.Empty;
        public string ClassType { get; set; } = string.Empty;
        public string ParamKey { get; set; } = string.Empty;
        public string Type { get; set; } = "string";
        public bool Required { get; set; }
        public string? Default { get; set; }
    }

    /// <summary>A per-node smoke-test line in the run/debug panel.</summary>
    private sealed record NodeStatus(string Name, string State, string Detail);
}
