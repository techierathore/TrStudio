@page "/admin/models"
@inject IHttpClientFactory HttpClientFactory
@inject ToastService ToastService
@inject IAuthSession AuthSession
@using TrBlazeUI.Components.Table
@using TrBlazeUI.Components.NativeSelect

@*
    Admin Model library (REQ-UI-076). A search box, task Tabs and source Select over a results table
    (name, source, task, size, min VRAM, license Badge — restrictive licenses flagged) with one-click
    Install and footer page buttons; a right rail carrying the resumable install queue (Progress,
    Pause/Resume/Cancel, speed + destination from /admin/installs), a destination card (free disk from
    the live capability report) and an over-disk Alert shown only when a model does not fit that disk;
    plus a registry hand-off Alert. Browses ENABLED sources only, with a no-sources empty state linking
    to /admin/sources. The model list is curated (no source-browse endpoint yet); every row's install
    state is the real install queue's. Control names follow docs/mockups/admin-models.html.
*@

<PageTitle>TrStudio — Model Library</PageTitle>

<div class="stack models-page">
    <div class="flex-between" style="flex-wrap:wrap;gap:12px">
        <div>
            <h1 class="page-title">Model Library</h1>
            <p class="page-sub" style="margin-bottom:0">
                Browse and install open models from your enabled sources@(objEnabledSources.Count > 0 ? $" — {string.Join(" and ", objEnabledSources)}" : "").
            </p>
        </div>
        <div class="flex-row">
            <Badge Variant="BadgeVariant.Outline" Class="@(objEnabledSources.Count > 0 ? "badge-ok" : "")" data-testid="badge-status">
                <span class="dot @(objEnabledSources.Count > 0 ? "ok" : "")"></span> @objEnabledSources.Count sources enabled
            </Badge>
            <Button Href="/admin/sources" Variant="ButtonVariant.Outline" data-testid="link-manage-sources">Manage sources</Button>
        </div>
    </div>

    @if (objNoSources)
    {
        <Card data-testid="no-sources-empty">
            <CardContent Class="pt-6">
                <div style="text-align:center;padding:24px 16px">
                    <div style="display:flex;justify-content:center;margin-bottom:10px;color:var(--muted-foreground)">
                        <LucideIcon Name="package-open" Size="40" />
                    </div>
                    <h3 class="card-h3" style="margin:0 0 4px">No enabled model sources</h3>
                    <p class="kpi-lbl" style="max-width:440px;margin:0 auto 14px">
                        The library browses enabled sources only. Add or enable a Hugging Face, Civitai or
                        custom source to discover installable models.
                    </p>
                    <Button Href="/admin/sources">
                        <LucideIcon Name="link" Size="14" />
                        Go to Model Sources
                    </Button>
                </div>
            </CardContent>
        </Card>
    }
    else
    {
        <div class="filter-bar">
            <Input @bind-Value="objSearch" @bind-Value:after="ResetPage" Placeholder="Search models… e.g. avatar, sdxl, tts" Class="max-w-[260px]" style="max-width:260px"
                   aria-label="Search models" data-testid="field-search-models-e-g-avatar" />
            <Tabs Value="@objTask" ValueChanged="OnTaskChanged">
                <TabsList Class="models-seg">
                    <TabsTrigger Value="all" data-testid="btn-all">All</TabsTrigger>
                    <TabsTrigger Value="image" data-testid="btn-image">Image</TabsTrigger>
                    <TabsTrigger Value="video" data-testid="btn-video">Video</TabsTrigger>
                    <TabsTrigger Value="avatar" data-testid="btn-avatar">Avatar</TabsTrigger>
                    <TabsTrigger Value="voice" data-testid="btn-voice">Voice</TabsTrigger>
                </TabsList>
            </Tabs>
            <NativeSelect TValue="string" Value="@objSourceFilter" ValueChanged="@((string? aValue) => OnSourceChanged(aValue))"
                          Class="w-auto" style="max-width:170px" aria-label="Source" data-testid="field-2">
                <option value="all">All sources</option>
                @foreach (var vSource in objEnabledSources)
                {
                    <option value="@vSource">@vSource</option>
                }
            </NativeSelect>
            <span class="grow"></span>
            <span class="kpi-lbl">@FilteredCatalog.Count models · curated for TrStudio</span>
        </div>

        <div class="models-layout">
            <Card Class="p-0 overflow-hidden" data-testid="card-1">
                <div class="table-scroll">
                    <Table Class="models-table" data-testid="table-1">
                        <TableHeader>
                            <TableRow>
                                <TableHead>Model</TableHead>
                                <TableHead>Source</TableHead>
                                <TableHead>Task</TableHead>
                                <TableHead>Size</TableHead>
                                <TableHead>Min VRAM</TableHead>
                                <TableHead>License</TableHead>
                                <TableHead Class="text-right">Action</TableHead>
                            </TableRow>
                        </TableHeader>
                        <TableBody>
                            @if (objLoading)
                            {
                                <TableRow><TableCell colspan="7" Class="kpi-lbl">Loading models…</TableCell></TableRow>
                            }
                            else if (PagedCatalog.Count == 0)
                            {
                                <TableRow><TableCell colspan="7" Class="kpi-lbl">No models match these filters.</TableCell></TableRow>
                            }
                            @{
                                var vStatusIndex = 1;
                                var vInstallIndex = 0;
                                var vVolumeIndex = 0;
                            }
                            @foreach (var vRow in objLoading ? new List<CatalogRow>() : PagedCatalog)
                            {
                                var vState = StateOf(vRow);
                                string vActionId;
                                if (vState.Kind == CatalogInstallState.Available)
                                {
                                    vActionId = Numbered("btn-install", ++vInstallIndex);
                                }
                                else if (vState.Kind == CatalogInstallState.NeedsVolume)
                                {
                                    vActionId = Numbered("badge-needs-volume", ++vVolumeIndex);
                                }
                                else
                                {
                                    vActionId = Numbered("badge-status", ++vStatusIndex);
                                }
                                <TableRow>
                                    <TableCell>
                                        <div><b>@vRow.Name</b></div>
                                        <div class="kpi-lbl" style="font-size:11px">@vRow.Subtitle</div>
                                    </TableCell>
                                    <TableCell>@vRow.Source</TableCell>
                                    <TableCell>@vRow.TaskLabel</TableCell>
                                    <TableCell>@vRow.SizeLabel</TableCell>
                                    <TableCell>@vRow.MinVram</TableCell>
                                    <TableCell>
                                        <Badge Variant="BadgeVariant.Outline" Class="@(vRow.IsRestrictive ? "badge-warn" : "badge-ok")" data-testid="@LicenseTestId(vRow.License)">@vRow.License</Badge>
                                    </TableCell>
                                    <TableCell Class="text-right">
                                        @switch (vState.Kind)
                                        {
                                            case CatalogInstallState.Available:
                                                <Button Size="ButtonSize.Small" Class="models-install" OnClick="@(() => InstallAsync(vRow))" data-testid="@vActionId">Install</Button>
                                                break;
                                            case CatalogInstallState.Installing:
                                                <Badge Variant="BadgeVariant.Outline" Class="badge-brand" data-testid="@vActionId"><span class="dot brand"></span> @vState.Label</Badge>
                                                break;
                                            case CatalogInstallState.Installed:
                                                <Badge Variant="BadgeVariant.Outline" Class="badge-ok" data-testid="@vActionId"><span class="dot ok"></span> @vState.Label</Badge>
                                                break;
                                            case CatalogInstallState.Paused:
                                                <Badge Variant="BadgeVariant.Outline" data-testid="@vActionId"><span class="dot warn"></span> @vState.Label</Badge>
                                                break;
                                            default:
                                                <Badge Variant="BadgeVariant.Outline" Class="badge-warn" data-testid="@vActionId" title="Over 10 GB — installs to the RunPod network volume">Needs volume</Badge>
                                                break;
                                        }
                                    </TableCell>
                                </TableRow>
                            }
                        </TableBody>
                    </Table>
                </div>
                <div class="flex-row models-pager" style="padding:12px 16px;gap:6px;flex-wrap:wrap">
                    <span class="kpi-lbl">Showing @PageRangeLabel of @FilteredCatalog.Count models</span>
                    <span class="grow"></span>
                    <Button Size="ButtonSize.Small" Variant="ButtonVariant.Outline"
                            Disabled="@(objPage <= 1)" OnClick="@(() => OnPageChanged(objPage - 1))" data-testid="btn-prev">Prev</Button>
                    @for (var vIndex = 1; vIndex <= TotalPages; vIndex++)
                    {
                        var vTarget = vIndex;
                        <Button Size="ButtonSize.Small" Variant="@(vTarget == objPage ? ButtonVariant.Default : ButtonVariant.Outline)"
                                OnClick="@(() => OnPageChanged(vTarget))" data-testid="@($"btn-{vTarget}")">@vTarget</Button>
                    }
                    <Button Size="ButtonSize.Small" Variant="ButtonVariant.Outline"
                            Disabled="@(objPage >= TotalPages)" OnClick="@(() => OnPageChanged(objPage + 1))" data-testid="btn-next">Next</Button>
                </div>
            </Card>

            <div class="stack">
                <Card data-testid="card-install-queue">
                    <CardContent Class="pt-6">
                        <div class="flex-between">
                            <h3 class="card-h3" style="margin:0">Install queue</h3>
                            <Badge Variant="BadgeVariant.Outline" Class="badge-brand" data-testid="badge-2-active">@objQueue.Count(aItem => aItem.IsActive) active</Badge>
                        </div>

                        @if (objQueue.Count == 0)
                        {
                            <div class="kpi-lbl" style="margin-top:10px">No installs yet. Install a model to see live progress here.</div>
                        }
                        @{
                            var vStateCounts = new Dictionary<string, int>();
                            var vProgressIndex = 0;
                            var vPauseIndex = 0;
                            var vResumeIndex = 0;
                            var vCancelIndex = 0;
                        }
                        @foreach (var vItem in objQueue)
                        {
                            vStateCounts[vItem.State] = vStateCounts.GetValueOrDefault(vItem.State) + 1;
                            var vStateId = Numbered($"badge-{vItem.State}", vStateCounts[vItem.State]);
                            <div class="q-item">
                                <div class="flex-row">
                                    <span style="font-weight:600;font-size:13px">@vItem.DisplayName</span>
                                    <span class="grow"></span>
                                    <Badge Variant="BadgeVariant.Outline" Class="@vItem.StateTone" data-testid="@vStateId">@vItem.StateLabel</Badge>
                                </div>
                                @if (vItem.ShowProgress)
                                {
                                    <Progress Value="@vItem.Progress" Class="models-prog" IndicatorClass="@(vItem.State == "paused" ? "hw-ind opacity-60" : "hw-ind")" data-testid="@Numbered("progress", ++vProgressIndex)" />
                                    <div class="flex-row" style="font-size:11.5px;margin-top:4px">
                                        <span class="kpi-lbl">@vItem.SizeLabel</span>
                                        <span class="grow"></span>
                                        <span class="kpi-lbl">→ @vItem.Destination</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="kpi-lbl" style="font-size:11.5px;margin-top:4px">@vItem.SizeLabel · @vItem.Destination</div>
                                }
                                @if (vItem.State is "downloading" or "queued")
                                {
                                    <div class="flex-row" style="margin-top:8px">
                                        <Button Size="ButtonSize.Small" Variant="ButtonVariant.Outline" Class="models-qbtn" OnClick="@(() => ControlInstallAsync(vItem, "pause"))" data-testid="@Numbered("btn-pause", ++vPauseIndex)">Pause</Button>
                                        <Button Size="ButtonSize.Small" Variant="ButtonVariant.Ghost" Class="models-qbtn" OnClick="@(() => ControlInstallAsync(vItem, "cancel"))" data-testid="@Numbered("btn-cancel", ++vCancelIndex)">Cancel</Button>
                                    </div>
                                }
                                else if (vItem.State == "paused")
                                {
                                    <div class="flex-row" style="margin-top:8px">
                                        <Button Size="ButtonSize.Small" Variant="ButtonVariant.Outline" Class="models-qbtn" OnClick="@(() => ControlInstallAsync(vItem, "resume"))" data-testid="@Numbered("btn-resume", ++vResumeIndex)">Resume</Button>
                                        <Button Size="ButtonSize.Small" Variant="ButtonVariant.Ghost" Class="models-qbtn" OnClick="@(() => ControlInstallAsync(vItem, "cancel"))" data-testid="@Numbered("btn-cancel", ++vCancelIndex)">Cancel</Button>
                                    </div>
                                }
                            </div>
                        }
                    </CardContent>
                </Card>

                <Card data-testid="card-destination">
                    <CardContent Class="pt-6">
                        <h3 class="card-h3">Destination</h3>
                        <div class="kv-row"><span class="kv-lbl">Local disk free</span><b>@(objFreeDiskGb is { } vFree ? $"{vFree:0} GB" : "not measured")</b></div>
                        <div class="kv-row"><span class="kv-lbl">RunPod network volume</span><b>models over 10 GB</b></div>
                        <p class="kpi-lbl" style="margin:8px 0 0">
                            Models over 10 GB install to the RunPod network volume by default; local (Mac) models
                            stay on disk. Downloads resume automatically after interruption.
                        </p>
                    </CardContent>
                </Card>

                @if (OverDiskModel is { } vOver)
                {
                    <Alert Variant="AlertVariant.Warning" AccentBorder="true" data-testid="alert-warn">
                        <LucideIcon Name="triangle-alert" Size="16" />
                        <AlertTitle>@vOver.Name exceeds free local disk</AlertTitle>
                        <AlertDescription>
                            @vOver.SizeLabel needed, @HeadroomGb GB headroom reserved — install to the RunPod network volume, or free
                            space in <a href="/admin/setup/hardware" class="models-link" data-testid="link-hardware-setup">Hardware &amp; Setup</a>.
                        </AlertDescription>
                    </Alert>
                }

                <Alert Variant="AlertVariant.Info" AccentBorder="true" data-testid="alert-info">
                    <AlertDescription>
                        Restrictive licenses are flagged <Badge Variant="BadgeVariant.Outline" Class="badge-warn" data-testid="badge-amber">amber</Badge>.
                        Installed models still need a registry row before creators can use them —
                        <a href="/admin/registry" class="models-link" data-testid="link-registry-providers">Registry &amp; Providers →</a>
                    </AlertDescription>
                </Alert>
            </div>
        </div>
    }
</div>

@code {
    private List<QueueItem> objQueue = new();
    private List<string> objEnabledSources = new();
    private Dictionary<string, Guid> objSourceIds = new(StringComparer.OrdinalIgnoreCase);
    private double? objFreeDiskGb;

    private bool objLoading = true;
    private bool objNoSources;

    private string objSearch = string.Empty;
    private string? objTask = "all";
    private string? objSourceFilter = "all";
    private int objPage = 1;
    private const int PageSize = 8;

    /// <summary>Free space kept back on the local disk before a model may install there.</summary>
    private const int HeadroomGb = 12;

    /// <summary>Models over this size install to the RunPod network volume by default (the engine's planner rule).</summary>
    private const double NetworkVolumeThresholdGb = 10.0;

    /// <summary>
    /// The curated open-model list, narrowed to sources that are enabled, then by search text, the task tab
    /// and the source Select. There is no live source-browse endpoint yet, so the list itself is curated;
    /// every row's install state comes from the real install queue.
    /// </summary>
    private List<CatalogRow> FilteredCatalog => Catalog.Where(aRow =>
        objEnabledSources.Contains(aRow.Source, StringComparer.OrdinalIgnoreCase) &&
        (string.IsNullOrWhiteSpace(objSearch) ||
            aRow.Name.Contains(objSearch, StringComparison.OrdinalIgnoreCase) ||
            aRow.Subtitle.Contains(objSearch, StringComparison.OrdinalIgnoreCase)) &&
        (objTask == "all" || aRow.Tasks.Contains(objTask ?? "all", StringComparer.OrdinalIgnoreCase)) &&
        (objSourceFilter == "all" || string.Equals(aRow.Source, objSourceFilter, StringComparison.OrdinalIgnoreCase)))
        .ToList();

    /// <summary>The current page of the filtered catalog.</summary>
    private List<CatalogRow> PagedCatalog => FilteredCatalog.Skip((objPage - 1) * PageSize).Take(PageSize).ToList();

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredCatalog.Count / (double)PageSize));

    private string PageRangeLabel
    {
        get
        {
            var vTotal = FilteredCatalog.Count;
            if (vTotal == 0)
            {
                return "0";
            }

            var vStart = (objPage - 1) * PageSize + 1;
            var vEnd = Math.Min(objPage * PageSize, vTotal);
            return $"{vStart}–{vEnd}";
        }
    }

    /// <summary>
    /// The largest browsable model not yet installed that does not fit the measured free local disk once
    /// the headroom is kept back; null when the disk is not measured or every model fits.
    /// </summary>
    private CatalogRow? OverDiskModel => objFreeDiskGb is not { } vFree
        ? null
        : FilteredCatalog
            .Where(aRow => StateOf(aRow).Kind is CatalogInstallState.Available or CatalogInstallState.NeedsVolume)
            .Where(aRow => aRow.SizeGb + HeadroomGb > vFree)
            .OrderByDescending(aRow => aRow.SizeGb)
            .FirstOrDefault();

    /// <summary>
    /// Loads the enabled sources, the install queue and the free disk AFTER the first interactive render —
    /// once <see cref="IAuthSession"/> can hydrate the bearer token so the admin calls carry it.
    /// </summary>
    /// <param name="aFirstRender">Whether this is the component's first render.</param>
    protected override async Task OnAfterRenderAsync(bool aFirstRender)
    {
        if (!aFirstRender)
        {
            return;
        }

        var vHasSession = await AuthSession.EnsureLoadedAsync();
        await LoadAsync(vHasSession);
        objLoading = false;
        StateHasChanged();
    }

    /// <summary>
    /// Reads the enabled sources, the install queue and the capability report from their admin endpoints.
    /// When the sources call reports zero enabled sources, the page swaps to the no-sources empty state that
    /// links to /admin/sources.
    /// </summary>
    /// <param name="aHasSession">Whether a signed-in session is present.</param>
    private async Task LoadAsync(bool aHasSession)
    {
        if (!aHasSession)
        {
            return;
        }

        var vClient = HttpClientFactory.CreateClient("TrStudioApi");

        try
        {
            var vResponse = await vClient.GetAsync(ApiRoutes.Sources);
            if (vResponse.IsSuccessStatusCode)
            {
                var vSources = await vResponse.Content.ReadFromJsonAsync<List<ModelSource>>();
                var vEnabled = (vSources ?? new()).Where(aSource => aSource.IsEnabled).ToList();
                objNoSources = vEnabled.Count == 0;
                objEnabledSources = vEnabled.Select(aSource => aSource.Name).ToList();
                objSourceIds = vEnabled.GroupBy(aSource => aSource.Name, StringComparer.OrdinalIgnoreCase)
                    .ToDictionary(aGroup => aGroup.Key, aGroup => aGroup.First().SourceId, StringComparer.OrdinalIgnoreCase);
            }
        }
        catch
        {
            // Sources endpoint not reachable — the library shows no sources rather than invented ones.
        }

        await LoadQueueAsync(vClient);

        try
        {
            var vResponse = await vClient.GetAsync(ApiRoutes.Capabilities);
            if (vResponse.IsSuccessStatusCode)
            {
                var vReport = await vResponse.Content.ReadFromJsonAsync<HostCapabilityReport>();
                objFreeDiskGb = vReport?.FreeDiskGb;
            }
        }
        catch
        {
            // Capability report not reachable — the destination card says the disk is not measured.
        }
    }

    private async Task LoadQueueAsync(HttpClient aClient)
    {
        try
        {
            var vInstalls = await aClient.GetAsync(ApiRoutes.Installs);
            if (vInstalls.IsSuccessStatusCode)
            {
                var vItems = await vInstalls.Content.ReadFromJsonAsync<List<ModelInstallItem>>();
                objQueue = (vItems ?? new()).Where(aItem => aItem.State != "cancelled")
                    .OrderBy(aItem => aItem.State switch { "downloading" or "queued" => 0, "paused" => 1, "failed" => 2, _ => 3 })
                    .ThenByDescending(aItem => aItem.CreatedUtc).Select(MapQueue).ToList();
            }
        }
        catch
        {
            // Installs endpoint not reachable — the queue stays empty.
            // (Order: running first, then paused, failed, finished; newest first within each.)
        }
    }

    private void OnTaskChanged(string? aTask)
    {
        objTask = aTask ?? "all";
        objPage = 1;
    }

    private void OnSourceChanged(string? aSource)
    {
        objSourceFilter = aSource ?? "all";
        objPage = 1;
    }

    private void ResetPage() => objPage = 1;

    private void OnPageChanged(int aPage)
    {
        objPage = Math.Clamp(aPage, 1, TotalPages);
    }

    /// <summary>A control name with the mockup's numbering: the first is bare, the next ones get -2, -3, …</summary>
    private static string Numbered(string aPrefix, int aIndex) => aIndex <= 1 ? aPrefix : $"{aPrefix}-{aIndex}";

    /// <summary>The license Badge's control name: badge- plus the license in lower case, words joined by dashes.</summary>
    private static string LicenseTestId(string aLicense) =>
        "badge-" + System.Text.RegularExpressions.Regex.Replace(aLicense.ToLowerInvariant(), "[^a-z0-9]+", "-").Trim('-');

    /// <summary>
    /// A catalog row's install state, read from the real install queue: a running or queued install of any
    /// of its files shows its progress, a paused one shows paused, a completed main file shows Installed.
    /// Otherwise a model over 10 GB needs the network volume and a smaller one offers Install.
    /// </summary>
    private (CatalogInstallState Kind, string Label) StateOf(CatalogRow aRow)
    {
        foreach (var vPart in aRow.Parts)
        {
            var vItem = objQueue.FirstOrDefault(aItem => aItem.IsActive &&
                string.Equals(aItem.ModelName, vPart.Reference, StringComparison.OrdinalIgnoreCase));
            if (vItem is null)
            {
                continue;
            }

            var vPrefix = string.IsNullOrEmpty(vPart.Label) ? string.Empty : vPart.Label + " ";
            if (vItem.State == "paused")
            {
                return (CatalogInstallState.Paused, vPrefix.Length == 0 ? "Paused" : $"{vPrefix}paused");
            }

            var vVerb = vPrefix.Length == 0 ? "Installing" : $"{vPrefix}installing";
            return (CatalogInstallState.Installing, vItem.State == "queued" ? $"{vVerb} · queued" : $"{vVerb} {vItem.Progress:0}%");
        }

        var vMain = aRow.Parts[0].Reference;
        if (objQueue.Any(aItem => aItem.State == "completed" && string.Equals(aItem.ModelName, vMain, StringComparison.OrdinalIgnoreCase)))
        {
            return (CatalogInstallState.Installed, "Installed");
        }

        return aRow.SizeGb > NetworkVolumeThresholdGb
            ? (CatalogInstallState.NeedsVolume, "Needs volume")
            : (CatalogInstallState.Available, "Install");
    }

    /// <summary>Starts a resumable install of the row's main file from its enabled source, then reloads the queue.</summary>
    private async Task InstallAsync(CatalogRow aRow)
    {
        if (!objSourceIds.TryGetValue(aRow.Source, out var vSourceId))
        {
            ToastService.Error($"{aRow.Source} is not enabled — enable it on Model Sources first.", "Model library");
            return;
        }

        var vRequest = new ModelInstallStartRequest
        {
            ModelName = aRow.Parts[0].Reference,
            SourceId = vSourceId,
            Destination = null
        };

        var vClient = HttpClientFactory.CreateClient("TrStudioApi");
        try
        {
            var vResponse = await vClient.PostAsJsonAsync(ApiRoutes.Installs, vRequest);
            if (vResponse.IsSuccessStatusCode)
            {
                await LoadQueueAsync(vClient);
                ToastService.Success($"Queued \"{aRow.Name}\" for install.", "Model library");
                return;
            }

            ToastService.Error($"Could not start \"{aRow.Name}\" ({(int)vResponse.StatusCode}).", "Model library");
        }
        catch (Exception vException)
        {
            ToastService.Error($"Could not start \"{aRow.Name}\": {vException.Message}", "Model library");
        }
    }

    /// <summary>Applies pause/resume/cancel to an install, then reloads the queue from the engine.</summary>
    private async Task ControlInstallAsync(QueueItem aItem, string aAction)
    {
        var vClient = HttpClientFactory.CreateClient("TrStudioApi");
        try
        {
            var vResponse = await vClient.PostAsync($"{ApiRoutes.Installs}/{aItem.InstallId}/{aAction}", content: null);
            if (!vResponse.IsSuccessStatusCode)
            {
                ToastService.Error($"{aItem.DisplayName}: {aAction} failed ({(int)vResponse.StatusCode}).", "Install queue");
                return;
            }
        }
        catch (Exception vException)
        {
            ToastService.Error($"{aItem.DisplayName}: {aAction} failed — {vException.Message}", "Install queue");
            return;
        }

        await LoadQueueAsync(vClient);
        ToastService.Show($"{aItem.DisplayName}: {aAction} requested.", "Install queue");
    }

    /// <summary>Where an install lands, in words: the RunPod network volume or this machine's disk.</summary>
    private static string DestinationLabel(string aDestination) =>
        aDestination.Contains("runpod", StringComparison.OrdinalIgnoreCase) ? "RunPod network volume" : "local disk";

    private static QueueItem MapQueue(ModelInstallItem aItem)
    {
        var vState = aItem.State.ToLowerInvariant();
        var vProgress = aItem.TotalBytes is > 0
            ? aItem.DownloadedBytes / (double)aItem.TotalBytes.Value * 100.0
            : 0.0;
        var vTone = vState switch
        {
            "paused" or "failed" => "badge-warn",
            "completed" => "badge-ok",
            _ => "badge-brand"
        };

        var vSizeLabel = vState switch
        {
            "completed" => Gb(aItem.TotalBytes ?? aItem.DownloadedBytes),
            "paused" or "failed" when aItem.TotalBytes is > 0 => $"{GbNumber(aItem.DownloadedBytes)} / {Gb(aItem.TotalBytes.Value)} · resumable",
            _ when aItem.TotalBytes is > 0 =>
                $"{GbNumber(aItem.DownloadedBytes)} / {Gb(aItem.TotalBytes.Value)} · {vProgress:0}%" +
                (aItem.SpeedBytesPerSec is > 0 ? $" · {aItem.SpeedBytesPerSec.Value / 1_000_000.0:0} MB/s" : string.Empty),
            _ => Gb(aItem.DownloadedBytes)
        };

        return new QueueItem
        {
            InstallId = aItem.InstallId,
            ModelName = aItem.ModelName,
            DisplayName = DisplayNameOf(aItem.ModelName),
            State = vState,
            StateLabel = vState,
            StateTone = vTone,
            Progress = vProgress,
            ShowProgress = vState is "downloading" or "paused" or "queued" or "failed",
            SizeLabel = vSizeLabel,
            Destination = DestinationLabel(aItem.Destination)
        };
    }

    /// <summary>The queue's name for an install: the curated name of that file when it is in the list, else its reference.</summary>
    private static string DisplayNameOf(string aReference) =>
        Catalog.SelectMany(aRow => aRow.Parts).FirstOrDefault(aPart =>
            string.Equals(aPart.Reference, aReference, StringComparison.OrdinalIgnoreCase))?.QueueName ?? aReference;

    private static string GbNumber(long aBytes) => $"{aBytes / 1_000_000_000.0:0.0}";

    private static string Gb(long aBytes) => aBytes >= 1_000_000_000
        ? $"{aBytes / 1_000_000_000.0:0.0} GB"
        : $"{aBytes / 1_000_000.0:0} MB";

