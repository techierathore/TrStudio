    private enum CatalogInstallState
    {
        Available,
        Installing,
        Paused,
        Installed,
        NeedsVolume
    }

    /// <summary>One file of a catalog model: its source reference, its name in the queue, and the word that prefixes its state.</summary>
    private sealed record CatalogPart(string Reference, string QueueName, string Label);

    private sealed class CatalogRow
    {
        public CatalogRow(string aName, string aSubtitle, string aSource, string[] aTasks, string aTaskLabel,
            double aSizeGb, string aMinVram, string aLicense, bool aIsRestrictive, params CatalogPart[] aParts)
        {
            Name = aName;
            Subtitle = aSubtitle;
            Source = aSource;
            Tasks = aTasks;
            TaskLabel = aTaskLabel;
            SizeGb = aSizeGb;
            MinVram = aMinVram;
            License = aLicense;
            IsRestrictive = aIsRestrictive;
            Parts = aParts;
        }

        public string Name { get; }
        public string Subtitle { get; }
        public string Source { get; }
        public string[] Tasks { get; }
        public string TaskLabel { get; }
        public double SizeGb { get; }
        public string SizeLabel => SizeGb >= 1 ? $"{SizeGb:0.0} GB" : $"{SizeGb * 1000:0} MB";
        public string MinVram { get; }
        public string License { get; }
        public bool IsRestrictive { get; }
        public CatalogPart[] Parts { get; }
    }

    private sealed class QueueItem
    {
        public Guid InstallId { get; set; }
        public string ModelName { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
        public string State { get; set; } = string.Empty;
        public string StateLabel { get; set; } = string.Empty;
        public string StateTone { get; set; } = string.Empty;
        public double Progress { get; set; }
        public bool ShowProgress { get; set; }
        public string SizeLabel { get; set; } = string.Empty;
        public string Destination { get; set; } = string.Empty;

        /// <summary>Whether the item is still downloading/queued/paused (counts toward the active badge).</summary>
        public bool IsActive => State is "downloading" or "queued" or "paused";
    }
}
