@page "/admin/models"
@inject IHttpClientFactory HttpClientFactory
@inject ToastService ToastService
@inject IAuthSession AuthSession

@*
    Admin Model library (REQ-UI-076). A search box, task Tabs and source Select over a results table
    (name, source, task, size, min VRAM, license Badge — restrictive licenses flagged) with one-click
    Install and footer Pagination; a right rail carrying the resumable install queue (Progress,
    Pause/Resume/Cancel, speed + destination from /admin/installs), a destination card and an
    over-disk Alert; plus a registry hand-off Alert. Browses ENABLED sources only, with a no-sources
    empty state linking to /admin/sources.
*@

<PageTitle>TrStudio — Model Library</PageTitle>

<div class="stack">
    <div class="flex-between">
        <div>
            <h1 class="page-title">Model Library</h1>
            <p class="page-sub" style="margin-bottom:0">
                Browse and install open models from your enabled sources.
            </p>
        </div>
        <div class="flex-row">
            <Badge Variant="BadgeVariant.Outline" Class="@(objEnabledSources.Count > 0 ? "badge-ok" : "")">
                <span class="dot @(objEnabledSources.Count > 0 ? "ok" : "")"></span> @objEnabledSources.Count sources enabled
            </Badge>
            <Button Href="/admin/sources" Variant="ButtonVariant.Outline">Manage sources</Button>
        </div>
    </div>

    @if (objNoSources)
    {
        <Card data-testid="no-sources-empty">
            <CardContent Class="pt-6">
                <div style="text-align:center;padding:24px 16px">
                    <div style="display:flex;justify-content:center;margin-bottom:10px;color:var(--muted-foreground)">
                        <LucideIcon Name="package-open" Size="40" />
                    </div>
                    <h3 class="card-h3" style="margin:0 0 4px">No enabled model sources</h3>
                    <p class="kpi-lbl" style="max-width:440px;margin:0 auto 14px">
                        The library browses enabled sources only. Add or enable a Hugging Face, Civitai or
                        custom source to discover installable models.
                    </p>
                    <Button Href="/admin/sources">
                        <LucideIcon Name="link" Size="14" />
                        Go to Model Sources
                    </Button>
                </div>
            </CardContent>
        </Card>
    }
    else
    {
        <div class="filter-bar">
            <Input @bind-Value="objSearch" Placeholder="Search models… e.g. avatar, sdxl, tts" Class="max-w-[260px]" />
            <Tabs Value="@objTask" ValueChanged="OnTaskChanged">
                <TabsList>
                    <TabsTrigger Value="all">All</TabsTrigger>
                    <TabsTrigger Value="image">Image</TabsTrigger>
                    <TabsTrigger Value="video">Video</TabsTrigger>
                    <TabsTrigger Value="avatar">Avatar</TabsTrigger>
                    <TabsTrigger Value="voice">Voice</TabsTrigger>
                </TabsList>
            </Tabs>
            <Select @bind-Value="objSourceFilter" TValue="string" Class="max-w-[170px]">
                <SelectTrigger><SelectValue Placeholder="All sources" /></SelectTrigger>
                <SelectContent>
                    <SelectItem Value="@("all")" Text="All sources" TValue="string">All sources</SelectItem>
                    @foreach (var vSource in objEnabledSources)
                    {
                        <SelectItem Value="@vSource" Text="@vSource" TValue="string">@vSource</SelectItem>
                    }
                </SelectContent>
            </Select>
            <span class="grow"></span>
            <span class="kpi-lbl">@FilteredCatalog.Count models · sorted by downloads</span>
        </div>

        <div class="models-layout">
            <Card Class="p-0" data-testid="models-table">
                <div class="table-scroll">
                    <DataTable TData="CatalogRow" Data="@PagedCatalog" IsLoading="@objLoading" ShowToolbar="false" ShowPagination="false" InitialPageSize="@PageSize">
                        <Columns>
                            <DataTableColumn TData="CatalogRow" TValue="string" Property="@(r => r.Name)" Header="Model" Sortable>
                                <CellTemplate Context="objRow">
                                    <div><b>@objRow.Name</b></div>
                                    <div class="kpi-lbl" style="font-size:11px">@objRow.Subtitle</div>
                                </CellTemplate>
                            </DataTableColumn>
                            <DataTableColumn TData="CatalogRow" TValue="string" Property="@(r => r.Source)" Header="Source" Sortable />
                            <DataTableColumn TData="CatalogRow" TValue="string" Property="@(r => r.TaskLabel)" Header="Task" Sortable />
                            <DataTableColumn TData="CatalogRow" TValue="string" Property="@(r => r.Size)" Header="Size" />
                            <DataTableColumn TData="CatalogRow" TValue="string" Property="@(r => r.MinVram)" Header="Min VRAM" />
                            <DataTableColumn TData="CatalogRow" TValue="string" Property="@(r => r.License)" Header="License">
                                <CellTemplate Context="objRow">
                                    <Badge Variant="BadgeVariant.Outline" Class="@objRow.LicenseTone">@objRow.License</Badge>
                                </CellTemplate>
                            </DataTableColumn>
                            <DataTableColumn TData="CatalogRow" TValue="string" Property="@(r => r.Name)" Header="Action">
                                <CellTemplate Context="objRow">
                                    @if (objRow.InstallState == CatalogInstallState.Available)
                                    {
                                        <Button Size="ButtonSize.Small" OnClick="@(() => InstallAsync(objRow))">Install</Button>
                                    }
                                    else if (objRow.InstallState == CatalogInstallState.Installing)
                                    {
                                        <Badge Variant="BadgeVariant.Outline" Class="badge-brand"><span class="dot brand"></span> Installing @objRow.ProgressLabel</Badge>
                                    }
                                    else if (objRow.InstallState == CatalogInstallState.Installed)
                                    {
                                        <Badge Variant="BadgeVariant.Outline" Class="badge-ok"><span class="dot ok"></span> Installed</Badge>
                                    }
                                    else if (objRow.InstallState == CatalogInstallState.Paused)
                                    {
                                        <Badge Variant="BadgeVariant.Outline" Class="badge-warn"><span class="dot warn"></span> Paused</Badge>
                                    }
                                    else
                                    {
                                        <Badge Variant="BadgeVariant.Outline" Class="badge-warn">Needs volume</Badge>
                                    }
                                </CellTemplate>
                            </DataTableColumn>
                        </Columns>
                    </DataTable>
                </div>
                <div class="flex-row" style="padding:12px 16px" data-testid="models-pager">
                    <span class="kpi-lbl">Showing @PageRangeLabel of @FilteredCatalog.Count models</span>
                    <span class="grow"></span>
                    <Button Size="ButtonSize.Small" Variant="ButtonVariant.Outline"
                            Disabled="@(objPage <= 1)" OnClick="@(() => OnPageChanged(objPage - 1))">Prev</Button>
                    @for (var vIndex = 1; vIndex <= TotalPages; vIndex++)
                    {
                        var vTarget = vIndex;
                        <Button Size="ButtonSize.Small" Variant="@(vTarget == objPage ? ButtonVariant.Default : ButtonVariant.Outline)"
                                OnClick="@(() => OnPageChanged(vTarget))">@vTarget</Button>
                    }
                    <Button Size="ButtonSize.Small" Variant="ButtonVariant.Outline"
                            Disabled="@(objPage >= TotalPages)" OnClick="@(() => OnPageChanged(objPage + 1))">Next</Button>
                </div>
            </Card>

            <div class="stack">
                <Card data-testid="install-queue">
                    <CardContent Class="pt-6">
                        <div class="flex-between">
                            <h3 class="card-h3" style="margin:0">Install queue</h3>
                            <Badge Variant="BadgeVariant.Outline" Class="badge-brand">@objQueue.Count(aItem => aItem.IsActive) active</Badge>
                        </div>

                        @if (objQueue.Count == 0)
                        {
                            <div class="kpi-lbl" style="margin-top:10px">No installs in progress. Install a model to see live progress here.</div>
                        }
                        @foreach (var vItem in objQueue)
                        {
                            <div class="q-item">
                                <div class="flex-row">
                                    <span style="font-weight:600;font-size:13px">@vItem.ModelName</span>
                                    <span class="grow"></span>
                                    <Badge Variant="BadgeVariant.Outline" Class="@vItem.StateTone">@vItem.StateLabel</Badge>
                                </div>
                                @if (vItem.ShowProgress)
                                {
                                    <Progress Value="@vItem.Progress" Class="h-2" />
                                    <div class="flex-row" style="font-size:11.5px;margin-top:4px">
                                        <span class="kpi-lbl">@vItem.SizeLabel</span>
                                        <span class="grow"></span>
                                        <span class="kpi-lbl">→ @vItem.Destination</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="kpi-lbl" style="font-size:11.5px;margin-top:4px">@vItem.SizeLabel · @vItem.Destination</div>
                                }
                                @if (vItem.State is "downloading" or "queued")
                                {
                                    <div class="flex-row" style="margin-top:8px">
                                        <Button Size="ButtonSize.Small" Variant="ButtonVariant.Outline" OnClick="@(() => ControlInstallAsync(vItem, "pause"))">Pause</Button>
                                        <Button Size="ButtonSize.Small" Variant="ButtonVariant.Ghost" OnClick="@(() => ControlInstallAsync(vItem, "cancel"))">Cancel</Button>
                                    </div>
                                }
                                else if (vItem.State == "paused")
                                {
                                    <div class="flex-row" style="margin-top:8px">
                                        <Button Size="ButtonSize.Small" Variant="ButtonVariant.Outline" OnClick="@(() => ControlInstallAsync(vItem, "resume"))">Resume</Button>
                                        <Button Size="ButtonSize.Small" Variant="ButtonVariant.Ghost" OnClick="@(() => ControlInstallAsync(vItem, "cancel"))">Cancel</Button>
                                    </div>
                                }
                            </div>
                        }
                    </CardContent>
                </Card>

                <Card>
                    <CardContent Class="pt-6">
                        <h3 class="card-h3">Destination</h3>
                        <div class="kv-row"><span class="kv-lbl">Local disk free</span><b>412 GB</b></div>
                        <div class="kv-row"><span class="kv-lbl">RunPod network volume</span><b>1.2 TB free</b></div>
                        <p class="kpi-lbl" style="margin:8px 0 0">
                            Models over 10 GB install to the RunPod network volume by default; local (Mac) models
                            stay on disk. Downloads resume automatically after interruption.
                        </p>
                    </CardContent>
                </Card>

                <div data-testid="over-disk-alert">
                    <Alert Variant="AlertVariant.Warning" AccentBorder="true">
                        <LucideIcon Name="alert-triangle" Size="16" />
                        <AlertTitle>FLUX.1 [dev] exceeds free local disk</AlertTitle>
                        <AlertDescription>
                            23.8 GB needed, 12 GB headroom reserved — install to the RunPod network volume, or free
                            space in <a href="/admin/setup">Hardware &amp; Setup</a>.
                        </AlertDescription>
                    </Alert>
                </div>

                <Alert Variant="AlertVariant.Default">
                    <LucideIcon Name="info" Size="16" />
                    <AlertDescription>
                        Installed models still need a registry row before creators can use them —
                        <a href="/admin/registry">Registry &amp; Providers →</a>
                    </AlertDescription>
                </Alert>
            </div>
        </div>
    }
</div>

@code {
    private List<CatalogRow> objCatalog = new();
    private List<QueueItem> objQueue = new();
    private List<string> objEnabledSources = new();
    private Guid? objInstallSourceId;

    private bool objLoading = true;
    private bool objNoSources;

    private string objSearch = string.Empty;
    private string? objTask = "all";
    private string? objSourceFilter = "all";
    private int objPage = 1;
    private const int PageSize = 8;

    /// <summary>The catalog narrowed by search text, the selected task tab and the source Select.</summary>
    private List<CatalogRow> FilteredCatalog => objCatalog.Where(aRow =>
        (string.IsNullOrWhiteSpace(objSearch) ||
            aRow.Name.Contains(objSearch, StringComparison.OrdinalIgnoreCase) ||
            aRow.Subtitle.Contains(objSearch, StringComparison.OrdinalIgnoreCase)) &&
        (objTask == "all" || string.Equals(aRow.Task, objTask, StringComparison.OrdinalIgnoreCase)) &&
        (objSourceFilter == "all" || string.Equals(aRow.Source, objSourceFilter, StringComparison.OrdinalIgnoreCase)))
        .ToList();

    /// <summary>The current page of the filtered catalog.</summary>
    private List<CatalogRow> PagedCatalog => FilteredCatalog.Skip((objPage - 1) * PageSize).Take(PageSize).ToList();

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredCatalog.Count / (double)PageSize));

    private string PageRangeLabel
    {
        get
        {
            var vTotal = FilteredCatalog.Count;
            if (vTotal == 0)
            {
                return "0";
            }

            var vStart = (objPage - 1) * PageSize + 1;
            var vEnd = Math.Min(objPage * PageSize, vTotal);
            return $"{vStart}–{vEnd}";
        }
    }

    /// <summary>
    /// Loads the enabled sources and install queue AFTER the first interactive render — once
    /// <see cref="IAuthSession"/> can hydrate the bearer token so the admin calls carry it. The
    /// browsable catalog is representative (there is no source-browse endpoint yet); the install
    /// queue and enabled-source list are live.
    /// </summary>
    /// <param name="aFirstRender">Whether this is the component's first render.</param>
    protected override async Task OnAfterRenderAsync(bool aFirstRender)
    {
        if (!aFirstRender)
        {
            return;
        }

        objCatalog = BuildRepresentativeCatalog();
        objQueue = BuildRepresentativeQueue();
        objEnabledSources = new List<string> { "Hugging Face", "Civitai" };

        var vHasSession = await AuthSession.EnsureLoadedAsync();
        await LoadAsync(vHasSession);
        objLoading = false;
        StateHasChanged();
    }

    /// <summary>
    /// Enriches the enabled-source list and install queue from their admin endpoints. When the
    /// authenticated sources call reports zero enabled sources, the page swaps to the no-sources empty
    /// state that links to /admin/sources.
    /// </summary>
    /// <param name="aHasSession">Whether a signed-in session is present.</param>
    private async Task LoadAsync(bool aHasSession)
    {
        if (!aHasSession)
        {
            return;
        }

        var vClient = HttpClientFactory.CreateClient("TrStudioApi");

        try
        {
            var vResponse = await vClient.GetAsync(ApiRoutes.Sources);
            if (vResponse.IsSuccessStatusCode)
            {
                var vSources = await vResponse.Content.ReadFromJsonAsync<List<ModelSource>>();
                if (vSources is not null)
                {
                    var vEnabled = vSources.Where(aSource => aSource.IsEnabled).ToList();
                    objNoSources = vEnabled.Count == 0;
                    if (vEnabled.Count > 0)
                    {
                        objEnabledSources = vEnabled.Select(aSource => aSource.Name).ToList();
                        objInstallSourceId = vEnabled[0].SourceId;
                    }
                }
            }
        }
        catch
        {
            // Sources endpoint not reachable — keep the representative enabled-source list.
        }

        try
        {
            var vInstalls = await vClient.GetAsync(ApiRoutes.Installs);
            if (vInstalls.IsSuccessStatusCode)
            {
                var vItems = await vInstalls.Content.ReadFromJsonAsync<List<ModelInstallItem>>();
                if (vItems is { Count: > 0 })
                {
                    objQueue = vItems.Select(MapQueue).ToList();
                }
            }
        }
        catch
        {
            // Installs endpoint not reachable — keep the representative install queue.
        }
    }

    private void OnTaskChanged(string? aTask)
    {
        objTask = aTask ?? "all";
        objPage = 1;
    }

    private void OnPageChanged(int aPage)
    {
        objPage = aPage;
    }

    /// <summary>Starts a resumable install for the chosen catalog model against an enabled source.</summary>
    private async Task InstallAsync(CatalogRow aRow)
    {
        var vRequest = new ModelInstallStartRequest
        {
            ModelName = aRow.Reference,
            SourceId = objInstallSourceId ?? Guid.Empty,
            Destination = null
        };

        var vClient = HttpClientFactory.CreateClient("TrStudioApi");
        try
        {
            var vResponse = await vClient.PostAsJsonAsync(ApiRoutes.Installs, vRequest);
            if (vResponse.IsSuccessStatusCode)
            {
                var vItem = await vResponse.Content.ReadFromJsonAsync<ModelInstallItem>();
                if (vItem is not null)
                {
                    objQueue.Insert(0, MapQueue(vItem));
                }

                aRow.InstallState = CatalogInstallState.Installing;
                aRow.ProgressLabel = "queued";
                ToastService.Success($"Queued \"{aRow.Name}\" for install.", "Model library");
                return;
            }
        }
        catch
        {
            // Fall through to the optimistic queue entry while the install endpoint is wiring.
        }

        aRow.InstallState = CatalogInstallState.Installing;
        aRow.ProgressLabel = "queued";
        objQueue.Insert(0, new QueueItem
        {
            InstallId = Guid.NewGuid(),
            ModelName = aRow.Name,
            State = "queued",
            StateLabel = "queued",
            StateTone = "badge-brand",
            SizeLabel = $"0 / {aRow.Size}",
            Destination = "resolving…",
            ShowProgress = true,
            Progress = 0
        });
        ToastService.Success($"Queued \"{aRow.Name}\" for install.", "Model library");
    }

    /// <summary>Applies pause/resume/cancel to a queued install.</summary>
    private async Task ControlInstallAsync(QueueItem aItem, string aAction)
    {
        var vClient = HttpClientFactory.CreateClient("TrStudioApi");
        try
        {
            await vClient.PostAsync($"{ApiRoutes.Installs}/{aItem.InstallId}/{aAction}", content: null);
        }
        catch
        {
            // Optimistic state change applied below while the control endpoint is wiring.
        }

        switch (aAction)
        {
            case "pause":
                aItem.State = "paused";
                aItem.StateLabel = "paused";
                aItem.StateTone = "badge-warn";
                break;
            case "resume":
                aItem.State = "downloading";
                aItem.StateLabel = "downloading";
                aItem.StateTone = "badge-brand";
                break;
            case "cancel":
                objQueue.Remove(aItem);
                break;
        }

        ToastService.Show($"{aItem.ModelName}: {aAction} requested.", "Install queue");
    }

    private static QueueItem MapQueue(ModelInstallItem aItem)
    {
        var vProgress = aItem.TotalBytes is > 0
            ? aItem.DownloadedBytes / (double)aItem.TotalBytes.Value * 100.0
            : 0.0;
        var (vLabel, vTone) = aItem.State.ToLowerInvariant() switch
        {
            "downloading" => ("downloading", "badge-brand"),
            "paused" => ("paused", "badge-warn"),
            "completed" => ("completed", "badge-ok"),
            "failed" => ("failed", "badge-warn"),
            _ => (aItem.State, "badge-brand")
        };

        var vShowProgress = aItem.State is "downloading" or "paused" or "queued";
        var vSpeed = aItem.SpeedBytesPerSec is > 0 ? $" · {aItem.SpeedBytesPerSec.Value / 1_000_000.0:0} MB/s" : string.Empty;
        var vSizeLabel = aItem.TotalBytes is > 0
            ? $"{Gb(aItem.DownloadedBytes)} / {Gb(aItem.TotalBytes.Value)} · {vProgress:0}%{vSpeed}"
            : Gb(aItem.DownloadedBytes);

        return new QueueItem
        {
            InstallId = aItem.InstallId,
            ModelName = aItem.ModelName,
            State = aItem.State.ToLowerInvariant(),
            StateLabel = vLabel,
            StateTone = vTone,
            Progress = vProgress,
            ShowProgress = vShowProgress,
            SizeLabel = vSizeLabel,
            Destination = string.IsNullOrWhiteSpace(aItem.Destination) ? "local disk" : aItem.Destination
        };
    }

    private static string Gb(long aBytes) => $"{aBytes / 1_000_000_000.0:0.0} GB";

    private static List<CatalogRow> BuildRepresentativeCatalog() => new()
    {
        new("Hunyuan-Avatar", "tencent/HunyuanVideo-Avatar", "Hugging Face", "avatar", "Avatar / video", "24.0 GB", "24 GB", "Tencent Community", "badge-warn", CatalogInstallState.Installing, "62%"),
        new("SDXL 1.0", "stabilityai/stable-diffusion-xl · base + refiner", "Hugging Face", "image", "Image", "13.4 GB", "12 GB", "OpenRAIL++", "badge-warn", CatalogInstallState.Paused, ""),
        new("MuseTalk", "TMElyralab/MuseTalk · lip-sync", "Hugging Face", "avatar", "Avatar", "1.8 GB", "8 GB", "MIT", "badge-ok", CatalogInstallState.Installed, ""),
        new("FLUX.1 [dev]", "black-forest-labs/FLUX.1-dev", "Hugging Face", "image", "Image", "23.8 GB", "24 GB", "FLUX non-commercial", "badge-warn", CatalogInstallState.NeedsVolume, ""),
        new("XTTS v2", "coqui/XTTS-v2 · voice clone", "Hugging Face", "voice", "Voice", "1.9 GB", "6 GB", "Coqui CPML", "badge-warn", CatalogInstallState.Available, ""),
        new("IndicF5", "ai4bharat/IndicF5 · Hindi + 10 Indic languages", "Hugging Face", "voice", "Voice", "1.2 GB", "6 GB", "Apache-2.0", "badge-ok", CatalogInstallState.Available, ""),
        new("Realistic Vision v6", "SD 1.5 checkpoint · photoreal portraits", "Civitai", "image", "Image", "4.3 GB", "8 GB", "OpenRAIL-M", "badge-warn", CatalogInstallState.Available, ""),
        new("RealESRGAN x4", "4× upscaler for final renders", "Civitai", "image", "Image", "67 MB", "4 GB", "BSD-3", "badge-ok", CatalogInstallState.Available, "")
    };

    private static List<QueueItem> BuildRepresentativeQueue() => new()
    {
        new() { InstallId = Guid.NewGuid(), ModelName = "Hunyuan-Avatar", State = "downloading", StateLabel = "downloading", StateTone = "badge-brand", Progress = 62, ShowProgress = true, SizeLabel = "14.9 / 24.0 GB · 62% · 41 MB/s", Destination = "RunPod network volume" },
        new() { InstallId = Guid.NewGuid(), ModelName = "SDXL refiner", State = "paused", StateLabel = "paused", StateTone = "badge-warn", Progress = 46, ShowProgress = true, SizeLabel = "2.8 / 6.1 GB · resumable", Destination = "local disk" },
        new() { InstallId = Guid.NewGuid(), ModelName = "MuseTalk", State = "completed", StateLabel = "completed", StateTone = "badge-ok", Progress = 100, ShowProgress = false, SizeLabel = "1.8 GB · verified checksum", Destination = "local disk" }
    };

    private enum CatalogInstallState
    {
        Available,
        Installing,
        Paused,
        Installed,
        NeedsVolume
    }

    private sealed class CatalogRow
    {
        public CatalogRow(string aName, string aSubtitle, string aSource, string aTask, string aTaskLabel,
            string aSize, string aMinVram, string aLicense, string aLicenseTone, CatalogInstallState aState, string aProgressLabel)
        {
            Name = aName;
            Subtitle = aSubtitle;
            Reference = aSubtitle.Split(' ')[0];
            Source = aSource;
            Task = aTask;
            TaskLabel = aTaskLabel;
            Size = aSize;
            MinVram = aMinVram;
            License = aLicense;
            LicenseTone = aLicenseTone;
            InstallState = aState;
            ProgressLabel = aProgressLabel;
        }

        public string Name { get; }
        public string Subtitle { get; }
        public string Reference { get; }
        public string Source { get; }
        public string Task { get; }
        public string TaskLabel { get; }
        public string Size { get; }
        public string MinVram { get; }
        public string License { get; }
        public string LicenseTone { get; }
        public CatalogInstallState InstallState { get; set; }
        public string ProgressLabel { get; set; }
    }

    private sealed class QueueItem
    {
        public Guid InstallId { get; set; }
        public string ModelName { get; set; } = string.Empty;
        public string State { get; set; } = string.Empty;
        public string StateLabel { get; set; } = string.Empty;
        public string StateTone { get; set; } = string.Empty;
        public double Progress { get; set; }
        public bool ShowProgress { get; set; }
        public string SizeLabel { get; set; } = string.Empty;
        public string Destination { get; set; } = string.Empty;

        /// <summary>Whether the item is still downloading/queued/paused (counts toward the active badge).</summary>
        public bool IsActive => State is "downloading" or "queued" or "paused";
    }
}
