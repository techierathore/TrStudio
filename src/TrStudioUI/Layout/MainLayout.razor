@inherits LayoutComponentBase
@implements IDisposable
@using TrStudioUI.Components
@inject AppShellNavigation Shell
@inject NavigationManager Navigation
@inject IAuthSession AuthSession

@*
    Shared app shell (REQ-UI-005 / REQ-UI-080) for the one unified TrStudio app:
    collapsible sidebar (SidebarProvider/Sidebar/SidebarInset) + topbar with SidebarTrigger,
    breadcrumb, API status pill, theme toggle and user chip. The active surface (creator vs
    management) is chosen by the signed-in user's role via AppShellNavigation; a Creator reaching
    an /admin/* route is bounced in-app to <AccessDenied /> instead of the page (REQ-FN-072).
    Auth screens use EmptyLayout. LOGIN GATE (REQ-FN-016 / REQ-UI-080): every route rendered in
    this shell requires a session — an anonymous visitor is redirected to /login on BOTH heads
    unless the route is in the anonymous allow-list (auth + dev-seam screens, which all render on
    EmptyLayout anyway, so the gate can never loop).
*@

<SidebarProvider DefaultOpen="true" HeightClass="h-screen">
    <AppSidebar />
    <SidebarInset>
        <header class="shell-topbar">
            <SidebarTrigger />
            <Breadcrumb>
                <BreadcrumbList>
                    <BreadcrumbItem>
                        <BreadcrumbLink Href="/">@Shell.Current.AppName</BreadcrumbLink>
                    </BreadcrumbItem>
                    @if (objActiveItem is not null)
                    {
                        <BreadcrumbSeparator />
                        <BreadcrumbItem>
                            <BreadcrumbPage>@objActiveItem.Label</BreadcrumbPage>
                        </BreadcrumbItem>
                    }
                </BreadcrumbList>
            </Breadcrumb>
            <div class="shell-topbar-spacer"></div>
            <ApiStatusIndicator />
            <ThemeToggle />
            @* Identity chip doubles as the sign-out control: clears the session and returns to /login. *@
            <button type="button" class="shell-userchip brand-gradient" data-testid="user-chip"
                    title="@(objSignedIn ? "Sign out" : "Signed-in user")" @onclick="SignOutAsync">
                @objUserInitial
            </button>
        </header>
        <main class="shell-content">
            @if (objAccessDenied)
            {
                <AccessDenied />
            }
            else
            {
                @Body
            }
        </main>
    </SidebarInset>
</SidebarProvider>

<ToastProvider Position="ToastPosition.BottomRight" />
<PortalHost />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">X</span>
</div>

@code {
    /// <summary>
    /// Base-relative routes an anonymous visitor may stay on (REQ-FN-016): the auth screens, the
    /// first-run gate and the dev session seams (web /dev/session + desktop /dev/desktop). They all
    /// render on EmptyLayout, so listing them here is defence-in-depth against a redirect loop.
    /// </summary>
    private static readonly string[] AnonymousRoutes =
        ["login", "register", "forgot-password", "setup-required", "dev/session", "dev/desktop"];

    private AppNavItem? objActiveItem;
    private string objUserInitial = "TR";
    private bool objSignedIn;
    private bool objSessionResolved;
    private bool objAccessDenied;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        UpdateActiveItem();
        Shell.Changed += HandleShellChanged;
        Navigation.LocationChanged += HandleLocationChanged;
    }

    /// <summary>
    /// Resolves the signed-in user's role once the circuit is interactive (JS interop available),
    /// so the shell surface + the /admin/* client gate reflect the real role. The user chip initial
    /// is set from the same session read.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool aFirstRender)
    {
        if (!aFirstRender)
        {
            return;
        }

        var vState = await AuthSession.GetAsync();
        if (vState is not null && !string.IsNullOrEmpty(vState.UserId))
        {
            objSignedIn = true;
            // Identify the session by the sign-in email's initial; the numeric AppManager UserId
            // is the fallback for pre-Email persisted sessions and the dev seams.
            var vTrimmed = string.IsNullOrWhiteSpace(vState.Email)
                ? vState.UserId.Trim()
                : vState.Email.Trim();
            objUserInitial = char.ToUpperInvariant(vTrimmed[0]).ToString();
        }

        // Force a role re-read when a session exists but a PRE-login render left the scoped shell
        // role-less (the gate below redirects /avatar → /login; login then soft-navs back into this
        // shell with the same scoped AppShellNavigation). Without the force reload the role surface
        // and the Owner sidebar-footer switch would not render after that soft-nav login.
        await Shell.InitializeAsync(
            Navigation.ToBaseRelativePath(Navigation.Uri),
            aForceReload: objSignedIn && Shell.Role is null);

        objSessionResolved = true;
        if (RedirectAnonymous())
        {
            return;
        }

        EvaluateGuard();
        StateHasChanged();
    }

    /// <summary>
    /// Login gate (REQ-FN-016 / REQ-UI-080): redirects an anonymous visitor to /login unless the
    /// current route is in the anonymous allow-list. A client-side navigation (no forceLoad) — the
    /// same SPA nav both heads use after login — so the Hybrid WebView lands on /login too.
    /// </summary>
    /// <returns>True when a redirect to /login was issued.</returns>
    private bool RedirectAnonymous()
    {
        if (objSignedIn || IsAnonymousRoute(Navigation.ToBaseRelativePath(Navigation.Uri)))
        {
            return false;
        }

        Navigation.NavigateTo("/login");
        return true;
    }

    /// <summary>Whether the base-relative path (query/hash ignored) is in the anonymous allow-list.</summary>
    /// <param name="aRelativePath">The base-relative path from <c>NavigationManager.ToBaseRelativePath</c>.</param>
    /// <returns>True when the route may render without a session.</returns>
    private static bool IsAnonymousRoute(string aRelativePath)
    {
        var vPath = aRelativePath ?? string.Empty;
        var vQueryIndex = vPath.IndexOfAny(['?', '#']);
        if (vQueryIndex >= 0)
        {
            vPath = vPath[..vQueryIndex];
        }

        vPath = vPath.Trim('/');
        return AnonymousRoutes.Contains(vPath, StringComparer.OrdinalIgnoreCase);
    }

    /// <summary>Clears the session and returns to the sign-in screen.</summary>
    private async Task SignOutAsync()
    {
        await AuthSession.ClearAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    /// <summary>Re-renders the shell when the resolved role or active surface changes.</summary>
    private void HandleShellChanged()
    {
        EvaluateGuard();
        InvokeAsync(StateHasChanged);
    }

    /// <summary>Recomputes the breadcrumb leaf, the login gate and the route guard when the route changes.</summary>
    private void HandleLocationChanged(object? aSender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs aArgs)
    {
        if (objSessionResolved && RedirectAnonymous())
        {
            return;
        }

        UpdateActiveItem();
        EvaluateGuard();
        InvokeAsync(StateHasChanged);
    }

    /// <summary>Resolves the active nav item for the breadcrumb from the current route.</summary>
    private void UpdateActiveItem()
    {
        objActiveItem = NavRouteMatcher.FindActive(Shell.Current, Navigation.ToBaseRelativePath(Navigation.Uri));
    }

    /// <summary>Denies rendering of a management route for a role that lacks management access (REQ-FN-072).</summary>
    private void EvaluateGuard()
    {
        objAccessDenied = !Shell.IsRouteAllowed(Navigation.ToBaseRelativePath(Navigation.Uri));
    }

    /// <inheritdoc />
    public void Dispose()
    {
        Shell.Changed -= HandleShellChanged;
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
