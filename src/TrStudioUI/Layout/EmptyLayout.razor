@inherits LayoutComponentBase

@*
    Bare layout (REQ-UI-005) for auth screens — no sidebar/topbar, centered content,
    fixed top-right theme toggle per the login/register mockups. Auth pages (wave 2)
    opt in with @@layout TrStudioUI.Layout.EmptyLayout.
*@

<ThemeToggle Class="auth-theme-toggle" />

<div class="auth-shell">
    @Body
</div>

<ToastProvider Position="ToastPosition.BottomRight" />
<PortalHost />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">X</span>
</div>
