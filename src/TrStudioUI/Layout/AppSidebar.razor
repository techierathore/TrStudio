@implements IDisposable
@inject AppShellNavigation Shell
@inject NavigationManager Navigation
@inject IAuthSession AuthSession
@inject IHttpClientFactory HttpClientFactory

@*
    Shared collapsible sidebar (REQ-UI-005 / REQ-UI-080): brand header, the active surface's nav
    groups (LucideIcon + label, gradient active pill), and — for an Owner (the only role with both
    surfaces) — a footer control that switches between the creator and management surfaces in-app.
    The active surface comes from AppShellNavigation (the signed-in role), so one component renders
    the creator studios, the management surface, or both with a switch.
*@

<Sidebar Collapsible="true" data-testid="sidebar">
    <SidebarHeader>
        <SidebarHeaderContent>
            <div class="shell-logo brand-gradient">TR</div>
            <SidebarHeaderInfo>
                <span class="truncate font-semibold">
                    @Shell.Current.AppName
                    @if (!string.IsNullOrEmpty(Shell.Current.AppBadge))
                    {
                        <Badge Variant="BadgeVariant.Outline" Class="text-xs" data-testid="@($"badge-{Shell.Current.AppBadge}")">@Shell.Current.AppBadge</Badge>
                    }
                </span>
            </SidebarHeaderInfo>
        </SidebarHeaderContent>
    </SidebarHeader>
    @* Each group is its label and its own <nav>, side by side under the sidebar, as the mockups draw it. *@
    @foreach (var vGroup in Shell.Current.Groups)
    {
        <SidebarGroupLabel Class="shell-navgroup">@vGroup.Label</SidebarGroupLabel>
        <nav class="shell-nav" aria-label="@vGroup.Label">
            <SidebarMenu>
                @foreach (var vItem in vGroup.Items)
                {
                    <SidebarMenuItem>
                        <SidebarMenuButton Href="@vItem.Href"
                                           Match="NavLinkMatch.All"
                                           Tooltip="@vItem.Label"
                                           IsActive="@(vItem == objActiveItem)"
                                           data-testid="@NavTestId(vItem)">
                            <LucideIcon Name="@vItem.Icon" Size="16" />
                            <span>@vItem.Label</span>
                        </SidebarMenuButton>
                    </SidebarMenuItem>
                }
            </SidebarMenu>
        </nav>
    }
    <SidebarFooter Class="shell-sidefoot">
        @if (Shell.CanSwitchSurface)
        {
            @* Named as the mockups name it: the creator surface switches to management and back. *@
            <Button Variant="ButtonVariant.Ghost" Class="w-full justify-start"
                    OnClick="SwitchSurface" data-testid="@(Shell.Current.AppBadge == "admin" ? "link-switch-to-trstudio" : "link-switch-to-trstudioadmin")">
                <LucideIcon Name="arrow-left-right" Size="15" />
                <span>@Shell.SwitchLabel</span>
            </Button>
        }
        @* Sign out, as the mockups draw it in the sidebar footer; it also removes a kept sign-in (REQ-UI-106). *@
        <Button Variant="ButtonVariant.Ghost" Class="w-full justify-start" OnClick="SignOutAsync" data-testid="nav-sign-out">
            <LucideIcon Name="log-out" Size="15" />
            <span>Sign out</span>
        </Button>
    </SidebarFooter>
</Sidebar>

@code {
    private AppNavItem? objActiveItem;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        UpdateActiveItem();
        Shell.Changed += HandleShellChanged;
        Navigation.LocationChanged += HandleLocationChanged;
    }

    /// <summary>Ensures the role/surface is resolved once the circuit is interactive.</summary>
    protected override async Task OnAfterRenderAsync(bool aFirstRender)
    {
        if (aFirstRender)
        {
            await Shell.InitializeAsync(Navigation.ToBaseRelativePath(Navigation.Uri));
        }
    }

    /// <summary>Switches the active surface (Owner only) and lands on that surface's default route.</summary>
    private void SwitchSurface()
    {
        Shell.SwitchSurface();
        Navigation.NavigateTo(Shell.CurrentLandingPath);
    }

    /// <summary>The mockups' control name for a sidebar item, from its route (e.g. /avatar → nav-avatar-studio).</summary>
    private static string NavTestId(AppNavItem aItem) => aItem.Href switch
    {
        "/avatar" => "nav-avatar-studio",
        "/avatar/characters" => "nav-character-library",
        "/image" => "nav-image-studio",
        "/video" => "nav-video-studio",
        "/voice" => "nav-voice-studio",
        "/prompt-studio" => "nav-prompt-studio",
        "/admin/setup/hardware" => "nav-admin-hardware",
        "/admin/comfy/import" => "nav-admin-comfy",
        _ => "nav-" + aItem.Href.Trim('/').Replace('/', '-')
    };

    /// <summary>Ends the engine session, removes a kept sign-in and returns to Login.</summary>
    private async Task SignOutAsync()
    {
        try
        {
            await HttpClientFactory.CreateClient("TrStudioApi").PostAsync(ApiRoutes.Auth + "/logout", null);
        }
        catch
        {
            // A host without the route still clears its own session below.
        }

        await AuthSession.ClearAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    /// <summary>Re-renders when the resolved role or active surface changes.</summary>
    private void HandleShellChanged()
    {
        UpdateActiveItem();
        InvokeAsync(StateHasChanged);
    }

    /// <summary>Recomputes the active nav item when the route changes.</summary>
    private void HandleLocationChanged(object? aSender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs aArgs)
    {
        UpdateActiveItem();
        // Owner run 16 Nov 2026 (real Mac app): the phone-width menu sheet stayed open over the screen
        // that was just chosen from it. Choosing a screen closes it.
        if (objSidebar is { OpenMobile: true })
        {
            objSidebar.SetOpenMobile(false);
        }

        InvokeAsync(StateHasChanged);
    }

    /// <summary>The sidebar state the provider cascades (phone menu sheet open or shut).</summary>
    [CascadingParameter]
    private SidebarContext? objSidebar { get; set; }

    /// <summary>Resolves the active item for the active surface from the current route.</summary>
    private void UpdateActiveItem()
    {
        objActiveItem = NavRouteMatcher.FindActive(Shell.Current, Navigation.ToBaseRelativePath(Navigation.Uri));
    }

    /// <inheritdoc />
    public void Dispose()
    {
        Shell.Changed -= HandleShellChanged;
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
