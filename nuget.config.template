<?xml version="1.0" encoding="utf-8"?>
<!-- Copy this file to nuget.config (repo root) and fill in your GitHub PAT.
     The PAT needs the read:packages scope for the private TrBlazeUI/TechieRag feed.
     nuget.config is gitignored — never commit the filled-in file. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="TrBlazeUI" value="https://nuget.pkg.github.com/techierathore/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <TrBlazeUI>
      <add key="Username" value="YOUR_GITHUB_USERNAME" />
      <add key="ClearTextPassword" value="YOUR_GITHUB_PAT_WITH_read-packages" />
    </TrBlazeUI>
  </packageSourceCredentials>
</configuration>
