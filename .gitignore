# =========================================================================
# TrStudio — .gitignore (.NET 10 / Blazor Web + MAUI Blazor Hybrid)
# =========================================================================

# --- Secrets — NEVER commit (templates are provided instead) -------------
# nuget.config holds a GitHub PAT for the private TrBlazeUI/TechieRag feed
# -> copy nuget.config.template to nuget.config and fill in your PAT
/nuget.config
# TrStudioApi appsettings holds live AppManager keys + the DB password
# -> copy appsettings.template.json to appsettings.json and fill in values
src/TrStudioApi/appsettings.json
# Generic secret carriers
.env
.env.*
*.local.json
appsettings.Production.json

# --- Build output ---------------------------------------------------------
[Bb]in/
[Oo]bj/
[Oo]ut/
artifacts/
publish/
*.binlog

# --- MAUI / mobile / signing ----------------------------------------------
*.apk
*.aab
*.ipa
*.msix
*.msixbundle
*.keystore
*.jks
*.pfx
*.p12
*.snk
*.mobileprovision
# Xcode (Mac Catalyst builds on the Mac)
xcuserdata/
*.xcuserstate
DerivedData/

# --- Test / coverage / smoke artifacts -------------------------------------
[Tt]est[Rr]esults/
test-results/
playwright-report/
coverage/
coverage*.json
coverage*.xml
*.trx
*.coverage
.verify/

# --- Logs & local runtime assets --------------------------------------------
*.log
logs/
# Local runtime assets (generated by LocalAssetStorage)
.trstudio/

# --- IDE / editor / OS -------------------------------------------------------
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.DotSettings.user
.DS_Store
Thumbs.db
Desktop.ini

# --- Node (Playwright harness) ------------------------------------------------
node_modules/

# --- TechieFlow framework — deployed copies, never commit
#     (managed by scaffold/update-framework.sh)
.tfcore/
.claude/
.opencode/
/CLAUDE.md
/WORKFLOW.html
/opencode.jsonc
/.tf-scaffold-note.txt

# --- TechieFlow agent artifacts — machine-generated harness & ledgers
/package.json
/package-lock.json
/docs/.last-verify.json

# TechieFlow agent artifacts — machine-generated test harness & logs, never commit (managed by scaffold/update-framework.sh)
tests/.artifacts/
test-results-*/
/scripts-*/
