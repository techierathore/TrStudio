<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The paid Venice live tests (Category=Live, REQ-NFR-012) stay out of the normal run;
         a command-line filter Category=Live (which wins over this default) runs them. -->
    <VSTestTestCaseFilter Condition="'$(VSTestTestCaseFilter)' == ''">Category!=Live</VSTestTestCaseFilter>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\TrStudio.Models\TrStudio.Models.csproj" />
    <!-- The Venice live tests drive the real VeniceClient (REQ-NFR-012). -->
    <ProjectReference Include="..\..\..\src\TrStudio.Engine\TrStudio.Engine.csproj" />
    <!-- REQ-RAG-005 live: Prompt studio's routes, answered in process as in the desktop app. -->
    <ProjectReference Include="..\..\..\src\TrStudio.InProcess\TrStudio.InProcess.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test settings beside the tests: the committed template and this machine's git-ignored overlay. -->
    <None Update="testsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="testsettings.Local.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
